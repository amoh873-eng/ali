@inherits LayoutComponentBase
@using MudBlazor

@* تخطيط نقطة البيع: كامل الشاشة بدون شريط علوي/تنقّل *@

<MudRTLProvider RightToLeft="true">
    <MudThemeProvider Theme="_theme" IsDarkMode="false" />
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    @* Non-invasive scale-barcode interceptor — see Components/ScaleBarcodeInterceptor.razor
       (global scanner capture on the POS page, re-injects into the existing search flow). *@
    <ScaleBarcodeInterceptor />

    @Body
</MudRTLProvider>

<script>
    // نمرّر قائمة السلة إلى آخر صنف تلقائياً عند إضافته (عند امتلاء السلة).
    window.erpScrollPosCartToBottom = function () {
        var el = document.querySelector('.pos-cart-lines');
        if (el) el.scrollTop = el.scrollHeight;
    };
    // نمرّر قائمة السلة إلى الأعلى عند مسحها (مثلاً مع "مسح" / "فاتورة جديدة").
    window.erpScrollPosCartToTop = function () {
        var el = document.querySelector('.pos-cart-lines');
        if (el) el.scrollTop = 0;
    };

    // إعدادات الطابعة الحرارية: حفظ / تحميل (تُخزَّن في localStorage)
    window.erpSavePrinterSettings = function (json) { try { localStorage.setItem('posPrinterSettings', json); } catch (e) {} };
    window.erpLoadPrinterSettings = function () { try { return localStorage.getItem('posPrinterSettings'); } catch (e) { return null; } };
</script>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6D5BD0",
            Secondary = "#6B7280",
            Info = "#6D5BD0",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F4F5F9",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1F2937",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1F2937",
            TextPrimary = "#1F2937",
            TextSecondary = "#6B7280",
            ActionDefault = "#1F2937",
            LinesDefault = "#E5E7EB",
            LinesInputs = "#C7C5F4",
            TableLines = "#E5E7EB"
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "10px" },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Cairo", "Tajawal", "Roboto", "Arial", "sans-serif" },
                FontSize = "0.9375rem"
            }
        }
    };
}
