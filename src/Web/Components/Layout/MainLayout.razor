@inherits LayoutComponentBase

@* 
MudRTLProvider: تفعيل اتجاه RTL للغة العربية في MudBlazor 8
(استُبدل RightToLeft بـ MudThemeProvider في v7 وأصبح MudRTLProvider في v8).
*@
<MudRTLProvider RightToLeft="true">
<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />

@* 
MudDialogProvider: مزود النوافذ المنبثقة (Modals) لكل تطبيق MudBlazor.
*@
<MudDialogProvider />

@* 
MudSnackbarProvider: مزود الإشعارات (Toast) لعرض رسائل النجاح/الخطأ.
*@
<MudSnackbarProvider />

@*
MudLayout: التخطيط الرئيسي للصفحة.
يضم شريط علوي (AppBar) ومنطقة المحتوى (Body) مع الشريط الجانبي.
*@
<MudLayout>
    @* الشريط العلوي: الشعار + القائمة العلوية + الإشعارات + قائمة المستخدم *@
    <MudAppBar Elevation="0" Dense="true">
        <div style="display:flex; flex-direction:column; width:100%;">
            @* الصف الأول: الشعار في المنتصف + الإشعارات وقائمة المستخدم على الجانب *@
            <div style="display:flex; align-items:center; width:100%; gap:10px; padding-top:2px;">
                <div style="flex:1;"></div>

                @* اسم النظام (الشعار): اسم النظام + شارة ERP بلون مختلف تحته *@
                <div style="display:flex; align-items:center; gap:10px;">
                    <MudIcon Icon="@Icons.Material.Filled.Layers" Style="color:var(--erp-primary); font-size:1.9rem;" />
                    <div style="display:flex; flex-direction:column; line-height:1.15;">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:800; color:var(--erp-primary); margin:0;">@Loc["BrandName"]</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:700; color:#F472B6; letter-spacing:3px; margin:0;">ERP</MudText>
                    </div>
                </div>

                <div style="flex:1; display:flex; justify-content:flex-end; align-items:center;">
                    @* الإشعارات *@
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Inherit" Size="Size.Small" />

                    @* قائمة المستخدم (تسجيل الخروج: عربي/إنجليزي) *@
                    <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                        <ActivatorContent>
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Class="ml-3 mr-1" Style="cursor:pointer;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                        </ActivatorContent>
                        <ChildContent>
                            <AuthorizeView>
                                <Authorized>
                                    <MudMenuItem OnClick="Logout">
                                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                                        @Loc["Logout"]
                                    </MudMenuItem>
                                </Authorized>
                                <NotAuthorized>
                                    <MudMenuItem Href="/login">
                                        <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                                        @Loc["Login"]
                                    </MudMenuItem>
                                </NotAuthorized>
                            </AuthorizeView>
                        </ChildContent>
                    </MudMenu>
                </div>
            </div>

            @* سطر فاصل ثم الصف الثاني: القوائم بجانب بعضها تحت الشعار *@
            <div style="display:flex; justify-content:center; margin-top:6px; padding:4px 0 8px; border-top:1px solid var(--erp-border);">
                <TopNav />
            </div>
        </div>
    </MudAppBar>

    @* منطقة المحتوى - Body *@
    <MudMainContent>
        @* pt-5: مسافة علوية (~20px) تفصل المحتوى عن الشريط العلوي بوضوح (إصلاح تزاحم أعلى صفحات القوائم) *@
        <MudContainer MaxWidth="MaxWidth.False" Class="px-4 pt-5 pb-2">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
</MudRTLProvider>

@code {
    [Inject] private IStringLocalizer<SharedResources> Loc { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;

    /// <summary>تسجيل الخروج عبر تحميل كامل للصفحة (طلب HTTP حقيقي) لضمان توفر HttpContext.</summary>
    private void Logout() => Nav.NavigateTo("/logout", forceLoad: true);

    /// <summary>
    /// السمة الضوئية (Light) — هوية "عصري نظيف": لون أساسي بنفسجي #6D5BD0 وخلفية #F4F5F9.
    /// هذه القيم متزامنة مع متغيرات :root في app.css.
    /// </summary>
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6D5BD0",
            Secondary = "#6B7280",
            Info = "#6D5BD0",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F4F5F9",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1F2937",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1F2937",
            TextPrimary = "#1F2937",
            TextSecondary = "#6B7280",
            ActionDefault = "#1F2937",
            LinesDefault = "#E5E7EB",
            LinesInputs = "#C7C5F4",
            TableLines = "#E5E7EB"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Cairo", "Tajawal", "Roboto", "Arial", "sans-serif" },
                FontSize = "0.9375rem"
            }
        }
    };
}
