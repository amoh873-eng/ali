@inherits LayoutComponentBase

@* 
MudRTLProvider: تفعيل اتجاه RTL للغة العربية في MudBlazor 8
(استُبدل RightToLeft بـ MudThemeProvider في v7 وأصبح MudRTLProvider في v8).
*@
<MudRTLProvider RightToLeft="true">
<MudThemeProvider Theme="_theme" IsDarkMode="false" />
<MudPopoverProvider />

@* 
MudDialogProvider: مزود النوافذ المنبثقة (Modals) لكل تطبيق MudBlazor.
*@
<MudDialogProvider />

@* 
MudSnackbarProvider: مزود الإشعارات (Toast) لعرض رسائل النجاح/الخطأ.
*@
<MudSnackbarProvider />

@*
MudLayout: التخطيط الرئيسي للصفحة.
يضم شريط علوي (AppBar) ومنطقة المحتوى (Body) مع الشريط الجانبي.
*@
<MudLayout>
    @* الشريط العلوي: الشعار + القائمة العلوية + الإشعارات + قائمة المستخدم *@
    <MudAppBar Elevation="0" Dense="true" Style="padding-top:24px; height:auto;">
        <div style="display:flex; flex-direction:column; width:100%; gap:6px; padding:18px 0 6px; margin-top:16px;">
            @* الصف الأول: الشعار في الوسط + الجرس والخروج يمين — مُنزل 16px لتجاوز شريط المتصفح/البحث *@
            <div style="display:flex; align-items:center; width:100%;">
                <div style="flex:1;"></div>
                <div style="display:flex; align-items:center; gap:10px;">
                    @if (!string.IsNullOrEmpty(_logoUrl))
                    { <img src="@_logoUrl" alt="logo" style="height:36px;max-width:160px;object-fit:contain" /> }
                    else
                    { <MudIcon Icon="@Icons.Material.Filled.Layers" Style="color:var(--erp-primary); font-size:2rem;" /> }
                    <div style="display:flex; flex-direction:column; line-height:1.1;">
                        <MudText Typo="Typo.h6" Style="font-weight:800; color:var(--erp-primary); margin:0; line-height:1;">@(_displayName ?? Loc["BrandName"])</MudText>
                        <MudText Typo="Typo.caption" Style="font-weight:700; color:#F472B6; letter-spacing:3px; margin:0;">ERP</MudText>
                    </div>
                </div>
                <div style="flex:1; display:flex; justify-content:flex-end; align-items:center; gap:6px;">
                    @* ── المدة المتبقية — بجانب رمز الإعدادات (TopNav كانت تعرضها بجانب الصلاحيات — الآن مكررة هنا للوضوح) ── *@
                    @if (!string.IsNullOrWhiteSpace(_subText))
                    {
                        <span title="@_subTitle" style="display:inline-flex;align-items:center;gap:6px;padding:5px 10px;border-radius:999px;font-size:.78rem;font-weight:800;border:1px solid @_subBorder;background:@_subBg;color:@_subColor;white-space:nowrap">
                            <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" Style="@($"color:{_subColor};font-size:1rem")" />
                            @_subText
                        </span>
                    }
                    @* ── زر الإعدادات — خلفية بنفسجية واضحة ── *@
                    <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" Size="Size.Small" Style="background:#DDD6FE;border:1px solid #C4B5FD;border-radius:10px;color:#4C1D95;" Title="الإعدادات" Href="/settings" />
                    <MudIconButton Icon="@Icons.Material.Filled.Notifications" Color="Color.Default" Size="Size.Small" Style="background:#F3F4F6;border-radius:10px;" Title="الإشعارات" />
                    <MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                        <ActivatorContent>
                            <MudAvatar Color="Color.Primary" Size="Size.Small" Style="cursor:pointer;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" />
                            </MudAvatar>
                        </ActivatorContent>
                        <ChildContent>
                            <AuthorizeView>
                                <Authorized>
                                    <MudMenuItem OnClick="Logout">
                                        <MudIcon Icon="@Icons.Material.Filled.Logout" Class="mr-2" />
                                        @Loc["Logout"]
                                    </MudMenuItem>
                                </Authorized>
                                <NotAuthorized>
                                    <MudMenuItem Href="/login">
                                        <MudIcon Icon="@Icons.Material.Filled.Login" Class="mr-2" />
                                        @Loc["Login"]
                                    </MudMenuItem>
                                </NotAuthorized>
                            </AuthorizeView>
                        </ChildContent>
                    </MudMenu>
                </div>
            </div>
            @* الصف الثاني: القوائم الذهبية تحت الشعار *@
            <div style="display:flex; justify-content:center; border-top:1px solid var(--erp-border); padding-top:8px;">
                <TopNav />
            </div>
        </div>
    </MudAppBar>

    @* منطقة المحتوى - Body — مُنزل 2 سم (≈75px) مع الشريط *@
    <MudMainContent Style="padding-top:75px;">
        <MudContainer MaxWidth="MaxWidth.False" Class="px-4 pt-4 pb-2">
            @Body
        </MudContainer>
        @* فوتر النظام — يظهر فقط في قسم المبيعات *@
        @if (Nav.Uri.Contains("/sales", StringComparison.OrdinalIgnoreCase))
        {
            <MudContainer MaxWidth="MaxWidth.False" Class="px-4 pb-4">
                <MudPaper Elevation="0" Class="pa-3 mt-4 d-flex justify-center align-center" Style="background:#fff;border:1px solid var(--erp-border);border-radius:12px;">
                    <MudText Typo="Typo.caption" Style="color:var(--erp-muted);">
                        © @DateTime.Now.Year @(_displayName ?? Loc["BrandName"]) — نظام ERP المحاسبي — جميع الحقوق محفوظة
                        @if (!string.IsNullOrWhiteSpace(_supportContact)) { <span> — تواصل: @_supportContact</span> }
                    </MudText>
                </MudPaper>
            </MudContainer>
        }
    </MudMainContent>
</MudLayout>
</MudRTLProvider>

@code {
    [Inject] private IStringLocalizer<SharedResources> Loc { get; set; } = default!;
    [Inject] private NavigationManager Nav { get; set; } = default!;
    [Inject] private ERPSystem.Application.Interfaces.ISystemSettingsService SettingsService { get; set; } = default!;
    private string? _displayName;
    private string? _logoUrl;
    private string? _primaryHex;
    private string? _supportContact;
    private string? _subText, _subTitle; private string _subBg="#F9FAFB", _subColor="#374151", _subBorder="#E5E7EB";
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var s = await SettingsService.GetAsync();
            _displayName = s.AppDisplayName;
            _logoUrl = s.LogoUrl;
            _primaryHex = s.PrimaryColorHex;
            _supportContact = s.SupportContactInfo;
            var target = s.NextRenewalDate != default ? s.NextRenewalDate : s.LicenseExpiryDate;
            if (target != null && target != default)
            {
                var days = (target.Value.Date - DateTime.UtcNow.Date).TotalDays;
                _subTitle = $"ينتهي: {target.Value:yyyy-MM-dd}";
                if (days < 0) { _subText = $"منتهي منذ {Math.Ceiling(-days)} يوم"; _subBg="#FEE2E2"; _subColor="#991B1B"; _subBorder="#FECACA"; }
                else if (days <= 3) { _subText = $"متبقي {Math.Ceiling(days)} يوم"; _subBg="#FEE2E2"; _subColor="#991B1B"; _subBorder="#FECACA"; }
                else if (days <= 10) { _subText = $"متبقي {Math.Ceiling(days)} يوم"; _subBg="#FEF3C7"; _subColor="#92400E"; _subBorder="#FDE68A"; }
                else { _subText = $"ينتهي {target.Value:MM-dd}"; _subBg="#F0FDF4"; _subColor="#065F46"; _subBorder="#BBF7D0"; }
            }
        }
        catch { }
    }
    [Inject] private Microsoft.JSInterop.IJSRuntime JS { get; set; } = default!;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(_primaryHex))
        {
            try { await JS.InvokeVoidAsync("erpApplyPrimary", _primaryHex); } catch { }
        }
    }

    /// <summary>تسجيل الخروج عبر تحميل كامل للصفحة (طلب HTTP حقيقي) لضمان توفر HttpContext.</summary>
    private void Logout() => Nav.NavigateTo("/logout", forceLoad: true);

    /// <summary>
    /// السمة الضوئية (Light) — هوية "عصري نظيف": لون أساسي بنفسجي #6D5BD0 وخلفية #F4F5F9.
    /// هذه القيم متزامنة مع متغيرات :root في app.css.
    /// </summary>
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#6D5BD0",
            Secondary = "#6B7280",
            Info = "#6D5BD0",
            Success = "#10B981",
            Warning = "#F59E0B",
            Error = "#EF4444",
            Background = "#F4F5F9",
            Surface = "#FFFFFF",
            AppbarBackground = "#FFFFFF",
            AppbarText = "#1F2937",
            DrawerBackground = "#FFFFFF",
            DrawerText = "#1F2937",
            TextPrimary = "#1F2937",
            TextSecondary = "#6B7280",
            ActionDefault = "#1F2937",
            LinesDefault = "#E5E7EB",
            LinesInputs = "#C7C5F4",
            TableLines = "#E5E7EB"
        },
        LayoutProperties = new LayoutProperties
        {
            DefaultBorderRadius = "10px"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = new[] { "Cairo", "Tajawal", "Roboto", "Arial", "sans-serif" },
                FontSize = "0.9375rem"
            }
        }
    };
}
