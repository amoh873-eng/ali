@page "/pos"
@attribute [Authorize(Roles = "Pos")]
@layout PosLayout
@using ERPSystem.Application.DTOs.Pos
@using ERPSystem.Application.Exceptions
<ModuleGuard ModuleKey="Pos">
@inject IStringLocalizer<SharedResources> Loc
@inject NavigationManager Nav

<div class="pos-root @(_posHideItems ? "pos-hide-items" : "")">
    @* الشريط العلوي المصغّر *@
    <div class="pos-topbar">
        <div class="pos-brand">
            <MudIcon Icon="@Icons.Material.Filled.PointOfSale" Style="color:var(--erp-primary); font-size:1.8rem;" />
            <span class="pos-brand-text">@Loc["Pos"]</span>
        </div>
        <div class="pos-search">
            <MudTextField @bind-Value="_search" T="string" Placeholder="@Loc["PosSearchPlaceholder"]"
                          Variant="Variant.Outlined" Adornment="Adornment.Start" Immediate="true"
                          AdornmentIcon="@Icons.Material.Filled.Search"
                          OnKeyDown="HandleSearchKeyDown" />
            @if (!string.IsNullOrWhiteSpace(_search) && SearchSuggestions.Count > 0)
            {
                <div class="pos-search-dropdown">
                    @foreach (var item in SearchSuggestions)
                    {
                        <button type="button" class="pos-search-option" @onmousedown="() => AddFromSearch(item)">
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" alt=""
                                     onerror="this.style.display='none'"
                                     style="width:34px;height:34px;object-fit:cover;border-radius:6px;" />
                            }
                            <span class="pos-search-opt-name">@item.NameAr</span>
                            <span class="pos-search-opt-price">@item.SalePrice.ToString("N2")</span>
                        </button>
                    }
                </div>
            }
        </div>
        <div class="pos-topbar-right">
            <MudText Typo="Typo.body2" Class="pos-muted">@Loc["PosCashier"]: @_cashierName</MudText>
            <MudText Typo="Typo.body2" Class="pos-muted">@_clock</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.FactCheck" Color="Color.Default"
                           Title="@Loc["CardReconciliation"]"
                           OnClick="GoToReconciliation" />
            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Default" OnClick="OpenSettings" />
            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" OnClick="ExitPos" />
        </div>
    </div>

    <div class="pos-main">
        <div class="pos-items">
            <div class="pos-categories">
                <button class="pos-cat @(_selectedCategoryId is null ? "active" : "")" style="--c:#6B7280;" @onclick="() => SelectCategory(null)">
                    @Loc["All"]
                </button>
                @for (int i = 0; i < _categories.Count; i++)
                {
                    var cat = _categories[i];
                    var color = CategoryColor(i);
                    <button class="pos-cat @(_selectedCategoryId == cat.Id ? "active" : "")" style="--c:@color;" @onclick="() => SelectCategory(cat.Id)">
                        @cat.NameAr
                    </button>
                }
            </div>

            <div class="pos-grid">
                @{
                    var posVisible = FilteredItems;
                }
                @foreach (var item in posVisible)
                {
                    var isOutOfStock = item.CurrentStock <= 0;
                    var isFailing = item.Id == _insufficientItemId;
                    <button class="pos-item @(isOutOfStock ? "pos-item--out" : "") @(isFailing ? "pos-item--flash" : "")"
                            title="@(isOutOfStock ? @Loc["PosOutOfStock"] : item.NameAr)"
                            @onclick="() => AddItem(item)">
                        @if (isOutOfStock)
                        {
                            <span class="pos-item-stock-badge">@Loc["PosOutOfStock"]</span>
                        }
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt=""
                                 onerror="this.style.display='none'"
                                 class="pos-item-img" />
                        }
                        <div class="pos-item-icon"><MudIcon Icon="@Icons.Material.Filled.Inventory2" /></div>
                        <div class="pos-item-name">@item.NameAr</div>
                        <div class="pos-item-price">@item.SalePrice.ToString("N2")</div>
                    </button>
                }
                @if (posVisible.Count == 0)
                {
                    <MudText Class="pos-muted" Style="padding:16px;">@Loc["NoItems"]</MudText>
                }
            </div>
        </div>
        <div class="pos-cart">
            <div class="pos-cart-left">
                <div class="pos-cart-header">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@Loc["PosCart"]</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error" OnClick="ClearCart">@Loc["PosClear"]</MudButton>
                </div>

                <div class="pos-cart-lines">
                    @if (_cart.Count == 0)
                    {
                        <MudText Class="pos-muted" Style="padding:16px;">@Loc["PosEmptyCart"]</MudText>
                    }
                    else
                    {
                        @* سلة بعمودين: كل صف يحمل صنفين (يسار ويمين) بتصميم مضغوط لعرض 16 صنفاً في الشاشة،
                           مع تظليل شطرنجي (أبيض ← بنفسجي أغمق) للتمييز البصري. *@
                        for (var ri = 0; ri < _cart.Count; ri += 2)
                        {
                            var left = _cart[ri];
                            var right = ri + 1 < _cart.Count ? _cart[ri + 1] : null;
                            var alt = (ri / 2) % 2 == 1;
                            var leftOut = left.Item.CurrentStock <= 0 || left.Item.Id == _insufficientItemId;
                            <div class="pos-cart-row @(alt ? "pos-cart-row--alt" : "")">
                                <div class="pos-line @(leftOut ? "pos-line--no-stock" : "")">
                                    <div class="pos-line-top">
                                        <div class="pos-line-name" title="@left.Item.NameAr">@left.Item.NameAr</div>
                                        @if (leftOut)
                                        {
                                            <span class="pos-line-stock-badge">@Loc["PosOutOfStock"]</span>
                                        }
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Remove(left)" />
                                    </div>
                                    <div class="pos-line-bottom">
                                        <div class="pos-line-price">@left.Item.SalePrice.ToString("N2")</div>
                                        <div class="pos-line-qty">
                                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="() => Increment(left)" />
                                            <input class="pos-qty-box" type="number" min="0" step="any" inputmode="decimal"
                                                   value="@left.Quantity.ToString("0.##")"
                                                   @onchange="@(e => SetQuantity(left, e.Value?.ToString()))" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Default" OnClick="() => Decrement(left)" />
                                        </div>
                                        <div class="pos-line-total">@left.LineTotal.ToString("N2")</div>
                                    </div>
                                </div>

                                @if (right is not null)
                                {
                                    var rightOut = right.Item.CurrentStock <= 0 || right.Item.Id == _insufficientItemId;
                                    <div class="pos-line @(rightOut ? "pos-line--no-stock" : "")">
                                        <div class="pos-line-top">
                                            <div class="pos-line-name" title="@right.Item.NameAr">@right.Item.NameAr</div>
                                            @if (rightOut)
                                            {
                                                <span class="pos-line-stock-badge">@Loc["PosOutOfStock"]</span>
                                            }
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => Remove(right)" />
                                        </div>
                                        <div class="pos-line-bottom">
                                            <div class="pos-line-price">@right.Item.SalePrice.ToString("N2")</div>
                                            <div class="pos-line-qty">
                                                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary" OnClick="() => Increment(right)" />
                                                <input class="pos-qty-box" type="number" min="0" step="any" inputmode="decimal"
                                                       value="@right.Quantity.ToString("0.##")"
                                                       @onchange="@(e => SetQuantity(right, e.Value?.ToString()))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.Remove" Size="Size.Small" Color="Color.Default" OnClick="() => Decrement(right)" />
                                            </div>
                                            <div class="pos-line-total">@right.LineTotal.ToString("N2")</div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    }
                </div>

                @if (!_posHideCustomer)
                {
                    <MudAutocomplete T="CustomerDto" @bind-Value="_selectedCustomer" SearchFunc="@SearchCustomers"
                                     ToStringFunc="@(c => $"{c.Code} - {c.NameAr}")" Label="@Loc["Customer"]"
                                     Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" />
                }

                @if (!_posHideDiscount)
                {
                    <div class="pos-discount">
                        <MudNumericField T="decimal" @bind-Value="_discountPercent" Label="@Loc["PosDiscountPercent"]"
                                         Dense="true" Variant="Variant.Outlined" />
                    </div>
                }

                <div class="pos-totals">
                    <div class="pos-total-row"><span>@Loc["SubTotal"]</span><span>@SubTotal.ToString("N2")</span></div>
                    <div class="pos-total-row"><span>@Loc["DiscountAmount"]</span><span>@DiscountAmount.ToString("N2")</span></div>
                    <div class="pos-total-row"><span>@Loc["TaxAmount"]</span><span>@TaxAmount.ToString("N2")</span></div>
                    <div class="pos-total-row grand"><span>@Loc["Total"]</span><span>@TotalAmount.ToString("N2")</span></div>
                </div>
            </div>
            <div class="pos-cart-right">
            <div class="pos-payment">
                <div class="pos-pay-methods">
                    <button class="pos-pay @(_paymentMethod == 1 ? "active" : "")" @onclick="() => _paymentMethod = 1">@Loc["Cash"]</button>
                    <button class="pos-pay @(_paymentMethod == 2 ? "active" : "")" @onclick="() => _paymentMethod = 2">@Loc["Card"]</button>
                    <button class="pos-pay pos-pay-new-invoice" @onclick="NewInvoice"><MudIcon Icon="@Icons.Material.Filled.Receipt" Size="Size.Small" Class="me-1" />@Loc["NewInvoice"]</button>
                </div>

                @if (_paymentMethod == 2)
                {
                    @* حقول الدفع بالبطاقة: رقم الموافقة إلزامي (من إيصال الطرفية) + اختيارية (آخر 4 أرقام / الشبكة) *@
                    <div class="pos-card-fields">
                        <MudTextField @bind-Value="_cardApprovalCode" T="string"
                                     Label="@Loc["CardApprovalCode"]"
                                     Placeholder="@Loc["CardApprovalPlaceholder"]"
                                     Variant="Variant.Outlined" Dense="true" Immediate="true" />
                        <div class="pos-card-row two">
                            <MudTextField @bind-Value="_cardLast4" T="string"
                                         Label="@Loc["CardLast4"]" MaxLength="4"
                                         Variant="Variant.Outlined" Dense="true" Immediate="true" />
                            <MudSelect @bind-Value="_cardNetwork" T="string"
                                       Label="@Loc["CardNetwork"]"
                                       Variant="Variant.Outlined" Dense="true"
                                       Placeholder="@Loc["CardNetworkPlaceholder"]">
                                @foreach (var net in CardNetworks)
                                {
                                    <MudSelectItem T="string" Value="@net">@net</MudSelectItem>
                                }
                            </MudSelect>
                        </div>
                    </div>
                }
                else
                {
                    <MudTextField @bind-Value="_receivedInput" T="string" Label="@Loc["PosReceived"]" Variant="Variant.Outlined" Dense="true" Immediate="true" />
                        <div class="pos-change @(Change < 0 ? "negative" : "")">@Loc["PosChange"]: @Change.ToString("N2")</div>
                        <div class="pos-keypad">
                            @foreach (var key in KeypadKeys)
                            {
                                <button class="pos-key" @onclick="() => KeypadPress(key)">@key</button>
                            }
                        </div>
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="pos-checkout" OnClick="CompleteSale" Disabled="_busy">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="mr-2" />
                    @Loc["PosCheckout"] (@TotalAmount.ToString("N2"))
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Info" FullWidth="true" Disabled="_cart.Count == 0 || _busy" OnClick="HoldSaleAsync" Class="mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.PauseCircle" Class="mr-2" /> @Loc["HoldSale"]
                </MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" FullWidth="true" OnClick="OpenHeldSalesAsync" Disabled="_busy" Class="mt-2">
                    <MudIcon Icon="@Icons.Material.Filled.History" Class="mr-2" /> @Loc["HeldSales"]
                </MudButton>
            </div>
            </div>
        </div>
    </div>
</div>
@code {
    private class CartLine
    {
        public ItemDto Item { get; set; } = default!;
        public decimal Quantity { get; set; } = 1;
        private decimal? _overrideUnitPrice;

        /// <summary>سعر الوحدة الفعلي: افتراضياً سعر البيع الخاص بالصنف، إلا إذا فُرِّض (باركود بسعر مدمج).</summary>
        public decimal UnitPrice => _overrideUnitPrice ?? Item.SalePrice;

        public void SetOverrideUnitPrice(decimal price) => _overrideUnitPrice = price;
        public decimal LineTotal => Math.Round(UnitPrice * Quantity, 2);
    }

    /// <summary>لقطة بند في عملية موقوفة (يحفظ فقط البيانات اللازمة لإعادة البناء).</summary>
    private class HeldCartLine
    {
        public Guid ItemId { get; set; }
        public decimal Quantity { get; set; }
        public decimal UnitPrice { get; set; }
        public decimal Discount { get; set; }
    }

    private static readonly string[] CategoryColors = new[]
    {
        "#6D5BD0", "#3B82F6", "#14B8A6", "#F59E0B", "#F472B6", "#EF4444", "#8B5CF6", "#0EA5E9"
    };

    private static readonly string[] KeypadKeys = new[]
    {
        "1", "2", "3", "4", "5", "6", "7", "8", "9", "C", "0", "."
    };

    private bool _busy;
    private string _search = string.Empty;
    private string _receivedInput = string.Empty;
    // حقول البطاقة (المرحلة 1 — متوافقة مع PCI-DSS: بلا رقم كامل أو CVV)
    private string _cardApprovalCode = string.Empty;
    private string _cardLast4 = string.Empty;
    private string? _cardNetwork;

    /// <summary>الشبكات المعروضة في قائمة اختيار البطاقة (اختياري — للتسجيل فقط).</summary>
    private static readonly string[] CardNetworks = { "Visa", "Mastercard", "Amex", "أخرى" };
    private string _cashierName = "?";
    private string? _cashierUserId;
    private ERPSystem.Application.Services.WeightBarcodeRule? _weightRule;
    private string _clock = string.Empty;
    private int _paymentMethod = 1;
    private decimal _discountPercent;
    private decimal _taxRate = 16;
    private Guid? _selectedCategoryId;
    private Guid? _defaultWarehouseId;

    /// <summary>معرّف الصنف الذي فشل فحص الرصيد في آخر محاولة إتمام — يُستخدم لتمييزه بصرياً في الشبكة والسلة.</summary>
    private Guid? _insufficientItemId;

    // إعدادات نقطة البيع (تُحفظ في localStorage وتُطبَّق كمتغيرات CSS)
    private int _posColumns = 6;
    private string _posSize = "medium";
    private string _posAccent = "#6D5BD0";
    private int _posCartWidth = 720;
    private bool _posHideItems;
    private bool _posHideCustomer = true;
    private bool _posHideDiscount = true;
    private bool _scrollCartToTop;

    // إعدادات الطابعة الحرارية (الترويسة/الهاتف/الترحيب/مقاس الورق)
    private string _printerShopName = "";
    private string _printerPhone = "";
    private string _printerThanks = "";
    private string _printerPaper = "80";
    private bool _scrollCartToBottom;

    // ── الأداء: حدّ أزرار الشبكة + ذاكرة مؤقتة ──
    // مع آلاف الأصناف يتحول عرض كل الأزرار كل مرة إلى تجمّد (DOM ضخم + إعادة حساب LINQ).
    // نعرض فقط أول _posGridLimit نتيجة (البحث يغطي القائمة الكاملة في الذاكرة)،
    // ونعيد استخدام النتيجة المخبأة طالما لم يتغير البحث/الفئة.
    // القيمة تُقرأ من SystemSettings.PosGridLimit (قابلة للتعديل من إعدادات المالك)،
    // مع افتراض آمن = 30 إن لم تكن مهيأة (لا تؤدي إلى انهيار الشاشة).
    private const int DefaultPosGridLimit = 30;
    private int _posGridLimit = DefaultPosGridLimit;
    private List<ItemDto>? _posGridCache;
    private string _posGridCacheSearch = string.Empty;
    private Guid? _posGridCacheCategory;

    private void InvalidateItemGrid() => _posGridCache = null;

    /// <summary>يقرأ حدّ شبكة POS من SystemSettings (قيمة آمنة 30 عند أي خطأ/غياب).</summary>
    private async Task LoadPosGridLimitAsync()
    {
        try
        {
            var s = await SystemSettingsService.GetAsync();
            _posGridLimit = s.PosGridLimit > 0 ? s.PosGridLimit : DefaultPosGridLimit;
        }
        catch
        {
            _posGridLimit = DefaultPosGridLimit;
        }
        InvalidateItemGrid();
    }

    private List<ItemDto> _items = new();
    private List<CategoryDto> _categories = new();
    private List<CustomerDto> _customers = new();
    private CustomerDto? _walkInCustomer;
    private CustomerDto? _selectedCustomer;
    private readonly List<CartLine> _cart = new();

    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private ICategoryService CategoryService { get; set; } = default!;
    [Inject] private ICustomerService CustomerService { get; set; } = default!;
    [Inject] private IWarehouseService WarehouseService { get; set; } = default!;
    [Inject] private ISalesInvoiceService SalesInvoiceService { get; set; } = default!;
    [Inject] private AuthenticationStateProvider AuthStateProvider { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private ISystemSettingsService SystemSettingsService { get; set; } = default!;
    [Inject] private IHeldSaleService HeldSaleService { get; set; } = default!;

    private List<ItemDto> FilteredItems
    {
        get
        {
            // ذاكرة مؤقتة: لا نعيد تصفية/فرز القائمة كاملة عند كل إعادة رسم إلا إذا تغيّر البحث أو الفئة.
            if (_posGridCache is not null
                && _posGridCacheSearch == _search
                && _posGridCacheCategory == _selectedCategoryId)
                return _posGridCache;

            IEnumerable<ItemDto> query = _items;
            if (_selectedCategoryId.HasValue)
                query = query.Where(i => i.CategoryId == _selectedCategoryId.Value);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var term = _search.Trim();
                query = query.Where(i =>
                    i.NameAr.Contains(term) ||
                    (i.NameEn != null && i.NameEn.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    i.Code.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    (i.Barcode != null && i.Barcode.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            _posGridCacheSearch = _search;
            _posGridCacheCategory = _selectedCategoryId;
            _posGridCache = query.Take(_posGridLimit).ToList();
            return _posGridCache;
        }
    }

    private List<ItemDto> SearchSuggestions =>
        string.IsNullOrWhiteSpace(_search)
            ? new List<ItemDto>()
            : _items.Where(i =>
                  // بحث تسلسلي: يبدأ بأول حرف ثم يكتمل بالثاني... (يُطابق بداية الاسم/الكود/الباركود/الاسم الإنكليزي)
                  i.NameAr.StartsWith(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
                  (i.NameEn != null && i.NameEn.StartsWith(_search.Trim(), StringComparison.OrdinalIgnoreCase)) ||
                  i.Code.StartsWith(_search.Trim(), StringComparison.OrdinalIgnoreCase) ||
                  (i.Barcode != null && i.Barcode.StartsWith(_search.Trim(), StringComparison.OrdinalIgnoreCase)))
              .Take(15).ToList();

    private void AddFromSearch(ItemDto item)
    {
        AddItem(item);
        _search = string.Empty;
    }

    private decimal SubTotal => Math.Round(_cart.Sum(l => l.LineTotal), 2);
    private decimal DiscountAmount => Math.Round(SubTotal * _discountPercent / 100m, 2);
    private decimal TaxAmount => Math.Round((SubTotal - DiscountAmount) * _taxRate / 100m, 2);
    private decimal TotalAmount => Math.Round(SubTotal - DiscountAmount + TaxAmount, 2);

    private decimal ReceivedAmount
    {
        get
        {
            if (string.IsNullOrWhiteSpace(_receivedInput)) return 0m;
            var norm = _receivedInput.Trim().Replace(',', '.'); // دعم "،" كفاصلة عشرية أيضاً
            // AllowDecimalPoint + InvariantCulture: النقطة دائماً فاصلة عشرية (300.50 → 300.50)
            return decimal.TryParse(norm,
                System.Globalization.NumberStyles.AllowDecimalPoint | System.Globalization.NumberStyles.AllowLeadingSign,
                System.Globalization.CultureInfo.InvariantCulture, out var v) ? v : 0m;
        }
    }
    private decimal Change => Math.Round(ReceivedAmount - TotalAmount, 2);
    protected override async Task OnInitializedAsync()
    {
        _clock = DateTime.Now.ToString("yyyy-MM-dd HH:mm");
        try
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            _cashierName = auth.User.Identity?.Name ?? "?";
            _cashierUserId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? auth.User.Identity?.Name;
        }
        catch { /* ignore */ }

        await LoadPosSettingsAsync();
        await LoadPrinterSettingsAsync();
        await LoadWeightBarcodeRuleAsync();
        await LoadPosGridLimitAsync(); // يقرأ PosGridLimit من SystemSettings (افتراضي 30)
        await LoadAsync();
    }

    /// <summary>بعد أي تغيير في السلة نمرّر القائمة تلقائياً لإظهار آخر صنف مُدخل (عند امتلاء السلة).</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_scrollCartToTop)
        {
            _scrollCartToTop = false;
            await Js.InvokeVoidAsync("erpScrollPosCartToTop");
        }
        if (_scrollCartToBottom)
        {
            _scrollCartToBottom = false;
            await Js.InvokeVoidAsync("erpScrollPosCartToBottom");
        }
    }

    /// <summary>يقرأ قاعدة باركود الميزان من إعدادات النظام (قد تكون معطلة).</summary>
    private async Task LoadWeightBarcodeRuleAsync()
    {
        try
        {
            var s = await SystemSettingsService.GetAsync();
            _weightRule = ERPSystem.Application.Services.WeightBarcodeRule.FromJson(s.WeightBarcodeRuleJson);
        }
        catch { _weightRule = null; }
    }

    private async Task LoadPosSettingsAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string?>("erpLoadPosSettings");
            if (string.IsNullOrEmpty(json)) return;

            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var root = doc.RootElement;
            if (root.TryGetProperty("columns", out var c)) _posColumns = c.GetInt32();
            if (root.TryGetProperty("size", out var s)) _posSize = s.GetString() ?? "medium";
            if (root.TryGetProperty("accent", out var a)) _posAccent = a.GetString() ?? "#6D5BD0";
            if (root.TryGetProperty("cartWidth", out var w)) _posCartWidth = w.GetInt32();
            if (root.TryGetProperty("hideItems", out var hi)) _posHideItems = hi.GetBoolean();
            if (root.TryGetProperty("hideCustomer", out var hc)) _posHideCustomer = hc.GetBoolean();
            if (root.TryGetProperty("hideDiscount", out var hd)) _posHideDiscount = hd.GetBoolean();

            var scale = _posSize switch { "small" => 0.85, "large" => 1.2, _ => 1.0 };
            await Js.InvokeVoidAsync("erpApplyPosSettings", _posColumns, _posCartWidth, _posAccent, scale);
        }
        catch { /* ignore */ }
    }

    /// <summary>يقرأ إعدادات الطابعة الحرارية من localStorage (اسم المنشأة/الهاتف/الترحيب/مقاس الورق).</summary>
    private async Task LoadPrinterSettingsAsync()
    {
        try
        {
            var json = await Js.InvokeAsync<string?>("erpLoadPrinterSettings");
            if (string.IsNullOrEmpty(json)) return;
            using var doc = System.Text.Json.JsonDocument.Parse(json);
            var r = doc.RootElement;
            if (r.TryGetProperty("shopName", out var a)) _printerShopName = a.GetString() ?? "";
            if (r.TryGetProperty("phone", out var b)) _printerPhone = b.GetString() ?? "";
            if (r.TryGetProperty("thanks", out var c)) _printerThanks = c.GetString() ?? "";
            if (r.TryGetProperty("paper", out var d)) _printerPaper = d.GetString() ?? "80";
        }
        catch { /* ignore */ }
    }

    private async Task OpenSettings()
    {
        var parameters = new DialogParameters
        {
            ["Columns"] = _posColumns,
            ["Size"] = _posSize,
            ["Accent"] = _posAccent,
            ["CartWidth"] = _posCartWidth,
            ["HideItems"] = _posHideItems,
            ["HideCustomer"] = _posHideCustomer,
            ["HideDiscount"] = _posHideDiscount
        };
        var dialog = await DialogService.ShowAsync<PosSettingsDialog>(
            Loc["PosSettings"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        if ((await dialog.Result)?.Canceled != true)
        {
            await LoadPosSettingsAsync();
            await LoadPrinterSettingsAsync();
        }
    }

    private async Task LoadAsync()
    {
        try
        {
            _items = await ItemService.GetAllAsync();
            InvalidateItemGrid(); // القائمة تغيّرت → أعد حساب الشبكة عند أول رسم
            _categories = await CategoryService.GetAllAsync();
            _customers = await CustomerService.GetAllAsync();
            var warehouses = await WarehouseService.GetAllAsync();
            _defaultWarehouseId = warehouses.FirstOrDefault(w => w.IsDefault)?.Id ?? warehouses.FirstOrDefault()?.Id;
            _walkInCustomer = _customers.FirstOrDefault(c => c.Code == "CASH");
            _selectedCustomer ??= _walkInCustomer;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private string CategoryColor(int index) => CategoryColors[index % CategoryColors.Length];

    private void SelectCategory(Guid? categoryId) => _selectedCategoryId = categoryId;

    private void AddItem(ItemDto item)
    {
        var line = _cart.FirstOrDefault(l => l.Item.Id == item.Id);
        if (line is null) _cart.Add(new CartLine { Item = item, Quantity = 1 });
        else line.Quantity += 1;
        _scrollCartToBottom = true;
    }

    private void Increment(CartLine line)
    {
        line.Quantity += 1;
        _scrollCartToBottom = true;
    }

    private void Decrement(CartLine line)
    {
        line.Quantity -= 1;
        if (line.Quantity <= 0) _cart.Remove(line);
        _scrollCartToBottom = true;
    }

    /// <summary>تحديث الكمية يدويًا من صندوق الكمية في سطر السلة.</summary>
    private void SetQuantity(CartLine line, string? raw)
    {
        if (string.IsNullOrWhiteSpace(raw)) return;
        var normalized = raw.Trim().Replace(',', '.');
        if (decimal.TryParse(normalized, System.Globalization.CultureInfo.InvariantCulture, out var q))
        {
            if (q <= 0) _cart.Remove(line);
            else line.Quantity = q;
            _scrollCartToBottom = true;
        }
    }

    private void Remove(CartLine line) => _cart.Remove(line);
    private void ClearCart()
    {
        _cart.Clear();
        _scrollCartToTop = true;
    }

    /// <summary>إيقاف العملية الحالية: حفظ لقطة السلة وحفظها كصف HeldSale ثم مسح السلة.</summary>
    private async Task HoldSaleAsync()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            if (_cart.Count == 0) return;
            if (string.IsNullOrWhiteSpace(_cashierUserId)) { Snackbar.Add(Loc["PosNotIdentified"], Severity.Warning); return; }

            var snapshot = _cart.Select(l => new HeldCartLine
            {
                ItemId = l.Item.Id,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                Discount = 0m
            }).ToList();

            await HeldSaleService.HoldAsync(new SaveHeldSaleDto
            {
                CashierUserId = _cashierUserId,
                CustomerId = _selectedCustomer?.Id,
                LinesJson = System.Text.Json.JsonSerializer.Serialize(snapshot)
            });

            // مسح السلة الحالية للعميل التالي — لم يمسّ المخزون/الحسابات إطلاقاً.
            NewInvoice();
            Snackbar.Add(Loc["PosHeld"], Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; InvalidateItemGrid(); }
    }

    /// <summary>فتح لوحة العمليات الموقوفة لعرضها واستئناف أو إلغاء إحداها.</summary>
    private async Task OpenHeldSalesAsync()
    {
        if (string.IsNullOrWhiteSpace(_cashierUserId)) return;
        var parameters = new DialogParameters
        {
            ["HeldSaleService"] = HeldSaleService,
            ["CashierId"] = _cashierUserId
        };
        var dialog = await DialogService.ShowAsync<HeldSalesDialog>(Loc["HeldSales"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is HeldSaleDto held)
        {
            await ResumeHeldSaleAsync(held);
        }
    }

    /// <summary>استئناف عملية موقوفة: إعادة بناء السلة من اللقطة وتكرار وحذف سجل الـ Hold.</summary>
    private async Task ResumeHeldSaleAsync(HeldSaleDto held)
    {
        List<HeldCartLine> lines;
        try { lines = System.Text.Json.JsonSerializer.Deserialize<List<HeldCartLine>>(held.LinesJson) ?? new(); }
        catch { lines = new(); }

        if (lines.Count == 0) { Snackbar.Add(Loc["PosHeldEmpty"], Severity.Warning); return; }

        // إعادة بناء السلة من الأصناف المعروفة (المحمّلة في _items).
        _cart.Clear();
        foreach (var h in lines)
        {
            var item = _items.FirstOrDefault(i => i.Id == h.ItemId);
            if (item is null) continue;
            var cl = new CartLine { Item = item, Quantity = h.Quantity };
            if (h.UnitPrice != item.SalePrice) cl.SetOverrideUnitPrice(h.UnitPrice);
            _cart.Add(cl);
        }

        // استرجاع العميل المرتبط إن وُجد.
        _selectedCustomer = held.CustomerId.HasValue
            ? _customers.FirstOrDefault(c => c.Id == held.CustomerId.Value)
            : _walkInCustomer;

        await HeldSaleService.DeleteAsync(held.Id);
        Snackbar.Add(Loc["PosResumed"], Severity.Success);
    }

    /// <summary>بدء فاتورة جديدة: مسح السلة وإعادة ضبط الدفع والخصم والبحث.</summary>
    private void NewInvoice()
    {
        ClearCart();
        _receivedInput = string.Empty;
        _paymentMethod = 1;
        _cardApprovalCode = string.Empty;
        _cardLast4 = string.Empty;
        _cardNetwork = null;
        _search = string.Empty;
        _discountPercent = 0;
    }

    private void KeypadPress(string key)
    {
        if (key == "C") { _receivedInput = string.Empty; return; }
        if (key == "." && _receivedInput.Contains(".")) return;
        _receivedInput += key;
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter") return;
        var term = _search?.Trim();
        if (string.IsNullOrWhiteSpace(term)) return;

        // 1) جرّب الباركود الموزون أولاً (باركود كود + وزن/سعر من ميزان).
        if (ERPSystem.Application.Services.BarcodeParser.TryParseWeightEmbedded(term, _weightRule, out var parsed)
            && parsed is not null)
        {
            var item = _items.FirstOrDefault(i => i.Code == parsed.ItemCode);
            if (item is null)
            {
                Snackbar.Add(Loc["PosItemNotFound"], Severity.Warning);
                return;
            }
            if (parsed.ValueType == ERPSystem.Domain.Enums.WeightBarcodeValueType.Price)
            {
                // السعر مدمج مباشرة (بدون ضرب بالوزن).
                AddWeightedLine(item, 1m, parsed.Value);
            }
            else
            {
                // الوزن مدمج → الكمية = الوزن، والسعر = سعر وحدة البيع.
                AddWeightedLine(item, parsed.Value, null);
            }
            _search = string.Empty;
            return;
        }

        // 2) وإلا مسار عادي: ابحث بالباركود أولاً، ثم بالاسم/الكود — وأضف أول نتيجة.
        var match = _items.FirstOrDefault(i => !string.IsNullOrEmpty(i.Barcode) && i.Barcode == term);
        match ??= _items.FirstOrDefault(i =>
            i.NameAr.Contains(term, StringComparison.OrdinalIgnoreCase) ||
            (i.NameEn != null && i.NameEn.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
            i.Code.Contains(term, StringComparison.OrdinalIgnoreCase));
        if (match is not null)
        {
            AddItem(match);
            _search = string.Empty;
        }
        else if (e.Key is "Enter" && term.Length >= 1)
        {
            // لم يُعثر — نمسح الحقل حتى لا تتراكم نصوص باركود قديمة.
            _search = string.Empty;
        }
    }

    /// <summary>إضافة سطر بكمية موزونة (أو بسعر مدمج) — يجمع الكميات لنفس الصنف.</summary>
    private void AddWeightedLine(ItemDto item, decimal quantity, decimal? overrideUnitPrice)
    {
        var line = _cart.FirstOrDefault(l => l.Item.Id == item.Id);
        if (line is null)
        {
            var cl = new CartLine { Item = item, Quantity = quantity };
            if (overrideUnitPrice.HasValue) cl.SetOverrideUnitPrice(overrideUnitPrice.Value);
            _cart.Add(cl);
        }
        else
        {
            line.Quantity += quantity;
            if (overrideUnitPrice.HasValue) line.SetOverrideUnitPrice(overrideUnitPrice.Value);
        }
        _scrollCartToBottom = true;
    }

    private Task<IEnumerable<CustomerDto>> SearchCustomers(string text, CancellationToken ct)
    {
        var q = string.IsNullOrWhiteSpace(text)
            ? _customers
            : _customers.Where(c =>
                c.Code.Contains(text, StringComparison.OrdinalIgnoreCase) ||
                c.NameAr.Contains(text) ||
                (c.NameEn != null && c.NameEn.Contains(text, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(q.Take(50).AsEnumerable());
    }

    private void ExitPos() => Nav.NavigateTo("/");
    private void GoToReconciliation() => Nav.NavigateTo("/pos/card-reconciliation");
    private async Task CompleteSale()
    {
        // حارس النقر المزدوج: نفعّل الـ busy فوراً قبل أي تحقق آخر
        // حتى لا تُشغَّل فاتورتان متزامنتان على نفس DbContext (Scoped في الدائرة).
        if (_busy) return;
        _busy = true;
        _insufficientItemId = null; // مسح تمييز محاولة سابقة قبل التحقق من الرصيد
        try
        {
            if (_cart.Count == 0) { Snackbar.Add(Loc["PosEmptyCart"], Severity.Warning); return; }
            if (_defaultWarehouseId is null) { Snackbar.Add(Loc["PosNoWarehouse"], Severity.Error); return; }
            if (_selectedCustomer is null) { Snackbar.Add(Loc["PosNoCustomer"], Severity.Warning); return; }

        var isCard = _paymentMethod == 2;
        var total = TotalAmount;

        // ⚠️ إلزامية رقم الموافقة عند البطاقة: لا يُسجَّل بيع بطاقة بلا مرجع للمطابقة مع كشف البنك
        if (isCard && string.IsNullOrWhiteSpace(_cardApprovalCode))
        {
            Snackbar.Add(Loc["CardApprovalRequired"], Severity.Warning);
            return;
        }

        // النقدي فقط يتطلب مبلغاً مستلماً — البطاقة تُشحن بالمبلغ كاملاً من الطرفية
        if (!isCard && ReceivedAmount < total)
        {
            Snackbar.Add(Loc["PosInsufficient"], Severity.Warning);
            return;
        }

        var dto = new CreateSalesInvoiceDto
            {
                CustomerId = _selectedCustomer.Id,
                WarehouseId = _defaultWarehouseId.Value,
                InvoiceDate = DateTime.Today,
                InvoiceType = (int)SalesInvoiceType.Cash,
                PaymentMethod = _paymentMethod,
                CardApprovalCode = isCard ? _cardApprovalCode.Trim() : null,
                CardLast4 = isCard && !string.IsNullOrWhiteSpace(_cardLast4) ? _cardLast4.Trim() : null,
                CardNetwork = isCard && !string.IsNullOrWhiteSpace(_cardNetwork) ? _cardNetwork.Trim() : null,
                CardTransactionAt = isCard ? DateTime.Now : null,
                DiscountPercentage = _discountPercent,
                TaxRate = _taxRate,
                Note = "POS",
                IsPos = true,
                Lines = _cart.Select(l => new CreateSalesInvoiceLineDto
                {
                    ItemId = l.Item.Id, Quantity = l.Quantity, UnitPrice = l.UnitPrice
                }).ToList()
            };

            var invoice = await SalesInvoiceService.CreateAsync(dto);
            // البطاقة: المبلغ المحصّل هو الإجمالي كاملاً (التسوية البنكية لاحقاً) — النقدي: مبلغ مستلم - إرجاع
            var received = isCard ? total : ReceivedAmount;
            var change = isCard ? 0m : Math.Round(received - total, 2);

            ClearCart();
            _receivedInput = string.Empty;
            _search = string.Empty;

            var paymentLabel = (_paymentMethod switch { 1 => Loc["Cash"], _ => Loc["Card"] }).Value;
            var cardReference = isCard ? _cardApprovalCode.Trim() : null;
            _paymentMethod = 1;
            _cardApprovalCode = string.Empty;
            _cardLast4 = string.Empty;
            _cardNetwork = null;

            Snackbar.Add($"{Loc["PosSaleDone"]} — {invoice.InvoiceNumber}", Severity.Success);
            var receiptParams = new DialogParameters
            {
                ["Invoice"] = invoice,
                ["PaymentMethodLabel"] = paymentLabel,
                ["Received"] = received,
                ["Change"] = change,
                ["CashierName"] = _cashierName,
                ["ShopName"] = _printerShopName,
                ["Phone"] = _printerPhone,
                ["ThanksText"] = _printerThanks,
                ["PaperType"] = _printerPaper,
                ["CardReference"] = cardReference
            };
            await DialogService.ShowAsync<PosReceiptDialog>(
                Loc["Receipt"], receiptParams,
                new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = false });
            await LoadAsync();
        }
        catch (InsufficientStockException ex)
        {
            // الرصيد غير كافٍ — نُظهر اسم الصنف ونميّزه في الشبكة والسلة ليصحح الكاشير السلة.
            _insufficientItemId = ex.ItemId;
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }
