@* نموذج حوار لإضافة نشاط (مكالمة/اجتماع/بريد/ملاحظة) *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_type" Label="@Loc["ActivityType"]" T="int" Variant="Variant.Outlined">
                        <MudSelectItem Value="1">@Loc["ActivityCall"]</MudSelectItem>
                        <MudSelectItem Value="2">@Loc["ActivityMeeting"]</MudSelectItem>
                        <MudSelectItem Value="3">@Loc["ActivityEmail"]</MudSelectItem>
                        <MudSelectItem Value="4">@Loc["ActivityNote"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_activityDate" Label="@Loc["ActivityDate"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_description" Label="@Loc["Description"]" Lines="3" Required="true"
                                  RequiredError="@Loc["RequiredField"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="_customerId" Label="@Loc["Customer"]" T="Guid?" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var c in Customers)
                        {
                            <MudSelectItem T="Guid?" Value="@c.Id">@($"{c.Code} - {c.NameAr}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="_leadId" Label="@Loc["Lead"]" T="Guid?" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var l in Leads)
                        {
                            <MudSelectItem T="Guid?" Value="@l.Id">@($"{l.Code} - {l.NameAr}")</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect @bind-Value="_opportunityId" Label="@Loc["Opportunities"]" T="Guid?" Variant="Variant.Outlined" Clearable="true">
                        @foreach (var o in Opportunities)
                        {
                            <MudSelectItem T="Guid?" Value="@o.Id">@o.Title</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">@Loc["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IActivityService ActivityService { get; set; } = default!;
    [Parameter] public List<CustomerDto> Customers { get; set; } = new();
    [Parameter] public List<LeadDto> Leads { get; set; } = new();
    [Parameter] public List<OpportunityDto> Opportunities { get; set; } = new();

    private MudForm? _form;
    private int _type = 1;
    private DateTime? _activityDate = DateTime.Today;
    private string _description = string.Empty;
    private Guid? _customerId;
    private Guid? _leadId;
    private Guid? _opportunityId;
    private string? _error;

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            await ActivityService.CreateAsync(new CreateActivityDto
            {
                Type = _type, ActivityDate = _activityDate ?? DateTime.Today, Description = _description,
                CustomerId = _customerId, LeadId = _leadId, OpportunityId = _opportunityId
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}
