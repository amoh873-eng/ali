@page "/accounts"
@inject IStringLocalizer<SharedResources> Loc

@* 
شجرة الحسابات - الهيكل الشجري للحسابات المحاسبية.
باستخدام MudTreeView لعرض الشجرة مع MudDialog للإضافة والتعديل.
*@

<PageTitle>@Loc["Accounts"] - @Loc["AppName"]</PageTitle>

@* رأس الصفحة مع الأيقونة *@
<PageHeader Title="@Loc["Accounts"]" Icon="@Icons.Material.Filled.AccountTree" />

@* أزرار الإجراءات *@
<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        @Loc["AddAccount"]
    </MudButton>
    <MudSpacer />
    <MudToggleGroup T="string" SelectionMode="SelectionMode.ToggleSelection" @bind-Value="_viewMode">
        <MudToggleItem T="string" Value="@("tree")">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Class="mr-1" /> @Loc["TreeView"]
        </MudToggleItem>
        <MudToggleItem T="string" Value="@("list")">
            <MudIcon Icon="@Icons.Material.Filled.List" Class="mr-1" /> @Loc["ListView"]
        </MudToggleItem>
    </MudToggleGroup>
</MudToolBar>

@* ===== وضع الشجرة ===== *@
@if (_viewMode == "tree")
{
    <MudPaper Elevation="1" Class="pa-4">
        @if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-4" />
        }
        else if (_treeAccounts.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="my-2">
                @Loc["NoAccounts"]
            </MudAlert>
        }
        else
        {
            @RenderTreeNodes(_treeAccounts)
        }
    </MudPaper>
}
else
{
    @* ===== وضع القائمة المسطحة ===== *@
    <MudPaper Elevation="1">
        <MudTable Items="_flatAccounts" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["Code"]</MudTh>
                <MudTh>@Loc["AccountName"]</MudTh>
                <MudTh>@Loc["Type"]</MudTh>
                <MudTh>@Loc["Nature"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.AccountTypeNameAr</MudTd>
                <MudTd>@context.NormalBalanceNameAr</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small"
                             Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? Loc["Active"] : Loc["Inactive"])
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(e => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteAccount(context))"
                                   Disabled="context.IsSystem" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private string _viewMode = "tree";
    private bool _isLoading = true;
    private List<AccountDto> _treeAccounts = new();
    private List<AccountDto> _flatAccounts = new();

    [Inject] private IAccountService AccountService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        try
        {
            _treeAccounts = await AccountService.GetAccountTreeAsync();
            _flatAccounts = await AccountService.GetAllAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error);
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>
    /// Renders tree nodes recursively.
    /// Uses a recursive Razor RenderFragment to build the visual tree.
    /// </summary>
    private RenderFragment RenderTreeNodes(List<AccountDto> accounts) => builder =>
    {
        foreach (var account in accounts)
        {
            builder.OpenComponent<MudTreeViewItem<AccountDto>>(0);
            builder.AddAttribute(1, "Value", account);
            builder.AddAttribute(2, "Text", $"{account.Code} - {account.NameAr}");
            builder.AddAttribute(3, "Icon", account.Children.Count > 0
                ? Icons.Material.Filled.Folder
                : Icons.Material.Filled.Description);
            builder.AddAttribute(4, "ChildContent", (RenderFragment)(childBuilder =>
            {
                // Edit button
                childBuilder.OpenComponent<MudIconButton>(0);
                childBuilder.AddAttribute(1, "Icon", Icons.Material.Filled.Edit);
                childBuilder.AddAttribute(2, "Size", Size.Small);
                childBuilder.AddAttribute(3, "Color", Color.Primary);
                childBuilder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => OpenEditDialog(account)));
                childBuilder.AddAttribute(5, "ClickPropagation", false);
                childBuilder.CloseComponent();

                // Delete button
                childBuilder.OpenComponent<MudIconButton>(6);
                childBuilder.AddAttribute(7, "Icon", Icons.Material.Filled.Delete);
                childBuilder.AddAttribute(8, "Size", Size.Small);
                childBuilder.AddAttribute(9, "Color", Color.Error);
                childBuilder.AddAttribute(10, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => DeleteAccount(account)));
                childBuilder.AddAttribute(11, "ClickPropagation", false);
                childBuilder.AddAttribute(12, "Disabled", account.IsSystem);
                childBuilder.CloseComponent();

                // Recursively render children
                if (account.Children.Count > 0)
                {
                    childBuilder.AddContent(13, RenderTreeNodes(account.Children));
                }
            }));
            builder.CloseComponent();
        }
    };

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["AccountService"] = AccountService,
            ["ParentAccounts"] = _flatAccounts
        };
        var dialog = await DialogService.ShowAsync<AccountFormDialog>(
            Loc["AddAccount"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true)
        {
            Snackbar.Add(Loc["AccountSaved"], Severity.Success);
            await LoadAccountsAsync();
        }
    }

    private async Task OpenEditDialog(AccountDto account)
    {
        if (account.IsSystem)
        {
            Snackbar.Add(Loc["SystemAccountEditWarning"], Severity.Warning);
            return;
        }
        var parameters = new DialogParameters
        {
            ["AccountService"] = AccountService,
            ["ParentAccounts"] = _flatAccounts,
            ["EditAccount"] = account
        };
        var dialog = await DialogService.ShowAsync<AccountFormDialog>(
            Loc["EditAccountTitle", account.NameAr], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true)
        {
            Snackbar.Add(Loc["AccountUpdated"], Severity.Success);
            await LoadAccountsAsync();
        }
    }

    private async Task DeleteAccount(AccountDto account)
    {
        if (account.IsSystem)
        {
            Snackbar.Add(Loc["SystemAccountDeleteWarning"], Severity.Warning);
            return;
        }
        var confirmed = await DialogService.ShowMessageBox(
            Loc["DeleteConfirmation"],
            Loc["DeleteAccountConfirm", account.NameAr],
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;
        try
        {
            await AccountService.DeleteAsync(account.Id);
            Snackbar.Add(Loc["AccountDeleted"], Severity.Success);
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ToggleActive(AccountDto account)
    {
        try
        {
            await AccountService.ToggleActiveAsync(account.Id);
            Snackbar.Add(
                account.IsActive ? Loc["AccountDeactivated"] : Loc["AccountActivated"],
                Severity.Info);
            await LoadAccountsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}


