@* حوار كشف حساب عميل (فواتير ومردودات برصيد جارٍ) *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_from" Label="@Loc["FromDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudDatePicker @bind-Date="_to" Label="@Loc["ToDate"]" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
            </MudItem>
        </MudGrid>

        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadAsync" Class="mt-2">
            @Loc["ShowStatement"]
        </MudButton>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
        }
        else if (_isLoading)
        {
            <MudProgressLinear Indeterminate="true" Class="my-4" />
        }
        else if (_statement is not null)
        {
            <MudText Typo="Typo.subtitle1" Class="mt-4">
                @_statement.CustomerCode - @_statement.CustomerName
            </MudText>

            <MudTable Items="_statement.Lines" Hover="true" Dense="true" Elevation="1" Class="mt-2">
                <HeaderContent>
                    <MudTh>@Loc["Date"]</MudTh>
                    <MudTh>@Loc["Document"]</MudTh>
                    <MudTh>@Loc["Type"]</MudTh>
                    <MudTh>@Loc["Debit"]</MudTh>
                    <MudTh>@Loc["Credit"]</MudTh>
                    <MudTh>@Loc["Balance"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
                    <MudTd>@context.DocumentNumber</MudTd>
                    <MudTd>@context.TypeNameAr</MudTd>
                    <MudTd>@context.Debit.ToString("N2")</MudTd>
                    <MudTd>@context.Credit.ToString("N2")</MudTd>
                    <MudTd>@context.Balance.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.body2" Class="mt-3">
                @Loc["TotalDebit"]: <strong>@_statement.TotalDebit.ToString("N2")</strong> —
                @Loc["TotalCredit"]: <strong>@_statement.TotalCredit.ToString("N2")</strong> —
                @Loc["ClosingBalance"]: <strong>@_statement.ClosingBalance.ToString("N2")</strong>
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default">@Loc["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ICustomerService CustomerService { get; set; } = default!;
    [Parameter] public CustomerDto Customer { get; set; } = default!;

    private DateTime? _from = DateTime.Today.AddMonths(-1);
    private DateTime? _to = DateTime.Today;
    private bool _isLoading;
    private CustomerStatementDto? _statement;
    private string? _error;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        _error = null;
        try
        {
            _statement = await CustomerService.GetStatementAsync(
                Customer.Id,
                _from ?? DateTime.Today.AddMonths(-1),
                _to ?? DateTime.Today);
        }
        catch (Exception ex) { _error = ex.Message; _statement = null; }
        finally { _isLoading = false; }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}