@page "/sales/customers"
@attribute [Authorize(Roles = "Sales")]
@inject IStringLocalizer<SharedResources> Loc

@* صفحة العملاء - قائمة العملاء مع البحث والإجراءات *@

<PageTitle>@Loc["Customers"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["Customers"]" Icon="@Icons.Material.Filled.People" />

<MudToolBar Class="mb-4">
    <MudTextField @bind-Value="_search"
                  Placeholder="@Loc["SearchCustomers"]"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1" />
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        @Loc["AddCustomer"]
    </MudButton>
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_customers.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            @Loc["NoCustomers"]
        </MudAlert>
    }
    else
    {
        <MudTable Items="_filteredCustomers" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["Code"]</MudTh>
                <MudTh>@Loc["Name"]</MudTh>
                <MudTh>@Loc["Phone"]</MudTh>
                <MudTh>@Loc["Balance"]</MudTh>
                <MudTh>@Loc["CreditLimit"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.Phone</MudTd>
                <MudTd>@context.CurrentBalance.ToString("N2")</MudTd>
                <MudTd>@(context.CreditLimit?.ToString("N2") ?? Loc["NoLimit"])</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? Loc["Active"] : Loc["Inactive"])
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Receipt" Size="Size.Small"
                                   Color="Color.Info" OnClick="@(e => OpenStatementDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(e => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ToggleOn" Size="Size.Small"
                                   Color="Color.Secondary" OnClick="@(e => ToggleActive(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteCustomer(context))"
                                   Disabled="context.IsSystem" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<CustomerDto> _customers = new();
    private string _search = string.Empty;

    private IEnumerable<CustomerDto> _filteredCustomers =>
        string.IsNullOrWhiteSpace(_search)
            ? _customers
            : _customers.Where(c =>
                c.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || c.NameAr.Contains(_search, StringComparison.OrdinalIgnoreCase));

    [Inject] private ICustomerService CustomerService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try { _customers = await CustomerService.GetAllAsync(); }
        catch (Exception ex) { Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["CustomerService"] = CustomerService };
        var dialog = await DialogService.ShowAsync<CustomerFormDialog>(
            Loc["AddCustomerTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["CustomerSaved"], Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(CustomerDto customer)
    {
        var parameters = new DialogParameters { ["CustomerService"] = CustomerService, ["EditCustomer"] = customer };
        var dialog = await DialogService.ShowAsync<CustomerFormDialog>(
            Loc["EditCustomerTitle", customer.NameAr], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["CustomerUpdated"], Severity.Success); await LoadAsync(); }
    }

    private async Task OpenStatementDialog(CustomerDto customer)
    {
        var parameters = new DialogParameters { ["CustomerService"] = CustomerService, ["Customer"] = customer };
        await DialogService.ShowAsync<CustomerStatementDialog>(
            Loc["StatementTitle", customer.NameAr], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
    }

    private async Task DeleteCustomer(CustomerDto customer)
    {
        if (customer.IsSystem) { Snackbar.Add(Loc["SystemCustomerDeleteWarning"], Severity.Warning); return; }
        var confirmed = await DialogService.ShowMessageBox(
            Loc["DeleteConfirmation"], Loc["DeleteCustomerConfirm", customer.NameAr],
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;
        try { await CustomerService.DeleteAsync(customer.Id); Snackbar.Add(Loc["CustomerDeleted"], Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ToggleActive(CustomerDto customer)
    {
        try
        {
            await CustomerService.ToggleActiveAsync(customer.Id);
            Snackbar.Add(customer.IsActive ? Loc["CustomerDeactivated"] : Loc["CustomerActivated"], Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

