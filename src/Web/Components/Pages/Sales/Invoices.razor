@page "/sales/invoices"
@attribute [Authorize(Roles = "Sales")]
@inject IStringLocalizer<SharedResources> Loc

@* صفحة فواتير المبيعات - قائمة فواتير المبيعات *@

<PageTitle>@Loc["SalesInvoices"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["SalesInvoices"]" Icon="@Icons.Material.Filled.ShoppingCart" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateDialog">
        @Loc["NewInvoice"]
    </MudButton>
    <MudSpacer />
    <MudText Class="align-self-center muted-text">@Loc["TotalInvoices", _invoices.Count]</MudText>
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_invoices.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            @Loc["NoInvoices"]
        </MudAlert>
    }
    else
    {
        <MudTable Items="_invoices" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["InvoiceNumber"]</MudTh>
                <MudTh>@Loc["Customer"]</MudTh>
                <MudTh>@Loc["Date"]</MudTh>
                <MudTh>@Loc["Type"]</MudTh>
                <MudTh>@Loc["Total"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.InvoiceNumber</MudTd>
                <MudTd>@context.CustomerName</MudTd>
                <MudTd>@context.InvoiceDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.InvoiceTypeNameAr</MudTd>
                <MudTd>@context.TotalAmount.ToString("N2")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Status == 2 ? Color.Success : Color.Default)">
                        @context.StatusNameAr
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                   Color="Color.Info" OnClick="@(e => ViewInvoice(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<SalesInvoiceDto> _invoices = new();

    [Inject] private ISalesInvoiceService InvoiceService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try { _invoices = await InvoiceService.GetInvoicesAsync(); }
        catch (Exception ex) { Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<SalesInvoiceFormDialog>(
            Loc["NewInvoice"], new DialogParameters(),
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["InvoiceSaved"], Severity.Success); await LoadAsync(); }
    }

    private async Task ViewInvoice(SalesInvoiceDto invoice)
    {
        var full = await InvoiceService.GetByIdAsync(invoice.Id);
        if (full is null) { Snackbar.Add(Loc["InvoiceLoadFailed"], Severity.Error); return; }
        var parameters = new DialogParameters { ["Invoice"] = full };
        await DialogService.ShowAsync<SalesInvoiceDetailsDialog>(
            Loc["InvoiceDetailsTitle", full.InvoiceNumber], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }
}
