@page "/financial-statements"
@inject IStringLocalizer<SharedResources> Loc
@attribute [Authorize(Policy = "Permission:Reports.View")]

@* صفحة القوائم المالية: قائمة الدخل والميزانية العمومية *@

<PageTitle>القوائم المالية - نظام ERP</PageTitle>

<PageHeader Title="@Loc["FinancialStatements"]" Icon="@Icons.Material.Filled.InsertChart" />

<MudTabs Rounded="true" Outlined="true" Position="Position.Top">
    <MudTabPanel Text="قائمة الدخل" Icon="@Icons.Material.Filled.TrendingUp">
        <MudGrid Class="mt-3 align-items-end">
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_incomeFrom" Label="من تاريخ" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_incomeTo" Label="إلى تاريخ" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadIncomeAsync" FullWidth="true">عرض</MudButton>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Success"
                           Href="@($"/export/income-statement/excel?from={(_incomeFrom ?? DateTime.Today):yyyy-MM-dd}&to={(_incomeTo ?? DateTime.Today):yyyy-MM-dd}")"
                           StartIcon="@Icons.Material.Filled.Download" FullWidth="true">Excel</MudButton>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           Href="@($"/export/income-statement/pdf?from={(_incomeFrom ?? DateTime.Today):yyyy-MM-dd}&to={(_incomeTo ?? DateTime.Today):yyyy-MM-dd}")"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf" FullWidth="true">PDF</MudButton>
            </MudItem>
        </MudGrid>

        @if (_income is not null)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">الإيرادات</MudText>
            <MudTable Items="_income.Revenues" Hover="true" Dense="true" Elevation="1">
                <HeaderContent>
                    <MudTh>الحساب</MudTh>
                    <MudTh>المبلغ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode - @context.AccountNameAr</MudTd>
                    <MudTd>@context.Amount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.subtitle2" Class="mt-4">المصروفات</MudText>
            <MudTable Items="_income.Expenses" Hover="true" Dense="true" Elevation="1">
                <HeaderContent>
                    <MudTh>الحساب</MudTh>
                    <MudTh>المبلغ</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode - @context.AccountNameAr</MudTd>
                    <MudTd>@context.Amount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudPaper Elevation="1" Class="pa-3 mt-4">
                <MudText Typo="Typo.body2">إجمالي الإيرادات: @_income.TotalRevenue.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">إجمالي المصروفات: @_income.TotalExpenses.ToString("N2")</MudText>
                <MudText Typo="Typo.h6" Color="@(_income.NetIncome >= 0 ? Color.Success : Color.Error)">
                    صافي الدخل: @_income.NetIncome.ToString("N2")
                </MudText>
            </MudPaper>
        }
    </MudTabPanel>

    <MudTabPanel Text="الميزانية العمومية" Icon="@Icons.Material.Filled.AccountBalance">
        <MudGrid Class="mt-3 align-items-end">
            <MudItem xs="6" sm="3">
                <MudDatePicker @bind-Date="_balanceAsOf" Label="كما في تاريخ" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
            </MudItem>
            <MudItem xs="12" sm="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadBalanceAsync" FullWidth="true">عرض</MudButton>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Success"
                           Href="@($"/export/balance-sheet/excel?asOf={(_balanceAsOf ?? DateTime.Today):yyyy-MM-dd}")"
                           StartIcon="@Icons.Material.Filled.Download" FullWidth="true">Excel</MudButton>
            </MudItem>
            <MudItem xs="12" sm="3">
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary"
                           Href="@($"/export/balance-sheet/pdf?asOf={(_balanceAsOf ?? DateTime.Today):yyyy-MM-dd}")"
                           StartIcon="@Icons.Material.Filled.PictureAsPdf" FullWidth="true">PDF</MudButton>
            </MudItem>
        </MudGrid>

        @if (_balance is not null)
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">الأصول</MudText>
            <MudTable Items="_balance.Assets" Hover="true" Dense="true" Elevation="1">
                <HeaderContent><MudTh>الحساب</MudTh><MudTh>المبلغ</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode - @context.AccountNameAr</MudTd>
                    <MudTd>@context.Amount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.subtitle2" Class="mt-4">الخصوم</MudText>
            <MudTable Items="_balance.Liabilities" Hover="true" Dense="true" Elevation="1">
                <HeaderContent><MudTh>الحساب</MudTh><MudTh>المبلغ</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode - @context.AccountNameAr</MudTd>
                    <MudTd>@context.Amount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.subtitle2" Class="mt-4">حقوق الملكية</MudText>
            <MudTable Items="_balance.Equity" Hover="true" Dense="true" Elevation="1">
                <HeaderContent><MudTh>الحساب</MudTh><MudTh>المبلغ</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode - @context.AccountNameAr</MudTd>
                    <MudTd>@context.Amount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudPaper Elevation="1" Class="pa-3 mt-4">
                <MudText Typo="Typo.body2">إجمالي الأصول: @_balance.TotalAssets.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">إجمالي الخصوم: @_balance.TotalLiabilities.ToString("N2")</MudText>
                <MudText Typo="Typo.body2">إجمالي حقوق الملكية: @_balance.TotalEquity.ToString("N2")</MudText>
                <MudText Typo="Typo.h6" Color="@(_balance.IsBalanced ? Color.Success : Color.Error)">
                    @(_balance.IsBalanced ? "الميزانية متوازنة ✓" : "الميزانية غير متوازنة ✗")
                </MudText>
            </MudPaper>
        }
    </MudTabPanel>
</MudTabs>

@code {
    private DateTime? _incomeFrom = new DateTime(DateTime.Today.Year, 1, 1);
    private DateTime? _incomeTo = DateTime.Today;
    private DateTime? _balanceAsOf = DateTime.Today;
    private IncomeStatementDto? _income;
    private BalanceSheetDto? _balance;

    [Inject] private IReportService ReportService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadIncomeAsync();
        await LoadBalanceAsync();
    }

    private async Task LoadIncomeAsync()
    {
        try { _income = await ReportService.GetIncomeStatementAsync(_incomeFrom ?? DateTime.Today, _incomeTo ?? DateTime.Today); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task LoadBalanceAsync()
    {
        try { _balance = await ReportService.GetBalanceSheetAsync(_balanceAsOf ?? DateTime.Today); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}