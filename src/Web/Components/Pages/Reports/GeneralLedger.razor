@page "/general-ledger"
@attribute [Authorize(Policy = "Permission:Reports.View")]
@inject IStringLocalizer<SharedResources> Loc

@* صفحة دفتر الأستاذ العام - كشف حركات حساب محدد *@

<PageTitle>دفتر الأستاذ - نظام ERP</PageTitle>

<PageHeader Title="@Loc["GeneralLedger"]" Icon="@Icons.Material.Filled.LibraryBooks" />

<MudGrid Class="mb-4 align-items-end">
    <MudItem xs="12" sm="4">
        <MudSelect T="Guid" @bind-Value="_accountId" Label="الحساب" Variant="Variant.Outlined">
            @foreach (var acc in _accounts)
            {
                <MudSelectItem T="Guid" Value="@acc.Id">@acc.Code - @acc.NameAr</MudSelectItem>
            }
        </MudSelect>
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudDatePicker @bind-Date="_from" Label="من تاريخ" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
    </MudItem>
    <MudItem xs="6" sm="3">
        <MudDatePicker @bind-Date="_to" Label="إلى تاريخ" Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
    </MudItem>
    <MudItem xs="12" sm="2">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync" FullWidth="true">عرض</MudButton>
    </MudItem>
</MudGrid>

@if (_ledger is not null)
{
    <MudPaper Elevation="1" Class="pa-4">
        <MudText Typo="Typo.subtitle1">@_ledger.AccountCode - @_ledger.AccountNameAr</MudText>
        <MudText Typo="Typo.caption" Class="mb-2">
            الرصيد الافتتاحي: @_ledger.OpeningBalance.ToString("N2") —
            الرصيد الختامي: @_ledger.ClosingBalance.ToString("N2")
        </MudText>
        <MudTable Items="_ledger.Lines" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>التاريخ</MudTh>
                <MudTh>القيد</MudTh>
                <MudTh>البيان</MudTh>
                <MudTh>مدين</MudTh>
                <MudTh>دائن</MudTh>
                <MudTh>الرصيد</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Date.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.EntryNumber</MudTd>
                <MudTd>@context.Description</MudTd>
                <MudTd>@context.Debit.ToString("N2")</MudTd>
                <MudTd>@context.Credit.ToString("N2")</MudTd>
                <MudTd>@context.Balance.ToString("N2")</MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
            </PagerContent>
        </MudTable>
    </MudPaper>
}

@code {
    private List<AccountDto> _accounts = new();
    private Guid _accountId;
    private DateTime? _from = DateTime.Today.AddMonths(-1);
    private DateTime? _to = DateTime.Today;
    private AccountLedgerDto? _ledger;

    [Inject] private IReportService ReportService { get; set; } = default!;
    [Inject] private IAccountService AccountService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        _accounts = await AccountService.GetAllAccountsAsync();
        _accountId = _accounts.FirstOrDefault()?.Id ?? Guid.Empty;
        if (_accountId != Guid.Empty) await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_accountId == Guid.Empty) return;
        try
        {
            _ledger = await ReportService.GetAccountLedgerAsync(
                _accountId,
                _from ?? DateTime.Today.AddMonths(-1),
                _to ?? DateTime.Today);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}