@page "/trial-balance-legacy"
@attribute [Authorize(Roles = "Reports")]
<ModuleGuard ModuleKey="Reports">
@inject IStringLocalizer<SharedResources> Loc

@* صفحة ميزان المراجعة - أرصدة الحسابات وإجمالي المدين والدائن *@

<PageTitle>@Loc["TrialBalance"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["TrialBalance"]" Icon="@Icons.Material.Filled.Balance" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="LoadAsync">@Loc["Refresh"]</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Info" OnClick="OpenPopup" StartIcon="@Icons.Material.Filled.Visibility" Class="ms-2">عرض في نافذة</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Success" Href="/export/trial-balance/excel"
               StartIcon="@Icons.Material.Filled.Download" Class="ms-2">Excel</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="/export/trial-balance/pdf"
               StartIcon="@Icons.Material.Filled.PictureAsPdf" Class="ms-2">PDF</MudButton>
    <MudSpacer />
    @if (_trialBalance is not null)
    {
        <MudChip T="string" Size="Size.Small"
                 Color="@(_trialBalance.IsBalanced ? Color.Success : Color.Error)">
            @(_trialBalance.IsBalanced ? Loc["Balanced"] : Loc["Unbalanced"])
        </MudChip>
    }
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_trialBalance is null || _trialBalance.Lines.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">@Loc["NoJournalMovement"]</MudAlert>
    }
    else
    {
        <MudTable Items="_trialBalance.Lines" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["Code"]</MudTh>
                <MudTh>@Loc["Account"]</MudTh>
                <MudTh>@Loc["Debit"]</MudTh>
                <MudTh>@Loc["Credit"]</MudTh>
                <MudTh>@Loc["Balance"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.AccountCode</MudTd>
                <MudTd>@context.AccountNameAr</MudTd>
                @* ── أرصدة الحسابات — بالعملة الموحدة ── *@
                <MudTd><MoneyDisplay Amount="context.TotalDebit" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.TotalCredit" /></MudTd>
                <MudTd><MoneyDisplay Amount="context.Balance" /></MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
            </PagerContent>
        </MudTable>

        <MudText Typo="Typo.body2" Class="pa-4">
            @Loc["TotalDebit"]: <strong>@_trialBalance.TotalDebit.ToString("N2")</strong> —
            @Loc["TotalCredit"]: <strong>@_trialBalance.TotalCredit.ToString("N2")</strong>
        </MudText>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private TrialBalanceDto? _trialBalance;

    [Inject] private IReportService ReportService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService Dialogs { get; set; } = default!;
    [Inject] private ISystemSettingsService Settings { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    private string _brand = "";
    protected override async Task OnInitializedAsync(){ try{ var s=await Settings.GetAsync(); _brand=s.AppDisplayName??"ERP"; }catch{}; await LoadAsync(); }
    private void OpenPopup()
    {
        if(_trialBalance==null) return;
        var headers = new[]{"الرمز","الحساب","مدين","دائن","الرصيد"};
        var rows = _trialBalance.Lines.OrderBy(x=>x.AccountCode).Select(x=> new List<string>{x.AccountCode, x.AccountNameAr, x.TotalDebit.ToString("N2"), x.TotalCredit.ToString("N2"), x.Balance.ToString("N2")}).ToList();
        var totals = new[]{ "", "الإجمالي", _trialBalance.TotalDebit.ToString("N2"), _trialBalance.TotalCredit.ToString("N2"), "" };
        var tbl = new GenericReportTable{ TitleAr="ميزان المراجعة", Headers=headers.ToList(), Rows=rows, Totals=totals.ToList(), ParamSummary=$"الرصيد — متوازن: {(_trialBalance.IsBalanced?"نعم":"لا")}" };
        Dialogs.ShowAsync<ReportPopup>("ميزان المراجعة", new DialogParameters{["Table"]=tbl, ["Brand"]=_brand}, new DialogOptions{ MaxWidth=MaxWidth.ExtraLarge, FullWidth=true });
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        try { _trialBalance = await ReportService.GetTrialBalanceAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _isLoading = false; }
    }
}
</ModuleGuard>
