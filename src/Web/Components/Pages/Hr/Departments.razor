@page "/hr/departments"
@attribute [Authorize(Roles = "Hr")]
@inject IStringLocalizer<SharedResources> Loc

@* صفحة الأقسام - تعرض الهيكل التنظيمي كشجرة (قسم رئيسي ← أقسام فرعية) *@

<PageTitle>@Loc["Departments"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["Departments"]" Icon="@Icons.Material.Filled.AccountTree" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => OpenCreateDialog()">
        @Loc["AddDepartment"]
    </MudButton>
    <MudSpacer />
    <MudText Class="align-self-center muted-text">@Loc["DepartmentsCount", _flatDepartments.Count]</MudText>
</MudToolBar>

<MudPaper Elevation="1" Class="pa-4">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_treeDepartments.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="my-2">
            @Loc["NoDepartments"]
        </MudAlert>
    }
    else
    {
        @RenderTreeNodes(_treeDepartments)
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<DepartmentDto> _treeDepartments = new();
    private List<DepartmentDto> _flatDepartments = new();

    [Inject] private IDepartmentService DepartmentService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _treeDepartments = await DepartmentService.GetTreeAsync();
            _flatDepartments = await DepartmentService.GetAllAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private RenderFragment RenderTreeNodes(List<DepartmentDto> departments) => builder =>
    {
        foreach (var department in departments)
        {
            builder.OpenComponent<MudTreeViewItem<DepartmentDto>>(0);
            builder.AddAttribute(1, "Value", department);
            builder.AddAttribute(2, "Text", $"{department.Code} - {department.NameAr}");
            builder.AddAttribute(3, "Icon", department.Children.Count > 0
                ? Icons.Material.Filled.Folder
                : Icons.Material.Filled.Business);
            builder.AddAttribute(4, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.OpenComponent<MudIconButton>(0);
                childBuilder.AddAttribute(1, "Icon", Icons.Material.Filled.Add);
                childBuilder.AddAttribute(2, "Size", Size.Small);
                childBuilder.AddAttribute(3, "Color", Color.Success);
                childBuilder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => OpenCreateDialog(department)));
                childBuilder.AddAttribute(5, "ClickPropagation", false);
                childBuilder.CloseComponent();

                childBuilder.OpenComponent<MudIconButton>(0);
                childBuilder.AddAttribute(1, "Icon", Icons.Material.Filled.Edit);
                childBuilder.AddAttribute(2, "Size", Size.Small);
                childBuilder.AddAttribute(3, "Color", Color.Primary);
                childBuilder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => OpenEditDialog(department)));
                childBuilder.AddAttribute(5, "ClickPropagation", false);
                childBuilder.CloseComponent();

                childBuilder.OpenComponent<MudIconButton>(0);
                childBuilder.AddAttribute(1, "Icon", Icons.Material.Filled.Delete);
                childBuilder.AddAttribute(2, "Size", Size.Small);
                childBuilder.AddAttribute(3, "Color", Color.Error);
                childBuilder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => DeleteDepartment(department)));
                childBuilder.AddAttribute(5, "ClickPropagation", false);
                childBuilder.AddAttribute(6, "Disabled", department.IsSystem);
                childBuilder.CloseComponent();

                if (department.Children.Count > 0)
                {
                    childBuilder.AddContent(13, RenderTreeNodes(department.Children));
                }
            }));
            builder.CloseComponent();
        }
    };

    private async Task OpenCreateDialog(DepartmentDto? parent = null)
    {
        var parameters = new DialogParameters
        {
            ["DepartmentService"] = DepartmentService,
            ["ParentDepartments"] = _flatDepartments,
            ["DefaultParentId"] = parent?.Id
        };
        var dialog = await DialogService.ShowAsync<DepartmentFormDialog>(
            Loc["AddDepartment"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["DepartmentSaved"], Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(DepartmentDto department)
    {
        if (department.IsSystem) { Snackbar.Add(Loc["SystemDepartmentEditWarning"], Severity.Warning); return; }
        var parameters = new DialogParameters
        {
            ["DepartmentService"] = DepartmentService,
            ["ParentDepartments"] = _flatDepartments,
            ["EditDepartment"] = department
        };
        var dialog = await DialogService.ShowAsync<DepartmentFormDialog>(
            Loc["EditDepartmentTitle", department.NameAr], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["DepartmentUpdated"], Severity.Success); await LoadAsync(); }
    }

    private async Task DeleteDepartment(DepartmentDto department)
    {
        if (department.IsSystem) { Snackbar.Add(Loc["SystemDepartmentDeleteWarning"], Severity.Warning); return; }
        var confirmed = await DialogService.ShowMessageBox(
            Loc["DeleteConfirmation"], Loc["DeleteDepartmentConfirm", department.NameAr],
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;
        try { await DepartmentService.DeleteAsync(department.Id); Snackbar.Add(Loc["DepartmentDeleted"], Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

