@* نموذج حوار لإضافة طلب إجازة *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12">
                    <MudSelect T="Guid" @bind-Value="_employeeId"
                               Label="@Loc["Employee"]"
                               Required="true"
                               RequiredError="@Loc["EmployeeRequired"]"
                               Variant="Variant.Outlined">
                        @foreach (var e in Employees)
                        {
                            <MudSelectItem T="Guid" Value="@e.Id">@e.EmployeeNumber - @e.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="LeaveType" @bind-Value="_leaveType" Label="@Loc["LeaveType"]" Variant="Variant.Outlined">
                        <MudSelectItem T="LeaveType" Value="@LeaveType.Annual">@Loc["LeaveAnnual"]</MudSelectItem>
                        <MudSelectItem T="LeaveType" Value="@LeaveType.Sick">@Loc["LeaveSick"]</MudSelectItem>
                        <MudSelectItem T="LeaveType" Value="@LeaveType.Unpaid">@Loc["LeaveUnpaid"]</MudSelectItem>
                        <MudSelectItem T="LeaveType" Value="@LeaveType.Emergency">@Loc["LeaveEmergency"]</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_startDate"
                                   Label="@Loc["StartDate"]"
                                   Variant="Variant.Outlined"
                                   T="DateTime?"
                                   AutoClose="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_endDate"
                                   Label="@Loc["EndDate"]"
                                   Variant="Variant.Outlined"
                                   T="DateTime?"
                                   AutoClose="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_reason" Label="@Loc["LeaveReason"]" Lines="2" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">@Loc["Add"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ILeaveService LeaveService { get; set; } = default!;
    [Parameter] public List<EmployeeDto> Employees { get; set; } = new();

    private MudForm? _form;
    private Guid _employeeId;
    private LeaveType _leaveType = LeaveType.Annual;
    private DateTime? _startDate = DateTime.Today;
    private DateTime? _endDate = DateTime.Today;
    private string? _reason;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Employees.Count > 0)
        {
            var active = Employees.FirstOrDefault(e => e.Status == EmployeeStatus.Active);
            _employeeId = active?.Id ?? Employees[0].Id;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        if (_endDate < _startDate)
        {
            _error = Loc["LeaveEndBeforeStart"];
            return;
        }

        _error = null;
        try
        {
            await LeaveService.CreateAsync(new CreateLeaveDto
            {
                EmployeeId = _employeeId,
                LeaveType = _leaveType,
                StartDate = _startDate ?? DateTime.Today,
                EndDate = _endDate ?? DateTime.Today,
                Reason = _reason
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
