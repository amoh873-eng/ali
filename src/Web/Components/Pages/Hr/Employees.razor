@page "/hr/employees"
@attribute [Authorize(Roles = "Hr")]
<ModuleGuard ModuleKey="Hr">
@inject IStringLocalizer<SharedResources> Loc

@* ØµÙØ­Ø© Ø§Ù„Ù…ÙˆØ¸ÙÙˆÙ† - Ø¬Ø¯ÙˆÙ„ Ø§Ù„Ù…ÙˆØ¸ÙÙŠÙ† Ù…Ø¹ Ø¨Ø­Ø« ÙˆØªØµÙÙŠØ© Ø¨Ø§Ù„Ø­Ø§Ù„Ø© *@

<PageTitle>@Loc["Employees"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["Employees"]" Icon="@Icons.Material.Filled.Groups" />

<MudToolBar Class="mb-4">
    <MudTextField @bind-Value="_search"
                  Placeholder="@Loc["SearchByEmployee"]"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1" />
    <MudSelect T="EmployeeStatus?" @bind-Value="_statusFilter"
               Label="@Loc["FilterByStatus"]"
               Variant="Variant.Outlined"
               Clearable="true"
               Class="mx-2"
               Style="min-width:180px;">
        <MudSelectItem T="EmployeeStatus?" Value="@EmployeeStatus.Active">@Loc["Active"]</MudSelectItem>
        <MudSelectItem T="EmployeeStatus?" Value="@EmployeeStatus.Suspended">@Loc["Suspended"]</MudSelectItem>
        <MudSelectItem T="EmployeeStatus?" Value="@EmployeeStatus.Terminated">@Loc["Terminated"]</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        @Loc["AddEmployee"]
    </MudButton>
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_filteredEmployees.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            @Loc["NoEmployees"]
        </MudAlert>
    }
    else
    {
        <MudTable Items="_filteredEmployees" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["EmployeeNumber"]</MudTh>
                <MudTh>@Loc["Name"]</MudTh>
                <MudTh>@Loc["Department"]</MudTh>
                <MudTh>@Loc["Position"]</MudTh>
                <MudTh>@Loc["HireDate"]</MudTh>
                <MudTh>@Loc["Salary"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmployeeNumber</MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.DepartmentNameAr</MudTd>
                <MudTd>@context.PositionNameAr</MudTd>
                <MudTd>@context.HireDate.ToString("yyyy-MM-dd")</MudTd>
                @* ── الراتب الأساسي — بالعملة الموحدة ── *@
                <MudTd><MoneyDisplay Amount="context.BasicSalary" /></MudTd>
                <MudTd>
                    <MudSelect T="EmployeeStatus" Value="@context.Status"
                               ValueChanged="@(v => SetStatus(context, v))"
                               Dense="true" Style="min-width:130px;">
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Active">@Loc["Active"]</MudSelectItem>
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Suspended">@Loc["Suspended"]</MudSelectItem>
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Terminated">@Loc["Terminated"]</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(e => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                                   Color="Color.Info" OnClick="@(e => OpenPayrollHistory(context))" title="@Loc["PayrollRuns"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteEmployee(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<EmployeeDto> _employees = new();
    private List<DepartmentDto> _departments = new();
    private List<PositionDto> _positions = new();
    private string _search = string.Empty;
    private EmployeeStatus? _statusFilter;

    private List<EmployeeDto> _filteredEmployees
    {
        get
        {
            IEnumerable<EmployeeDto> query = _employees;
            if (_statusFilter.HasValue)
                query = query.Where(e => e.Status == _statusFilter.Value);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(e =>
                    e.EmployeeNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (e.NameAr?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (e.NameEn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return query.ToList();
        }
    }

    [Inject] private IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] private IDepartmentService DepartmentService { get; set; } = default!;
    [Inject] private IPositionService PositionService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _employees = await EmployeeService.GetAllAsync();
            _departments = await DepartmentService.GetAllAsync();
            _positions = await PositionService.GetAllAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["EmployeeService"] = EmployeeService,
            ["Departments"] = _departments,
            ["Positions"] = _positions
        };
        var dialog = await DialogService.ShowAsync<EmployeeFormDialog>(
            Loc["AddEmployeeTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["EmployeeSaved"], Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(EmployeeDto employee)
    {
        var parameters = new DialogParameters
        {
            ["EmployeeService"] = EmployeeService,
            ["Departments"] = _departments,
            ["Positions"] = _positions,
            ["EditEmployee"] = employee
        };
        var dialog = await DialogService.ShowAsync<EmployeeFormDialog>(
            Loc["EditEmployeeTitle", employee.NameAr], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["EmployeeUpdated"], Severity.Success); await LoadAsync(); }
    }

    private async Task DeleteEmployee(EmployeeDto employee)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Loc["DeleteConfirmation"], Loc["DeleteEmployeeConfirm", employee.NameAr],
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;
        try { await EmployeeService.DeleteAsync(employee.Id); Snackbar.Add(Loc["EmployeeDeleted"], Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task SetStatus(EmployeeDto employee, EmployeeStatus status)
    {
        if (employee.Status == status) return;
        try
        {
            await EmployeeService.SetStatusAsync(employee.Id, status);
            Snackbar.Add(Loc["EmployeeStatusUpdated"], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    [Inject] private IPayrollService PayrollService { get; set; } = default!;

    private async Task OpenPayrollHistory(EmployeeDto employee)
    {
        var p = new DialogParameters { ["EmployeeId"] = employee.Id, ["EmployeeName"] = employee.NameAr, ["PayrollService"] = PayrollService };
        await DialogService.ShowAsync<EmployeePayrollHistoryDialog>(Loc["PayrollRuns"], p, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
    }
}

</ModuleGuard>
