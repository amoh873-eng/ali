@page "/hr/leaves"
@attribute [Authorize(Roles = "Hr")]
<ModuleGuard ModuleKey="Hr">
@inject IStringLocalizer<SharedResources> Loc

@* صفحة الإجازات - جدول طلبات الإجازة مع موافقة/رفض *@

<PageTitle>@Loc["Leaves"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["Leaves"]" Icon="@Icons.Material.Filled.EventAvailable" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        @Loc["AddLeave"]
    </MudButton>
    <MudSpacer />
    <MudText Class="align-self-center muted-text">@Loc["LeavesCount", _leaves.Count]</MudText>
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_leaves.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            @Loc["NoLeaves"]
        </MudAlert>
    }
    else
    {
        <MudTable Items="_leaves" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["Employee"]</MudTh>
                <MudTh>@Loc["LeaveType"]</MudTh>
                <MudTh>@Loc["FromDate"]</MudTh>
                <MudTh>@Loc["ToDate"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmployeeNameAr</MudTd>
                <MudTd>@LeaveTypeLabel(context.LeaveType)</MudTd>
                <MudTd>@context.StartDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.EndDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@LeaveStatusColor(context.Status)">
                        @LeaveStatusLabel(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd>
                    @if (context.Status == LeaveStatus.Pending)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                       Color="Color.Success"
                                       OnClick="@(e => SetLeaveStatus(context, LeaveStatus.Approved))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Color="Color.Warning"
                                       OnClick="@(e => SetLeaveStatus(context, LeaveStatus.Rejected))" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteLeave(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<LeaveDto> _leaves = new();
    private List<EmployeeDto> _employees = new();

    [Inject] private ILeaveService LeaveService { get; set; } = default!;
    [Inject] private IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _leaves = await LeaveService.GetAllAsync();
            _employees = await EmployeeService.GetAllAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["LeaveService"] = LeaveService,
            ["Employees"] = _employees
        };
        var dialog = await DialogService.ShowAsync<LeaveFormDialog>(
            Loc["AddLeaveTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["LeaveSaved"], Severity.Success); await LoadAsync(); }
    }

    private async Task SetLeaveStatus(LeaveDto leave, LeaveStatus status)
    {
        try
        {
            await LeaveService.SetStatusAsync(leave.Id, status);
            Snackbar.Add(Loc["LeaveStatusUpdated"], Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteLeave(LeaveDto leave)
    {
        var confirmed = await DialogService.ShowMessageBox(
            Loc["DeleteConfirmation"], Loc["DeleteLeaveConfirm"],
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;
        try { await LeaveService.DeleteAsync(leave.Id); Snackbar.Add(Loc["LeaveDeleted"], Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private string LeaveTypeLabel(LeaveType t) => t switch
    {
        LeaveType.Annual => Loc["LeaveAnnual"],
        LeaveType.Sick => Loc["LeaveSick"],
        LeaveType.Unpaid => Loc["LeaveUnpaid"],
        LeaveType.Emergency => Loc["LeaveEmergency"],
        _ => t.ToString()
    };

    private string LeaveStatusLabel(LeaveStatus s) => s switch
    {
        LeaveStatus.Pending => Loc["LeavePending"],
        LeaveStatus.Approved => Loc["LeaveApproved"],
        LeaveStatus.Rejected => Loc["LeaveRejected"],
        _ => s.ToString()
    };

    private Color LeaveStatusColor(LeaveStatus s) => s switch
    {
        LeaveStatus.Pending => Color.Warning,
        LeaveStatus.Approved => Color.Success,
        LeaveStatus.Rejected => Color.Error,
        _ => Color.Default
    };
}
</ModuleGuard>
