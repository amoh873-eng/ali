@* حوار عرض تفاصيل قيد محاسبي (بنوده) *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        @if (Entry is null)
        {
            <MudAlert Severity="Severity.Info">@Loc["NoData"]</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Loc["JournalEntryNumber"]</MudText><MudText>@Entry.EntryNumber</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Loc["Type"]</MudText><MudText>@Entry.EntryTypeNameAr</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Loc["Date"]</MudText><MudText>@Entry.EntryDate.ToString("yyyy-MM-dd")</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">@Loc["Reference"]</MudText><MudText>@Entry.ReferenceNumber</MudText></MudItem>
                <MudItem xs="12"><MudText Typo="Typo.caption">@Loc["Statement"]</MudText><MudText>@Entry.Description</MudText></MudItem>
            </MudGrid>

            <MudTable Items="Entry.Lines" Hover="true" Dense="true" Elevation="1" Class="mt-3">
                <HeaderContent>
                    <MudTh>@Loc["Account"]</MudTh>
                    <MudTh>@Loc["Debit"]</MudTh>
                    <MudTh>@Loc["Credit"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode - @context.AccountNameAr</MudTd>
                    <MudTd>@context.DebitAmount.ToString("N2")</MudTd>
                    <MudTd>@context.CreditAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.body2" Class="mt-3">
                @Loc["TotalDebit"]: <strong>@Entry.TotalDebit.ToString("N2")</strong> —
                @Loc["TotalCredit"]: <strong>@Entry.TotalCredit.ToString("N2")</strong>
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default">@Loc["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public JournalEntryDto? Entry { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}