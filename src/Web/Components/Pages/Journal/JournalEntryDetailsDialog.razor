@* حوار عرض تفاصيل قيد محاسبي (بنوده) *@

<MudDialog>
    <DialogContent>
        @if (Entry is null)
        {
            <MudAlert Severity="Severity.Info">لا توجد بيانات.</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">رقم القيد</MudText><MudText>@Entry.EntryNumber</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">النوع</MudText><MudText>@Entry.EntryTypeNameAr</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">التاريخ</MudText><MudText>@Entry.EntryDate.ToString("yyyy-MM-dd")</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">المرجع</MudText><MudText>@Entry.ReferenceNumber</MudText></MudItem>
                <MudItem xs="12"><MudText Typo="Typo.caption">البيان</MudText><MudText>@Entry.Description</MudText></MudItem>
            </MudGrid>

            <MudTable Items="Entry.Lines" Hover="true" Dense="true" Elevation="1" Class="mt-3">
                <HeaderContent>
                    <MudTh>الحساب</MudTh>
                    <MudTh>مدين</MudTh>
                    <MudTh>دائن</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.AccountCode - @context.AccountNameAr</MudTd>
                    <MudTd>@context.DebitAmount.ToString("N2")</MudTd>
                    <MudTd>@context.CreditAmount.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.body2" Class="mt-3">
                إجمالي مدين: <strong>@Entry.TotalDebit.ToString("N2")</strong> —
                إجمالي دائن: <strong>@Entry.TotalCredit.ToString("N2")</strong>
            </MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public JournalEntryDto? Entry { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}