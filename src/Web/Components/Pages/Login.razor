@page "/login"
@layout EmptyLayout
@* ملاحظة معمارية مهمة:
   هذه الصفحة تعمل بنمط Static SSR لمعالجة الفورم رغم أن باقي النظام InteractiveServer
   (موروث من <Routes @rendermode="InteractiveServer" /> في App.razor) — وذلك لأن فورم POST
   في Blazor يُعالَج دائمًا عبر مسار Static SSR (طلب HTTP خام) وليس عبر دائرة SignalR،
   وبالتالي يتوفّر HttpContext هنا لكتابة كعكة المصادقة عبر SignInManager ثم Response.Redirect.
   السبب الجذري للفشل السابق لم يكن الوراثة التفاعلية بحد ذاتها، بل أن [SupplyParameterFromForm]
   يفشل في الربط ضمن .NET 10 InteractiveServer؛ لذلك يُقرأ الفورم يدويًا عبر HttpContext.Request
   أدناه بدل الاعتماد عليه. لا تحذف هذه القراءة اليدوية ولا تُعدّل App.razor لإلغاء التفاعل العام. *@
@using System.ComponentModel.DataAnnotations
@inject IStringLocalizer<SharedResources> Loc

@* شاشة تسجيل الدخول — تصميم حديث (خلفية متدرجة + بطاقة مركزية) مع الحفاظ على ASP.NET Core Identity *@

<PageTitle>@Loc["Login"] - @Loc["AppName"]</PageTitle>

<div class="login-page">
    <div class="login-card">
        <div class="login-logo">
            <MudIcon Icon="@Icons.Material.Filled.Layers" Class="login-logo-icon" />
            <div>
                <div class="login-brand-name">@Loc["AppName"]</div>
                <div class="login-brand-erp">ERP</div>
            </div>
        </div>
        <p class="login-subtitle">@Loc["LoginSubtitle"]</p>

        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <div class="login-error">@ErrorMessage</div>
        }

        <form method="post" @formname="login">
            <AntiforgeryToken />
            <div class="login-field">
                <label>@Loc["Email"]</label>
                <input name="Email" type="email" required />
            </div>
            <div class="login-field">
                <label>@Loc["Password"]</label>
                <input name="Password" type="password" required />
            </div>
            <label class="login-remember">
                <input name="RememberMe" type="checkbox" value="true" />
                @Loc["RememberMe"]
            </label>
            <button type="submit" class="login-btn">@Loc["Login"]</button>
        </form>

        <p class="login-demo">@Loc["DemoCredentials"]</p>
    </div>
</div>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
    [Inject] private SignInManager<IdentityUser> SignInManager { get; set; } = default!;

    private string? ErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext is null || !HttpMethods.IsPost(HttpContext.Request.Method))
            return;

        var form = await HttpContext.Request.ReadFormAsync();
        var email = form["Email"].ToString();
        var password = form["Password"].ToString();
        var rememberMe = form["RememberMe"].ToString() == "true";

        if (string.IsNullOrEmpty(email) || string.IsNullOrEmpty(password))
        {
            ErrorMessage = Loc["LoginFailed"];
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(email, password, rememberMe, false);
        if (result.Succeeded)
        {
            HttpContext.Response.Redirect("/");
            return;
        }

        ErrorMessage = Loc["LoginFailed"];
    }
}
