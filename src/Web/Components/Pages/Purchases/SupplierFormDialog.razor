@* نموذج حوار لإضافة/تعديل مورد *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_code" Label="@Loc["SupplierCode"]" Required="true" RequiredError="@Loc["SupplierCodeRequired"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameAr" Label="@Loc["SupplierNameAr"]" Required="true" RequiredError="@Loc["SupplierNameRequired"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameEn" Label="@Loc["SupplierNameEn"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_phone" Label="@Loc["Phone"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_email" Label="@Loc["Email"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_taxNumber" Label="@Loc["TaxNumber"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_creditLimit" Label="@Loc["CreditLimitOptional"]" Variant="Variant.Outlined" T="decimal?" Clearable="true" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_address" Label="@Loc["Address"]" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes" Label="@Loc["Notes"]" Lines="2" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">
            @(EditSupplier is null ? Loc["Add"] : Loc["Edit"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ISupplierService SupplierService { get; set; } = default!;
    [Parameter] public SupplierDto? EditSupplier { get; set; }

    private MudForm? _form;
    private string _code = string.Empty;
    private string _nameAr = string.Empty;
    private string? _nameEn;
    private string? _phone;
    private string? _email;
    private string? _address;
    private string? _taxNumber;
    private decimal? _creditLimit;
    private string? _notes;
    private string? _error;

    protected override void OnInitialized()
    {
        if (EditSupplier is not null)
        {
            _code = EditSupplier.Code;
            _nameAr = EditSupplier.NameAr;
            _nameEn = EditSupplier.NameEn;
            _phone = EditSupplier.Phone;
            _email = EditSupplier.Email;
            _address = EditSupplier.Address;
            _taxNumber = EditSupplier.TaxNumber;
            _creditLimit = EditSupplier.CreditLimit;
            _notes = EditSupplier.Notes;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            if (EditSupplier is null)
            {
                await SupplierService.CreateAsync(new CreateSupplierDto
                {
                    Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    Phone = _phone, Email = _email, Address = _address,
                    TaxNumber = _taxNumber, CreditLimit = _creditLimit, Notes = _notes
                });
            }
            else
            {
                await SupplierService.UpdateAsync(new UpdateSupplierDto
                {
                    Id = EditSupplier.Id, Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    Phone = _phone, Email = _email, Address = _address,
                    TaxNumber = _taxNumber, CreditLimit = _creditLimit, Notes = _notes,
                    IsActive = EditSupplier.IsActive
                });
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}