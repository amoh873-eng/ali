@page "/"
@attribute [Authorize]

<PageTitle>@Loc["Dashboard"] - @Loc["AppName"]</PageTitle>

@* تم حذف عنوان "لوحة التحكم" - البطاقات تبدأ مباشرة بدون فراغ بنفسجي *@
@* <PageHeader Title="@Loc["Dashboard"]" /> *@

@* سحب للأسفل بمقدار 2سم — يُطبق على كامل الصفحة *@
<div style="margin-top:32px"></div>
@* 3 بطاقات أرقام + مخططات حديثة *@
<MudGrid Spacing="4" RowSpacing="5" ColumnSpacing="4" Style="margin-top:8px">
    @* بطاقات المؤشرات الرئيسية في الأعلى *@
    @* ── بطاقات المال — تعرض بالعملة الموحدة عبر نفس المكون المركزي ── *@
    @* لماذا MoneyDisplay؟ نقطة واحدة للتنسيق، يتغير الرمز تلقائياً عند تغيير العملة في /settings *@
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-2" Style="background:#F0FDF4;border:1px solid #D1FAE5">
            <div class="d-flex align-center mb-1">
                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.ShoppingCart" Style="background:#10B981;color:#fff;border-radius:6px;padding:4px" />
                <div class="ms-2"><MudText Typo="@Typo.overline" Style="color:#16A34A">@Loc["NetSales"]</MudText><MudText Typo="@Typo.subtitle2" Style="font-weight:700"><MoneyDisplay Amount="_salesTotal" /></MudText></div>
            </div>
            <PeriodComparison Current="_salesCur" Previous="_salesPrev" YearAgo="_salesYoy" UpIsGood="true" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-2" Style="background:#FFF7ED;border:1px solid #FED7AA">
            <div class="d-flex align-center mb-1">
                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.LocalShipping" Style="background:#F59E0B;color:#fff;border-radius:6px;padding:4px" />
                <div class="ms-2"><MudText Typo="@Typo.overline" Style="color:#D97706">@Loc["NetPurchases"]</MudText><MudText Typo="@Typo.subtitle2" Style="font-weight:700"><MoneyDisplay Amount="_purchasesTotal" /></MudText></div>
            </div>
            <PeriodComparison Current="_purchasesCur" Previous="_purchasesPrev" YearAgo="_purchasesYoy" UpIsGood="true" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-2" Style="background:#F0F9FF;border:1px solid #BAE6FD">
            <div class="d-flex align-center mb-1">
                <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.TrendingUp" Style="background:#0284C7;color:#fff;border-radius:6px;padding:4px" />
                <div class="ms-2"><MudText Typo="@Typo.overline" Style="color:#0369A1">@Loc["NetIncome"]</MudText><MudText Typo="@Typo.subtitle2" Style="font-weight:700"><MoneyDisplay Amount="_netIncomeTotal" /></MudText></div>
            </div>
            <PeriodComparison Current="_netIncomeCur" Previous="_netIncomePrev" YearAgo="_netIncomeYoy" UpIsGood="true" />
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" lg="3">
        <MudPaper Class="pa-2 d-flex align-center" Style="background:#F5F3FF;border:1px solid #DDD6FE">
            <MudIcon Size="Size.Small" Icon="@Icons.Material.Filled.Inventory" Style="background:#6D5BD0;color:#fff;border-radius:6px;padding:4px" />
            <div class="ms-2"><MudText Typo="@Typo.overline" Style="color:#5B21B6">@Loc["InventoryValue"]</MudText><MudText Typo="@Typo.subtitle2" Style="font-weight:700"><MoneyDisplay Amount="_inventoryValue" /></MudText></div>
        </MudPaper>
    </MudItem>

    @* أفضل 5 أصناف مبيعاً (أشرطة أفقية) + دونات النِّسَب مصغّرة *@
    <MudItem xs="12" md="8">
        <ChartCard Title="@Loc["TopSellingItems"]" Subtitle="@Loc["TopSellingItemsSubtitle"]">
            <BarChart Items="_topItemsSegments" EmptyText="@Loc["NoTopSellingItems"]" />
        </ChartCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <ChartCard Title="@Loc["SalesVsPurchases"]" Subtitle="@Loc["SalesVsPurchasesTotal"]">
            <DonutChart3D Segments="_salesPurchasesSegments"
                          ShowLegend="true"
                          ShowCallouts="true"
                          EmptyText="@Loc["NoSalesPurchases"]" />
        </ChartCard>
    </MudItem>

</MudGrid>



@code {
    private decimal _salesTotal;
    private decimal _purchasesTotal;
    private decimal _inventoryValue;

    // مقارنة الفترات (هذا الشهر / الشهر الماضي / نفس الشهر العام الماضي)
    private decimal _salesCur, _salesPrev, _salesYoy;
    private decimal _purchasesCur, _purchasesPrev, _purchasesYoy;
    private decimal _netIncomeTotal, _netIncomeCur, _netIncomePrev, _netIncomeYoy;

    private List<DonutSegment> _salesPurchasesSegments = new();
    private string _salesPurchasesTotalText = "0";
    private List<DonutSegment> _topItemsSegments = new();

    private static readonly string[] _palette = new[] { "#8B5CF6", "#10B981", "#F59E0B", "#EF4444", "#06B6D4" };

    [Inject] private IStringLocalizer<SharedResources> Loc { get; set; } = default!;
    [Inject] private Microsoft.Extensions.DependencyInjection.IServiceScopeFactory ScopeFactory { get; set; } = default!;
    private string _curSym = "د.أ";
    // تنسيق موحد للمال في الشارتات — الرمز من الإعدادات (عرض فقط)
    private string FormatMoney(decimal v) => $"{v:N2} {_curSym}";

    protected override async Task OnInitializedAsync()
    {
        // ── تحميل رمز العملة الحالي للعرض في البطاقات والشارتات ──
        // استعلامات لوحة التحكم تُنفَّذ داخل نطاق DI مستقل (Scope) بدلاً من الخدمات
        // المشتركة للدائرة، لأن كل مكوّنات Blazor Server في الدائرة الواحدة تتقاسم
        // نسخة AppDbContext المسجّلة Scoped، وأي عمليتين متزامنتين على نفس السياق
        // تسببان خطأ "A second operation was started on this context instance...".
        // النطاق المستقل يمنح كل تحميل سياق قاعدة بيانات جديداً تماماً فلا يحدث
        // أي تعارض مع استعلامات التخطيط (MainLayout) أو مع إعادة الرندر الثانية.
        using var scope = ScopeFactory.CreateScope();
        var settingsService = scope.ServiceProvider.GetRequiredService<ERPSystem.Application.Interfaces.ISystemSettingsService>();
        var itemService = scope.ServiceProvider.GetRequiredService<IItemService>();
        var salesService = scope.ServiceProvider.GetRequiredService<ISalesInvoiceService>();
        var purchaseService = scope.ServiceProvider.GetRequiredService<IPurchaseInvoiceService>();
        var reportService = scope.ServiceProvider.GetRequiredService<ERPSystem.Application.Interfaces.IReportService>();

        try { var s = await settingsService.GetAsync(); _curSym = ERPSystem.Domain.CurrencyLookup.SymbolFor(s.CurrencyCode); } catch { }
        try
        {
            var items = await itemService.GetAllAsync();
            _inventoryValue = items.Sum(i => i.CurrentStock * i.CostPrice);

            var sales = await salesService.GetInvoicesAsync();
            _salesTotal = sales.Sum(i => i.TotalAmount);

            var purchases = await purchaseService.GetInvoicesAsync();
            _purchasesTotal = purchases.Sum(i => i.TotalAmount);

            // نوافذ المقارنة: هذا الشهر / الشهر الماضي / نفس الشهر عام ماضٍ
            var today = System.DateTime.Today;
            var curFrom = new System.DateTime(today.Year, today.Month, 1);
            var curTo = today;
            var prevFrom = curFrom.AddMonths(-1);
            var prevTo = curFrom.AddDays(-1);
            var yoyFrom = curFrom.AddYears(-1);
            var yoyTo = curFrom.AddDays(-1).AddYears(-1);

            _salesCur = sales.Where(i => i.InvoiceDate >= curFrom && i.InvoiceDate <= curTo).Sum(i => i.TotalAmount);
            _salesPrev = sales.Where(i => i.InvoiceDate >= prevFrom && i.InvoiceDate <= prevTo).Sum(i => i.TotalAmount);
            _salesYoy = sales.Where(i => i.InvoiceDate >= yoyFrom && i.InvoiceDate <= yoyTo).Sum(i => i.TotalAmount);

            _purchasesCur = purchases.Where(i => i.InvoiceDate >= curFrom && i.InvoiceDate <= curTo).Sum(i => i.TotalAmount);
            _purchasesPrev = purchases.Where(i => i.InvoiceDate >= prevFrom && i.InvoiceDate <= prevTo).Sum(i => i.TotalAmount);
            _purchasesYoy = purchases.Where(i => i.InvoiceDate >= yoyFrom && i.InvoiceDate <= yoyTo).Sum(i => i.TotalAmount);

            _netIncomeCur = (await reportService.GetIncomeStatementAsync(curFrom, curTo)).NetIncome;
            _netIncomePrev = (await reportService.GetIncomeStatementAsync(prevFrom, prevTo)).NetIncome;
            _netIncomeYoy = (await reportService.GetIncomeStatementAsync(yoyFrom, yoyTo)).NetIncome;
            _netIncomeTotal = _netIncomeCur;

            BuildSalesPurchasesChart();
            await BuildTopItemsChartAsync(salesService);
        }
        catch
        {
        }
    }

    /// <summary>رسم دائري للمبيعات مقابل المشتريات (إجمالي القيم).</summary>
    private void BuildSalesPurchasesChart()
    {
        var total = _salesTotal + _purchasesTotal;
        _salesPurchasesTotalText = total.ToString("N0");

        _salesPurchasesSegments = new List<DonutSegment>
        {
            // ── نص القيمة في الدونات — يعرض مع الرمز عبر MoneyDisplay خارجاً، هنا نحتفظ بالرقم فقط ──
            new() { Label = Loc["Sales"].Value, Color = "#8B5CF6", Value = (double)_salesTotal, ValueText = FormatMoney(_salesTotal) },
            new() { Label = Loc["Purchases"].Value, Color = "#F59E0B", Value = (double)_purchasesTotal, ValueText = FormatMoney(_purchasesTotal) },
        }
        .Where(s => s.Value > 0)
        .ToList();
    }

    private async Task BuildTopItemsChartAsync(ISalesInvoiceService salesService)
    {
        var top = await salesService.GetTopSellingItemsAsync(5);
        _topItemsSegments = top.Select((t, i) => new DonutSegment
        {
            Label = t.ItemNameAr,
            Value = (double)t.TotalAmount,
            // ── أفضل صنف — الرقم مع الرمز يُعرض في الشريط، هنا ننسق رقمياً فقط ──
            ValueText = FormatMoney(t.TotalAmount),
            Color = _palette[i % _palette.Length]
        }).ToList();
    }
}