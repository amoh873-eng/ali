@page "/"
@using System.Globalization

<PageTitle>@Loc["Dashboard"] - @Loc["AppName"]</PageTitle>

@* عنوان الصفحة *@
<PageHeader Title="@Loc["Dashboard"]" />

@* 3 بطاقات أرقام + مخططات حديثة *@
<MudGrid Spacing="4" RowSpacing="5" ColumnSpacing="4">
    @* بطاقات المؤشرات الرئيسية في الأعلى *@
    <MudItem xs="12" md="4">
        <StatCard Label="@Loc["NetSales"]" Value="@_salesTotal.ToString("N2")"
                  Icon="@Icons.Material.Filled.ShoppingCart" IconBackground="#E8F5E9" IconColor="#10B981" />
    </MudItem>
    <MudItem xs="12" md="4">
        <StatCard Label="@Loc["NetPurchases"]" Value="@_purchasesTotal.ToString("N2")"
                  Icon="@Icons.Material.Filled.LocalShipping" IconBackground="#FFF3E0" IconColor="#F59E0B" />
    </MudItem>
    <MudItem xs="12" md="4">
        <StatCard Label="@Loc["InventoryValue"]" Value="@_inventoryValue.ToString("N2")"
                  Icon="@Icons.Material.Filled.Inventory" IconBackground="#F0EDFB" IconColor="#6D5BD0" />
    </MudItem>

    @* اتجاه شهري حديث (خط/مساحة) + دونات النِّسَب *@
    <MudItem xs="12" md="8">
        <ChartCard Title="@Loc["SalesVsPurchasesTrend"]" Subtitle="@Loc["Last12Months"]">
            <TrendChart Series="_trendSeries" Labels="_trendLabels" EmptyText="@Loc["NoSalesPurchases"]" />
        </ChartCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <ChartCard Title="@Loc["SalesVsPurchases"]" Subtitle="@Loc["SalesVsPurchasesTotal"]">
            <DonutChart Segments="_salesPurchasesSegments"
                        CenterValue="@_salesPurchasesTotalText"
                        CenterLabel="@Loc["Total"]"
                        EmptyText="@Loc["NoSalesPurchases"]" />
        </ChartCard>
    </MudItem>

</MudGrid>



@code {
    private decimal _salesTotal;
    private decimal _purchasesTotal;
    private decimal _inventoryValue;

    private List<DonutSegment> _salesPurchasesSegments = new();
    private string _salesPurchasesTotalText = "0";

    private List<TrendSeries> _trendSeries = new();
    private List<string> _trendLabels = new();

    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private ISalesInvoiceService SalesInvoiceService { get; set; } = default!;
    [Inject] private IPurchaseInvoiceService PurchaseInvoiceService { get; set; } = default!;
    [Inject] private IStringLocalizer<SharedResources> Loc { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await ItemService.GetAllAsync();
            _inventoryValue = items.Sum(i => i.CurrentStock * i.CostPrice);

            var sales = await SalesInvoiceService.GetInvoicesAsync();
            _salesTotal = sales.Sum(i => i.TotalAmount);

            var purchases = await PurchaseInvoiceService.GetInvoicesAsync();
            _purchasesTotal = purchases.Sum(i => i.TotalAmount);

            BuildSalesPurchasesChart();
            BuildTrendChart(sales, purchases);
        }
        catch
        {
            // في حال فشل أي استدعاء نترك القيم صفراً ولا نعطّل الصفحة
        }
    }

    /// <summary>رسم دائري للمبيعات مقابل المشتريات (إجمالي القيم).</summary>
    private void BuildSalesPurchasesChart()
    {
        var total = _salesTotal + _purchasesTotal;
        _salesPurchasesTotalText = total.ToString("N0");

        _salesPurchasesSegments = new List<DonutSegment>
        {
            new() { Label = Loc["Sales"].Value, Color = "#8B5CF6", Value = (double)_salesTotal, ValueText = _salesTotal.ToString("N2") },
            new() { Label = Loc["Purchases"].Value, Color = "#F59E0B", Value = (double)_purchasesTotal, ValueText = _purchasesTotal.ToString("N2") },
        }
        .Where(s => s.Value > 0)
        .ToList();
    }

    /// <summary>مخطط اتجاه شهري (خط/مساحة) للمبيعات والمشتريات لآخر 12 شهرًا.</summary>
    private void BuildTrendChart(List<SalesInvoiceDto> sales, List<PurchaseInvoiceDto> purchases)
    {
        var now = DateTime.Today;
        var months = Enumerable.Range(0, 12)
            .Select(i => new DateTime(now.Year, now.Month, 1).AddMonths(i - 11))
            .ToList();

        _trendLabels = months
            .Select(m => m.ToString("MMM", CultureInfo.CurrentCulture))
            .ToList();

        _trendSeries = new List<TrendSeries>
        {
            new()
            {
                Name = Loc["Sales"].Value,
                Color = "#8B5CF6",
                Values = months
                    .Select(m => (double)sales
                        .Where(s => s.InvoiceDate.Year == m.Year && s.InvoiceDate.Month == m.Month)
                        .Sum(s => s.TotalAmount))
                    .ToList()
            },
            new()
            {
                Name = Loc["Purchases"].Value,
                Color = "#F59E0B",
                Values = months
                    .Select(m => (double)purchases
                        .Where(p => p.InvoiceDate.Year == m.Year && p.InvoiceDate.Month == m.Month)
                        .Sum(p => p.TotalAmount))
                    .ToList()
            }
        };
    }
}