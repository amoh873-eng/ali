@page "/"
@attribute [Authorize]

<PageTitle>@Loc["Dashboard"] - @Loc["AppName"]</PageTitle>

@* تم حذف عنوان "لوحة التحكم" - البطاقات تبدأ مباشرة بدون فراغ بنفسجي *@
@* <PageHeader Title="@Loc["Dashboard"]" /> *@

@* سحب للأسفل بمقدار 2سم — يُطبق على كامل الصفحة *@
<div style="margin-top:32px"></div>
@* 3 بطاقات أرقام + مخططات حديثة *@
<MudGrid Spacing="4" RowSpacing="5" ColumnSpacing="4" Style="margin-top:8px">
    @* بطاقات المؤشرات الرئيسية في الأعلى *@
    @* ── بطاقات المال — تعرض بالعملة الموحدة عبر نفس المكون المركزي ── *@
    @* لماذا MoneyDisplay؟ نقطة واحدة للتنسيق، يتغير الرمز تلقائياً عند تغيير العملة في /settings *@
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3 d-flex align-center" Style="border:1px solid #E5E7EB">
            <MudIcon Icon="@Icons.Material.Filled.ShoppingCart" Style="background:#E8F5E9;color:#10B981;border-radius:8px;padding:6px" />
            <div class="ms-3"><MudText Typo="Typo.caption">@Loc["NetSales"]</MudText><MudText Typo="Typo.h6"><MoneyDisplay Amount="_salesTotal" /></MudText></div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3 d-flex align-center" Style="border:1px solid #E5E7EB">
            <MudIcon Icon="@Icons.Material.Filled.LocalShipping" Style="background:#FFF3E0;color:#F59E0B;border-radius:8px;padding:6px" />
            <div class="ms-3"><MudText Typo="Typo.caption">@Loc["NetPurchases"]</MudText><MudText Typo="Typo.h6"><MoneyDisplay Amount="_purchasesTotal" /></MudText></div>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="4">
        <MudPaper Class="pa-3 d-flex align-center" Style="border:1px solid #E5E7EB">
            <MudIcon Icon="@Icons.Material.Filled.Inventory" Style="background:#F0EDFB;color:#6D5BD0;border-radius:8px;padding:6px" />
            <div class="ms-3"><MudText Typo="Typo.caption">@Loc["InventoryValue"]</MudText><MudText Typo="Typo.h6"><MoneyDisplay Amount="_inventoryValue" /></MudText></div>
        </MudPaper>
    </MudItem>

    @* أفضل 5 أصناف مبيعاً (أشرطة أفقية) + دونات النِّسَب مصغّرة *@
    <MudItem xs="12" md="8">
        <ChartCard Title="@Loc["TopSellingItems"]" Subtitle="@Loc["TopSellingItemsSubtitle"]">
            <BarChart Items="_topItemsSegments" EmptyText="@Loc["NoTopSellingItems"]" />
        </ChartCard>
    </MudItem>
    <MudItem xs="12" md="4">
        <ChartCard Title="@Loc["SalesVsPurchases"]" Subtitle="@Loc["SalesVsPurchasesTotal"]">
            <DonutChart Segments="_salesPurchasesSegments"
                        Height="150px"
                        CenterValue="@_salesPurchasesTotalText"
                        CenterLabel="@Loc["Total"]"
                        EmptyText="@Loc["NoSalesPurchases"]" />
        </ChartCard>
    </MudItem>

</MudGrid>



@code {
    private decimal _salesTotal;
    private decimal _purchasesTotal;
    private decimal _inventoryValue;

    private List<DonutSegment> _salesPurchasesSegments = new();
    private string _salesPurchasesTotalText = "0";
    private List<DonutSegment> _topItemsSegments = new();

    private static readonly string[] _palette = new[] { "#8B5CF6", "#10B981", "#F59E0B", "#EF4444", "#06B6D4" };

    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private ISalesInvoiceService SalesInvoiceService { get; set; } = default!;
    [Inject] private IPurchaseInvoiceService PurchaseInvoiceService { get; set; } = default!;
    [Inject] private IStringLocalizer<SharedResources> Loc { get; set; } = default!;
    [Inject] private ERPSystem.Application.Interfaces.ISystemSettingsService SettingsService { get; set; } = default!;
    private string _curSym = "د.أ";
    // تنسيق موحد للمال في الشارتات — الرمز من الإعدادات (عرض فقط)
    private string FormatMoney(decimal v) => $"{v:N2} {_curSym}";

    protected override async Task OnInitializedAsync()
    {
        // ── تحميل رمز العملة الحالي للعرض في البطاقات والشارتات ──
        try { var s = await SettingsService.GetAsync(); _curSym = ERPSystem.Domain.CurrencyLookup.SymbolFor(s.CurrencyCode); } catch { }
        try
        {
            var items = await ItemService.GetAllAsync();
            _inventoryValue = items.Sum(i => i.CurrentStock * i.CostPrice);

            var sales = await SalesInvoiceService.GetInvoicesAsync();
            _salesTotal = sales.Sum(i => i.TotalAmount);

            var purchases = await PurchaseInvoiceService.GetInvoicesAsync();
            _purchasesTotal = purchases.Sum(i => i.TotalAmount);

            BuildSalesPurchasesChart();
            await BuildTopItemsChartAsync();
        }
        catch
        {
        }
    }

    /// <summary>رسم دائري للمبيعات مقابل المشتريات (إجمالي القيم).</summary>
    private void BuildSalesPurchasesChart()
    {
        var total = _salesTotal + _purchasesTotal;
        _salesPurchasesTotalText = total.ToString("N0");

        _salesPurchasesSegments = new List<DonutSegment>
        {
            // ── نص القيمة في الدونات — يعرض مع الرمز عبر MoneyDisplay خارجاً، هنا نحتفظ بالرقم فقط ──
            new() { Label = Loc["Sales"].Value, Color = "#8B5CF6", Value = (double)_salesTotal, ValueText = FormatMoney(_salesTotal) },
            new() { Label = Loc["Purchases"].Value, Color = "#F59E0B", Value = (double)_purchasesTotal, ValueText = FormatMoney(_purchasesTotal) },
        }
        .Where(s => s.Value > 0)
        .ToList();
    }

    private async Task BuildTopItemsChartAsync()
    {
        var top = await SalesInvoiceService.GetTopSellingItemsAsync(5);
        _topItemsSegments = top.Select((t, i) => new DonutSegment
        {
            Label = t.ItemNameAr,
            Value = (double)t.TotalAmount,
            // ── أفضل صنف — الرقم مع الرمز يُعرض في الشريط، هنا ننسق رقمياً فقط ──
            ValueText = FormatMoney(t.TotalAmount),
            Color = _palette[i % _palette.Length]
        }).ToList();
    }
}