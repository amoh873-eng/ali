@* نموذج حوار لإضافة/تعديل صنف *@
@inject IStringLocalizer<SharedResources> Loc
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnv

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_code"
                                  Label="@Loc["ItemCode"]"
                                  Required="true"
                                  RequiredError="@Loc["ItemCodeRequired"]"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_barcode"
                                  Label="@Loc["Barcode"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_nameAr"
                                  Label="@Loc["ItemNameAr"]"
                                  Required="true"
                                  RequiredError="@Loc["NameArRequired"]"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_nameEn"
                                  Label="@Loc["ItemNameEn"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_categoryId"
                               Label="@Loc["Category"]"
                               Required="true"
                               RequiredError="@Loc["CategoryRequired"]"
                               Variant="Variant.Outlined"
                               T="Guid">
                        @foreach (var cat in Categories)
                        {
                            <MudSelectItem Value="@cat.Id">@cat.Code - @cat.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_unitId"
                               Label="@Loc["Unit"]"
                               Required="true"
                               RequiredError="@Loc["UnitRequired"]"
                               Variant="Variant.Outlined"
                               T="Guid">
                        @foreach (var unit in Units)
                        {
                            <MudSelectItem Value="@unit.Id">@unit.Code - @unit.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_costPrice"
                                     Label="@Loc["CostPrice"]"
                                     Variant="Variant.Outlined"
                                     T="decimal"
                                     DecimalPlaces="2"
                                     Format="0.00" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_salePrice"
                                     Label="@Loc["SalePrice"]"
                                     Variant="Variant.Outlined"
                                     T="decimal"
                                     DecimalPlaces="2"
                                     Format="0.00" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_minStock"
                                     Label="@Loc["MinStockLevel"]"
                                     Variant="Variant.Outlined"
                                     T="decimal" DecimalPlaces="2" Format="0.00" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_maxStock"
                                     Label="@Loc["MaxStockLevel"]"
                                     Variant="Variant.Outlined"
                                     T="decimal" DecimalPlaces="2" Format="0.00" />
                </MudItem>

                <MudItem xs="12">
                    <MudSwitch @bind-Value="_tracksExpiry" Color="Color.Primary" Label="@Loc["TracksExpiry"]" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_description"
                                  Label="@Loc["Description"]"
                                  Lines="2"
                                  Variant="Variant.Outlined" />
                </MudItem>

                @* صورة الصنف (تُعرض في أزرار POS وبطاقة المادة) *@
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@Loc["ItemImage"]</MudText>
                    <div class="d-flex align-center" style="gap:12px;">
                        @if (!string.IsNullOrWhiteSpace(_imageUrl))
                        {
                            <img src="@_imageUrl" alt="@_nameAr"
                                 onerror="this.style.display='none'"
                                 style="width:72px;height:72px;object-fit:cover;border-radius:8px;border:1px solid #E5E7EB;" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Image" Color="Color.Default"
                                     Style="width:72px;height:72px;border:1px dashed #CBD5E1;border-radius:8px;display:flex;align-items:center;justify-content:center;" />
                        }
                        <div class="d-flex flex-column" style="gap:6px;">
                            <InputFile OnChange="OnImageSelected" Accept="image/*" />
                            <MudText Typo="Typo.caption" Style="color:var(--erp-muted)">@Loc["ItemImageHint"]</MudText>
                        </div>
                    </div>
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">
            @(EditItem is null ? Loc["Add"] : Loc["Edit"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IItemService ItemService { get; set; } = default!;
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public List<UnitDto> Units { get; set; } = new();
    [Parameter] public ItemDto? EditItem { get; set; }
[Parameter] public string? ExistingImageUrl { get; set; }

    private MudForm? _form;
    private string _code = string.Empty;
    private string _nameAr = string.Empty;
    private string? _nameEn;
    private Guid _categoryId;
    private Guid _unitId;
    private decimal _costPrice;
    private decimal _salePrice;
    private decimal _minStock;
    private decimal _maxStock;
    private string? _barcode;
    private string? _description;
    private bool _tracksExpiry;
    private string _imageUrl = string.Empty;
    private string? _error;

    protected override void OnInitialized()
    {
        if (EditItem is not null)
        {
            _code = EditItem.Code;
            _nameAr = EditItem.NameAr;
            _nameEn = EditItem.NameEn;
            _categoryId = EditItem.CategoryId;
            _unitId = EditItem.UnitId;
            _costPrice = EditItem.CostPrice;
            _salePrice = EditItem.SalePrice;
            _minStock = EditItem.MinStockLevel;
            _maxStock = EditItem.MaxStockLevel;
            _barcode = EditItem.Barcode;
            _description = EditItem.Description;
            _tracksExpiry = EditItem.TracksExpiry;
            _imageUrl = EditItem.ImageUrl ?? string.Empty;
        }
        else
        {
            _categoryId = Categories.FirstOrDefault()?.Id ?? Guid.Empty;
            _unitId = Units.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    /// <summary>يُحفظ الملف المختار على القرص باسم {ItemId}.jpg وينعش المعاينة فوراً.</summary>
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        if (EditItem is null)
        {
            _error = "احفظ الصنف أولاً ثم أضف الصورة";
            return;
        }
        var file = e.File;
        if (file is null || file.Size == 0) return;
        if (file.Size > 5 * 1024 * 1024)
        {
            _error = "الحد الأقصى لحجم الصورة 5MB";
            return;
        }
        try
        {
            var dir = Path.Combine(WebHostEnv.WebRootPath, "uploads", "items");
            Directory.CreateDirectory(dir);
            var path = Path.Combine(dir, EditItem.Id + ".jpg");
            await using (var fs = new FileStream(path, FileMode.Create))
            {
                await file.OpenReadStream(5 * 1024 * 1024).CopyToAsync(fs);
            }
            _imageUrl = $"/uploads/items/{EditItem.Id}.jpg";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            if (EditItem is null)
            {
                await ItemService.CreateAsync(new CreateItemDto
                {
                    Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    CategoryId = _categoryId, UnitId = _unitId,
                    CostPrice = _costPrice, SalePrice = _salePrice,
                    MinStockLevel = _minStock, MaxStockLevel = _maxStock,
                    Barcode = _barcode, Description = _description,
                    TracksExpiry = _tracksExpiry
                });
            }
            else
            {
                await ItemService.UpdateAsync(new UpdateItemDto
                {
                    Id = EditItem.Id, Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    CategoryId = _categoryId, UnitId = _unitId,
                    CostPrice = _costPrice, SalePrice = _salePrice,
                    MinStockLevel = _minStock, MaxStockLevel = _maxStock,
                    Barcode = _barcode, Description = _description,
                    IsActive = EditItem.IsActive,
                    TracksExpiry = _tracksExpiry
                });
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}