@* نموذج حوار لإضافة/تعديل صنف *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_code"
                                  Label="@Loc["ItemCode"]"
                                  Required="true"
                                  RequiredError="@Loc["ItemCodeRequired"]"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_barcode"
                                  Label="@Loc["Barcode"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_nameAr"
                                  Label="@Loc["ItemNameAr"]"
                                  Required="true"
                                  RequiredError="@Loc["NameArRequired"]"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_nameEn"
                                  Label="@Loc["ItemNameEn"]"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_categoryId"
                               Label="@Loc["Category"]"
                               Required="true"
                               RequiredError="@Loc["CategoryRequired"]"
                               Variant="Variant.Outlined"
                               T="Guid">
                        @foreach (var cat in Categories)
                        {
                            <MudSelectItem Value="@cat.Id">@cat.Code - @cat.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_unitId"
                               Label="@Loc["Unit"]"
                               Required="true"
                               RequiredError="@Loc["UnitRequired"]"
                               Variant="Variant.Outlined"
                               T="Guid">
                        @foreach (var unit in Units)
                        {
                            <MudSelectItem Value="@unit.Id">@unit.Code - @unit.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_costPrice"
                                     Label="@Loc["CostPrice"]"
                                     Variant="Variant.Outlined"
                                     T="decimal"
                                     DecimalPlaces="2"
                                     Format="0.00" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_salePrice"
                                     Label="@Loc["SalePrice"]"
                                     Variant="Variant.Outlined"
                                     T="decimal"
                                     DecimalPlaces="2"
                                     Format="0.00" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_minStock"
                                     Label="@Loc["MinStockLevel"]"
                                     Variant="Variant.Outlined"
                                     T="decimal" DecimalPlaces="2" Format="0.00" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField @bind-Value="_maxStock"
                                     Label="@Loc["MaxStockLevel"]"
                                     Variant="Variant.Outlined"
                                     T="decimal" DecimalPlaces="2" Format="0.00" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_description"
                                  Label="@Loc["Description"]"
                                  Lines="2"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">@Loc["Cancel"]</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">
            @(EditItem is null ? Loc["Add"] : Loc["Edit"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IItemService ItemService { get; set; } = default!;
    [Parameter] public List<CategoryDto> Categories { get; set; } = new();
    [Parameter] public List<UnitDto> Units { get; set; } = new();
    [Parameter] public ItemDto? EditItem { get; set; }

    private MudForm? _form;
    private string _code = string.Empty;
    private string _nameAr = string.Empty;
    private string? _nameEn;
    private Guid _categoryId;
    private Guid _unitId;
    private decimal _costPrice;
    private decimal _salePrice;
    private decimal _minStock;
    private decimal _maxStock;
    private string? _barcode;
    private string? _description;
    private string? _error;

    protected override void OnInitialized()
    {
        if (EditItem is not null)
        {
            _code = EditItem.Code;
            _nameAr = EditItem.NameAr;
            _nameEn = EditItem.NameEn;
            _categoryId = EditItem.CategoryId;
            _unitId = EditItem.UnitId;
            _costPrice = EditItem.CostPrice;
            _salePrice = EditItem.SalePrice;
            _minStock = EditItem.MinStockLevel;
            _maxStock = EditItem.MaxStockLevel;
            _barcode = EditItem.Barcode;
            _description = EditItem.Description;
        }
        else
        {
            _categoryId = Categories.FirstOrDefault()?.Id ?? Guid.Empty;
            _unitId = Units.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            if (EditItem is null)
            {
                await ItemService.CreateAsync(new CreateItemDto
                {
                    Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    CategoryId = _categoryId, UnitId = _unitId,
                    CostPrice = _costPrice, SalePrice = _salePrice,
                    MinStockLevel = _minStock, MaxStockLevel = _maxStock,
                    Barcode = _barcode, Description = _description
                });
            }
            else
            {
                await ItemService.UpdateAsync(new UpdateItemDto
                {
                    Id = EditItem.Id, Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    CategoryId = _categoryId, UnitId = _unitId,
                    CostPrice = _costPrice, SalePrice = _salePrice,
                    MinStockLevel = _minStock, MaxStockLevel = _maxStock,
                    Barcode = _barcode, Description = _description,
                    IsActive = EditItem.IsActive
                });
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}