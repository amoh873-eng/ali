@page "/inventory/movements"
@inject IStringLocalizer<SharedResources> Loc

@* صفحة حركات المخزون - سجل الحركات (وارد/صادر/تحويل/تسوية) بين المخازن *@

<PageTitle>حركات المخزون - نظام ERP</PageTitle>

<PageHeader Title="@Loc["Movements"]" Icon="@Icons.Material.Filled.SwapVert" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        إضافة حركة
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="Color.Secondary"
               StartIcon="@Icons.Material.Filled.SwapHoriz"
               OnClick="OpenTransferDialog"
               Class="ms-2">
        تحويل بين المخازن
    </MudButton>
    <MudSpacer />
    <MudText Class="align-self-center muted-text">إجمالي الحركات: @_movements.Count</MudText>
</MudToolBar>

<MudTabs Class="mb-4" Rounded="true" Outlined="true" Position="Position.Top">
    <MudTabPanel Text="سجل الحركات" Icon="@Icons.Material.Filled.ReceiptLong">
        <MudPaper Elevation="1" Class="mt-4">
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (_movements.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="m-4">
                    لا توجد حركات مخزون حتى الآن. اضغط "إضافة حركة" لبدء التسجيل.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_movements" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>التاريخ</MudTh>
                        <MudTh>المرجع</MudTh>
                        <MudTh>الصنف</MudTh>
                        <MudTh>المخزن</MudTh>
                        <MudTh>نوع الحركة</MudTh>
                        <MudTh>الكمية</MudTh>
                        <MudTh>تكلفة الوحدة</MudTh>
                        <MudTh>الإجمالي</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.MovementDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>@context.ReferenceNumber</MudTd>
                        <MudTd>@context.ItemCode - @context.ItemNameAr</MudTd>
                        <MudTd>@context.WarehouseNameAr</MudTd>
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context)">@context.MovementTypeNameAr</MudChip>
                        </MudTd>
                        <MudTd Class="@(context.Quantity >= 0 ? "stock-in" : "stock-out")">
                            @(context.Quantity >= 0 ? "+" : "")@context.Quantity.ToString("N0")
                        </MudTd>
                        <MudTd>@context.UnitCost.ToString("N2")</MudTd>
                        <MudTd>@context.Total.ToString("N2")</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="أرصدة المخزون" Icon="@Icons.Material.Filled.Storefront">
        <MudPaper Elevation="1" Class="mt-4">
            @if (_isLoading)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (_balances.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="m-4">
                    لا توجد أرصدة مخزون. قم بتسجيل حركة مخزون أولاً لبدء الأرصدة.
                </MudAlert>
            }
            else
            {
                <MudTable Items="_balances" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>الصنف</MudTh>
                        <MudTh>المخزن</MudTh>
                        <MudTh>الكمية</MudTh>
                        <MudTh>تكلفة الوحدة</MudTh>
                        <MudTh>قيمة المخزون</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.ItemCode - @context.ItemNameAr</MudTd>
                        <MudTd>@context.WarehouseNameAr</MudTd>
                        <MudTd Class="@(context.Quantity >= 0 ? "stock-in" : "stock-out")">
                            @context.Quantity.ToString("N0")
                        </MudTd>
                        <MudTd>@context.UnitCost.ToString("N2")</MudTd>
                        <MudTd>@context.TotalValue.ToString("N2")</MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
                    </PagerContent>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>
</MudTabs>

@code {
    private bool _isLoading = true;
    private List<StockMovementDto> _movements = new();
    private List<StockBalanceDto> _balances = new();

    [Inject] private IStockMovementService MovementService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _movements = await MovementService.GetMovementsAsync();
            _balances = await MovementService.GetStockBalancesAsync();
        }
        catch (Exception ex) { Snackbar.Add($"خطأ في تحميل الحركات: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private static Color GetTypeColor(StockMovementDto m) => m.Quantity >= 0
        ? Color.Success
        : Color.Error;

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["MovementService"] = MovementService };
        var dialog = await DialogService.ShowAsync<MovementFormDialog>(
            "إضافة حركة مخزون", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم تسجيل الحركة بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task OpenTransferDialog()
    {
        var parameters = new DialogParameters { ["MovementService"] = MovementService };
        var dialog = await DialogService.ShowAsync<TransferDialog>(
            "تحويل بين المخازن", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم تسجيل التحويل بنجاح", Severity.Success); await LoadAsync(); }
    }
}

