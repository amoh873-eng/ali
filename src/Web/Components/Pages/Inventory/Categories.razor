@page "/inventory/categories"
@attribute [Authorize(Roles = "Inventory")]
@inject IStringLocalizer<SharedResources> Loc

@* صفحة فئات الأصناف - شجرة فئات الأصناف (فئة رئيسية ← فئة فرعية) *@

<PageTitle>@Loc["Categories"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["Categories"]" Icon="@Icons.Material.Filled.Category" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => OpenCreateDialog()">
        @Loc["AddCategory"]
    </MudButton>
    <MudSpacer />
    <MudText Class="align-self-center muted-text">@Loc["CategoriesCount", _flatCategories.Count]</MudText>
</MudToolBar>

<MudPaper Elevation="1" Class="pa-4">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_treeCategories.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="my-2">
            @Loc["NoCategories"]
        </MudAlert>
    }
    else
    {
        @RenderTreeNodes(_treeCategories)
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<CategoryDto> _treeCategories = new();
    private List<CategoryDto> _flatCategories = new();

    [Inject] private ICategoryService CategoryService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _treeCategories = await CategoryService.GetTreeAsync();
            _flatCategories = await CategoryService.GetAllAsync();
        }
        catch (Exception ex) { Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private RenderFragment RenderTreeNodes(List<CategoryDto> categories) => builder =>
    {
        foreach (var category in categories)
        {
            builder.OpenComponent<MudTreeViewItem<CategoryDto>>(0);
            builder.AddAttribute(1, "Value", category);
            builder.AddAttribute(2, "Text", $"{category.Code} - {category.NameAr}");
            builder.AddAttribute(3, "Icon", category.Children.Count > 0
                ? Icons.Material.Filled.Folder
                : Icons.Material.Filled.Description);
            builder.AddAttribute(4, "ChildContent", (RenderFragment)(childBuilder =>
            {
                childBuilder.OpenComponent<MudIconButton>(0);
                childBuilder.AddAttribute(1, "Icon", Icons.Material.Filled.Add);
                childBuilder.AddAttribute(2, "Size", Size.Small);
                childBuilder.AddAttribute(3, "Color", Color.Success);
                childBuilder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => OpenCreateDialog(category)));
                childBuilder.AddAttribute(5, "ClickPropagation", false);
                childBuilder.CloseComponent();

                childBuilder.OpenComponent<MudIconButton>(0);
                childBuilder.AddAttribute(1, "Icon", Icons.Material.Filled.Edit);
                childBuilder.AddAttribute(2, "Size", Size.Small);
                childBuilder.AddAttribute(3, "Color", Color.Primary);
                childBuilder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => OpenEditDialog(category)));
                childBuilder.AddAttribute(5, "ClickPropagation", false);
                childBuilder.CloseComponent();

                childBuilder.OpenComponent<MudIconButton>(0);
                childBuilder.AddAttribute(1, "Icon", Icons.Material.Filled.Delete);
                childBuilder.AddAttribute(2, "Size", Size.Small);
                childBuilder.AddAttribute(3, "Color", Color.Error);
                childBuilder.AddAttribute(4, "OnClick", EventCallback.Factory.Create<MouseEventArgs>(this, (e) => DeleteCategory(category)));
                childBuilder.AddAttribute(5, "ClickPropagation", false);
                childBuilder.AddAttribute(6, "Disabled", category.IsSystem);
                childBuilder.CloseComponent();

                if (category.Children.Count > 0)
                {
                    childBuilder.AddContent(13, RenderTreeNodes(category.Children));
                }
            }));
            builder.CloseComponent();
        }
    };

    private async Task OpenCreateDialog(CategoryDto? parent = null)
    {
        var parameters = new DialogParameters
        {
            ["CategoryService"] = CategoryService,
            ["ParentCategories"] = _flatCategories,
            ["DefaultParentId"] = parent?.Id
        };
        var dialog = await DialogService.ShowAsync<CategoryFormDialog>(
            Loc["AddCategory"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["ItemCategorySaved"], Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(CategoryDto category)
    {
        if (category.IsSystem) { Snackbar.Add(Loc["SystemCategoryEditWarning"], Severity.Warning); return; }
        var parameters = new DialogParameters
        {
            ["CategoryService"] = CategoryService,
            ["ParentCategories"] = _flatCategories,
            ["EditCategory"] = category
        };
        var dialog = await DialogService.ShowAsync<CategoryFormDialog>(
            Loc["EditCategoryTitle", category.NameAr], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["ItemCategoryUpdated"], Severity.Success); await LoadAsync(); }
    }

    private async Task DeleteCategory(CategoryDto category)
    {
        if (category.IsSystem) { Snackbar.Add(Loc["SystemCategoryDeleteWarning"], Severity.Warning); return; }
        var confirmed = await DialogService.ShowMessageBox(
            Loc["DeleteConfirmation"], Loc["DeleteCategoryConfirm", category.NameAr],
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;
        try { await CategoryService.DeleteAsync(category.Id); Snackbar.Add(Loc["ItemCategoryDeleted"], Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

