@* نموذج حوار لإنشاء جرد دوري: اختيار مخزن ثم إدخال الكميات المعدودة *@
@inject IStringLocalizer<SharedResources> Loc

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" Value="_warehouseId" ValueChanged="OnWarehouseChanged"
                               Label="@Loc["Warehouse"]" Required="true" RequiredError="@Loc["WarehouseRequired"]"
                               Variant="Variant.Outlined">
                        @foreach (var w in _warehouses)
                        {
                            <MudSelectItem T="Guid" Value="@w.Id">@w.Code - @w.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_countDate" Label="@Loc["CountDate"]"
                                   Variant="Variant.Outlined" T="DateTime?" AutoClose="true" />
                </MudItem>
            </MudGrid>

            @if (_isLoadingItems)
            {
                <MudProgressLinear Indeterminate="true" Class="my-4" />
            }
            else if (_lines.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="mt-4">@Loc["SelectWarehouseHint"]</MudAlert>
            }
            else
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4">
                    @Loc["EnterCountedQuantities"]
                </MudText>
                <MudTable Items="_lines" Hover="true" Dense="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>@Loc["Code"]</MudTh>
                        <MudTh>@Loc["Item"]</MudTh>
                        <MudTh>@Loc["SystemStock"]</MudTh>
                        <MudTh>@Loc["CountedQuantity"]</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Code</MudTd>
                        <MudTd>@context.NameAr</MudTd>
                        <MudTd>@context.SystemQty.ToString("N0")</MudTd>
                        <MudTd>
                            <MudNumericField T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="context.CountedQty"
                                             Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudTd>
                    </RowTemplate>
                    <PagerContent>
                        <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
                    </PagerContent>
                </MudTable>
            }

            <MudTextField @bind-Value="_note" Label="@Loc["Notes"]" Variant="Variant.Outlined" Lines="2" Class="mt-4" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync">@Loc["PostStockCount"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Inject] private IStockCountService CountService { get; set; } = default!;
    [Inject] private IWarehouseService WarehouseService { get; set; } = default!;
    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private IStockMovementService MovementService { get; set; } = default!;
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private class LineEditor
    {
        public Guid ItemId { get; set; }
        public string Code { get; set; } = "";
        public string NameAr { get; set; } = "";
        public decimal SystemQty { get; set; }
        public decimal CountedQty { get; set; }
    }

    private MudForm? _form;
    private List<WarehouseDto> _warehouses = new();
    private List<ItemDto> _items = new();
    private List<LineEditor> _lines = new();
    private bool _isLoadingItems;

    private Guid _warehouseId;
    private DateTime? _countDate = DateTime.Today;
    private string? _note;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _warehouses = await WarehouseService.GetAllAsync();
        _items = await ItemService.GetAllAsync();
        _warehouseId = _warehouses.FirstOrDefault(w => w.IsDefault)?.Id
                       ?? _warehouses.FirstOrDefault()?.Id
                       ?? Guid.Empty;
        await LoadLinesAsync();
    }

    private async Task OnWarehouseChanged(Guid id)
    {
        _warehouseId = id;
        await LoadLinesAsync();
    }

    private async Task LoadLinesAsync()
    {
        _isLoadingItems = true;
        try
        {
            var balances = await MovementService.GetStockBalancesAsync();
            var balDict = balances
                .Where(b => b.WarehouseId == _warehouseId)
                .GroupBy(b => b.ItemId)
                .ToDictionary(g => g.Key, g => g.Sum(x => x.Quantity));

            _lines = _items
                .Where(i => i.IsActive)
                .OrderBy(i => i.Code)
                .Select(i => new LineEditor
                {
                    ItemId = i.Id,
                    Code = i.Code,
                    NameAr = i.NameAr,
                    SystemQty = balDict.GetValueOrDefault(i.Id, 0m),
                    CountedQty = balDict.GetValueOrDefault(i.Id, 0m)
                })
                .ToList();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _isLoadingItems = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            await CountService.CreateAsync(new CreateStockCountDto
            {
                WarehouseId = _warehouseId,
                CountDate = _countDate ?? DateTime.Today,
                Note = _note,
                Lines = _lines.Select(l => new StockCountLineInput
                {
                    ItemId = l.ItemId,
                    CountedQuantity = l.CountedQty
                }).ToList()
            });
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { _error = ex.Message; }
    }
}