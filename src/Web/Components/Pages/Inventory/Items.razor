@page "/inventory/items"
@attribute [Authorize(Roles = "Inventory")]
<ModuleGuard ModuleKey="Inventory">
@inject IStringLocalizer<SharedResources> Loc

@* ØµÙØ­Ø© Ø§Ù„Ø£ØµÙ†Ø§Ù ÙˆØ§Ù„Ù…Ø®Ø²ÙˆÙ† - Ø¥Ø¯Ø§Ø±Ø© Ø§Ù„Ø£ØµÙ†Ø§Ù Ù…Ø¹ Ù…Ø³ØªÙˆÙŠØ§Øª Ø§Ù„Ù…Ø®Ø²ÙˆÙ† ÙˆØ§Ù„ØªØ³Ø¹ÙŠØ± *@

<PageTitle>@Loc["Items"] - @Loc["AppName"]</PageTitle>

<PageHeader Title="@Loc["Items"]" Icon="@Icons.Material.Filled.Inventory" />

<MudToolBar Class="mb-4">
    <MudTextField @bind-Value="_search"
                  Placeholder="@Loc["SearchItems"]"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1" />
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        @Loc["AddItem"]
    </MudButton>
</MudToolBar>

@if (_lowStockCount > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Filled">
        @Loc["ItemsLowStock", _lowStockCount]
    </MudAlert>
}

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            @Loc["NoItemsHint"]
        </MudAlert>
    }
    else
    {
        <MudTable Items="_filteredItems" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>@Loc["Code"]</MudTh>
                <MudTh>@Loc["ItemName"]</MudTh>
                <MudTh>@Loc["Category"]</MudTh>
                <MudTh>@Loc["Unit"]</MudTh>
                <MudTh>@Loc["Cost"]</MudTh>
                <MudTh>@Loc["Price"]</MudTh>
                <MudTh>@Loc["Balance"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh>@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.CategoryNameAr</MudTd>
                <MudTd>@context.UnitNameAr</MudTd>
                <MudTd>@context.CostPrice.ToString("N2")</MudTd>
                <MudTd>@context.SalePrice.ToString("N2")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small"
                             Variant="Variant.Filled"
                             Color="@(context.CurrentStock <= context.MinStockLevel ? Color.Warning : Color.Success)">
                        @context.CurrentStock.ToString("N0")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? Loc["Active"] : Loc["Inactive"])
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(e => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteItem(context))"
                                   Disabled="context.IsSystem" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="@Loc["PagerInfo"]" RowsPerPageString="@Loc["RowsPerPage"]" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<ItemDto> _items = new();
    private string _search = string.Empty;

    private IEnumerable<ItemDto> _filteredItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(i =>
                i.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || i.NameAr.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (i.Barcode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    private int _lowStockCount;
    private List<CategoryDto> _categoriesCache = new();
    private List<UnitDto> _unitsCache = new();

    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private ICategoryService CategoryService { get; set; } = default!;
    [Inject] private IUnitService UnitService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _items = await ItemService.GetAllAsync();
            _categoriesCache = await CategoryService.GetAllAsync();
            _unitsCache = await UnitService.GetAllAsync();
            _lowStockCount = _items.Count(i => i.CurrentStock <= i.MinStockLevel);
        }
        catch (Exception ex) { Snackbar.Add($"{Loc["LoadError"]} {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["ItemService"] = ItemService,
            ["Categories"] = _categoriesCache,
            ["Units"] = _unitsCache
        };
        var dialog = await DialogService.ShowAsync<ItemFormDialog>(
            Loc["AddItemTitle"], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["ItemSaved"], Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(ItemDto item)
    {
        var parameters = new DialogParameters
        {
            ["ItemService"] = ItemService,
            ["Categories"] = _categoriesCache,
            ["Units"] = _unitsCache,
            ["EditItem"] = item
        };
        var dialog = await DialogService.ShowAsync<ItemFormDialog>(
            Loc["EditItemTitle", item.NameAr], parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add(Loc["ItemUpdated"], Severity.Success); await LoadAsync(); }
    }

    private async Task DeleteItem(ItemDto item)
    {
        if (item.IsSystem) { Snackbar.Add(Loc["SystemItemDeleteWarning"], Severity.Warning); return; }
        var confirmed = await DialogService.ShowMessageBox(
            Loc["DeleteConfirmation"], Loc["DeleteItemConfirm", item.NameAr],
            yesText: Loc["Delete"], cancelText: Loc["Cancel"]);
        if (confirmed != true) return;
        try { await ItemService.DeleteAsync(item.Id); Snackbar.Add(Loc["ItemDeleted"], Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

</ModuleGuard>
