@page "/inventory/items"
@inject IStringLocalizer<SharedResources> Loc

@* صفحة الأصناف والمخزون - إدارة الأصناف مع مستويات المخزون والتسعير *@

<PageTitle>الأصناف - نظام ERP</PageTitle>

<PageHeader Title="@Loc["Items"]" Icon="@Icons.Material.Filled.Inventory" />

<MudToolBar Class="mb-4">
    <MudTextField @bind-Value="_search"
                  Placeholder="ابحث بالكود أو الاسم أو الباركود..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1" />
    <MudSpacer />
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        إضافة صنف
    </MudButton>
</MudToolBar>

@if (_lowStockCount > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Variant="Variant.Filled">
        يوجد @_lowStockCount صنف تحت الحد الأدنى للمخزون الحالي.
    </MudAlert>
}

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_items.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            لا توجد أصناف. اضغط "إضافة صنف" لإنشاء أول صنف.
        </MudAlert>
    }
    else
    {
        <MudTable Items="_filteredItems" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>الكود</MudTh>
                <MudTh>اسم الصنف</MudTh>
                <MudTh>الفئة</MudTh>
                <MudTh>الوحدة</MudTh>
                <MudTh>تكلفة</MudTh>
                <MudTh>سعر</MudTh>
                <MudTh>الرصيد</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>إجراءات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.CategoryNameAr</MudTd>
                <MudTd>@context.UnitNameAr</MudTd>
                <MudTd>@context.CostPrice.ToString("N2")</MudTd>
                <MudTd>@context.SalePrice.ToString("N2")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small"
                             Variant="Variant.Filled"
                             Color="@(context.CurrentStock <= context.MinStockLevel ? Color.Warning : Color.Success)">
                        @context.CurrentStock.ToString("N0")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "نشط" : "غير نشط")
                    </MudChip>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(e => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteItem(context))"
                                   Disabled="context.IsSystem" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<ItemDto> _items = new();
    private string _search = string.Empty;

    private IEnumerable<ItemDto> _filteredItems =>
        string.IsNullOrWhiteSpace(_search)
            ? _items
            : _items.Where(i =>
                i.Code.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || i.NameAr.Contains(_search, StringComparison.OrdinalIgnoreCase)
                || (i.Barcode?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

    private int _lowStockCount;
    private List<CategoryDto> _categoriesCache = new();
    private List<UnitDto> _unitsCache = new();

    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private ICategoryService CategoryService { get; set; } = default!;
    [Inject] private IUnitService UnitService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _items = await ItemService.GetAllAsync();
            _categoriesCache = await CategoryService.GetAllAsync();
            _unitsCache = await UnitService.GetAllAsync();
            _lowStockCount = _items.Count(i => i.CurrentStock <= i.MinStockLevel);
        }
        catch (Exception ex) { Snackbar.Add($"خطأ في تحميل الأصناف: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["ItemService"] = ItemService,
            ["Categories"] = _categoriesCache,
            ["Units"] = _unitsCache
        };
        var dialog = await DialogService.ShowAsync<ItemFormDialog>(
            "إضافة صنف جديد", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم حفظ الصنف بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(ItemDto item)
    {
        var parameters = new DialogParameters
        {
            ["ItemService"] = ItemService,
            ["Categories"] = _categoriesCache,
            ["Units"] = _unitsCache,
            ["EditItem"] = item
        };
        var dialog = await DialogService.ShowAsync<ItemFormDialog>(
            $"تعديل صنف: {item.NameAr}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم تعديل الصنف بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task DeleteItem(ItemDto item)
    {
        if (item.IsSystem) { Snackbar.Add("لا يمكن حذف الأصناف النظامية", Severity.Warning); return; }
        var confirmed = await DialogService.ShowMessageBox(
            "تأكيد الحذف", $"هل أنت متأكد من حذف الصنف '{item.NameAr}'؟",
            yesText: "حذف", cancelText: "إلغاء");
        if (confirmed != true) return;
        try { await ItemService.DeleteAsync(item.Id); Snackbar.Add("تم حذف الصنف بنجاح", Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

