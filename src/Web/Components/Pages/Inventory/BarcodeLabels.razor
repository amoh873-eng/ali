@page "/inventory/barcode-labels"
@attribute [Authorize(Roles = "Admin,SuperAdmin")]
<ModuleGuard ModuleKey="Inventory">
@inject IItemService ItemService
@inject ICategoryService CategoryService
@inject IStringLocalizer<SharedResources> Loc
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>@Loc["BarcodeLabels"] - @Loc["AppName"]</PageTitle>
<PageHeader Title="@Loc["BarcodeLabels"]" Icon="@Icons.Material.Filled.QrCode2" />

<div class="bl-wrap">
    <MudPaper Elevation="0" Outlined="true" Class="bl-card">
        <div class="bl-head">
            <div>
                <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@Loc["BlSelectItems"]</MudText>
                <MudText Typo="Typo.body2" Class="bl-muted">@Loc["BlSelectHint"]</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="bl-muted">@Loc["BlSelectedCount", _selected.Count]</MudText>
        </div>
        <div class="bl-toolbar">
            <MudTextField @bind-Value="_search" T="string" Placeholder="@Loc["BlSearchPlaceholder"]"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                          Dense="true" Variant="Variant.Outlined" Class="bl-search" />
            <MudSelect T="Guid" @bind-Value="_categoryFilter" Label="@Loc["Category"]"
                        Dense="true" Variant="Variant.Outlined" Class="bl-cat">
                <MudSelectItem Value="@(Guid.Empty)">@Loc["All"]</MudSelectItem>
                @foreach (var c in _categories)
                {
                    <MudSelectItem Value="@c.Id">@c.NameAr</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Checklist"
                        OnClick="SelectCategoryFiltered">@Loc["BlSelectCategory"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ImportExport"
                        OnClick="SelectLastBulkImport" Disabled="@(_lastBulkItemCount == 0)">@Loc["BlSelectBulk", _lastBulkItemCount]</MudButton>
            <MudSpacer />
            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="ClearSelection">@Loc["BlClear"]</MudButton>
        </div>
        @if (_items.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-3">@Loc["NoItemsHint"]</MudAlert>
        }
        else
        {
            <MudTable Items="_filteredItems" Dense="true" Hover="true" Class="mt-3 bl-table">
                <HeaderContent>
                    <MudTh>@Loc["BlSelected"]</MudTh>
                    <MudTh>@Loc["Code"]</MudTh>
                    <MudTh>@Loc["ItemName"]</MudTh>
                    <MudTh>@Loc["Barcode"]</MudTh>
                    <MudTh>@Loc["Price"]</MudTh>
                    <MudTh>@Loc["BlCopies"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudCheckBox T="bool" Value="IsSelected(context.Id)" ValueChanged="(bool v) => ToggleSelection(context.Id, v)" />
                    </MudTd>
                    <MudTd>@context.Code</MudTd>
                    <MudTd>@context.NameAr</MudTd>
                    <MudTd dir="ltr">@context.Barcode</MudTd>
                    <MudTd><MoneyDisplay Amount="context.SalePrice" /></MudTd>
                    <MudTd Style="width:110px;">
                        <MudNumericField T="int" Value="GetCopies(context.Id)"
                                         ValueChanged="(int v) => SetCopies(context.Id, v)"
                                         Min="1" Max="999" Dense="true" Variant="Variant.Outlined" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
    <MudPaper Elevation="0" Outlined="true" Class="bl-card">
        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@Loc["BlOptions"]</MudText>
        <div class="bl-options">
            <MudSwitch T="bool" @bind-Value="_sameCopies" Color="Color.Primary">@Loc["BlSameCopies"]</MudSwitch>
            @if (_sameCopies)
            {
                <MudNumericField T="int" @bind-Value="_globalCopies" Label="@Loc["BlCopies"]"
                                 Min="1" Max="999" Dense="true" Style="width:140px;" />
            }
            <MudSwitch T="bool" @bind-Value="_showPrice" Color="Color.Primary">@Loc["BlShowPrice"]</MudSwitch>
        </div>
        <MudText Typo="Typo.body2" Class="bl-muted">@Loc["BlTemplateInfo"]</MudText>
    </MudPaper>

    @if (_selected.Count > 0)
    {
        <div class="bl-actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.Pageview"
                        Disabled="@_busy" OnClick="PreviewFirstPageAsync">@Loc["BlPreview"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download"
                        Disabled="@_busy" OnClick="GenerateAndDownloadAsync">@Loc["BlGenerate"]</MudButton>
        </div>
    }

    @if (_busy)
    {
        <MudPaper Elevation="0" Outlined="true" Class="bl-card bl-busy">
            <MudText Align="Align.Center" Class="pb-2">@Loc["BlGenerating"]</MudText>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        </MudPaper>
    }

    @if (!string.IsNullOrWhiteSpace(_previewTitle))
    {
        <MudPaper Elevation="0" Outlined="true" Class="bl-card">
            <MudText Typo="Typo.subtitle1" Style="font-weight:700;">@_previewTitle</MudText>
            <iframe id="erpLabelPreview" title="@Loc["BlPreview"]"
                    style="border:none;width:100%;height:480px;background:#fff;"></iframe>
        </MudPaper>
    }
</div>
</ModuleGuard>
@code {
    private List<ERPSystem.Application.DTOs.Items.ItemDto> _items = new();
    private List<CategoryDto> _categories = new();
    private string _search = string.Empty;
    private Guid _categoryFilter = Guid.Empty;
    private HashSet<Guid> _selected = new();
    private Dictionary<Guid, int> _copies = new();
    private bool _sameCopies;
    private int _globalCopies = 1;
    private bool _showPrice;
    private bool _busy;
    private string _previewTitle = string.Empty;
    private int _lastBulkItemCount;


    protected override async Task OnInitializedAsync()
    {
        try
        {
            _categories = await CategoryService.GetAllAsync();
            _items = await ItemService.GetAllAsync();
            var last = await ItemService.GetItemsFromLastBulkImportAsync();
            _lastBulkItemCount = last.Count;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private IEnumerable<ERPSystem.Application.DTOs.Items.ItemDto> _filteredItems
    {
        get
        {
            IEnumerable<ERPSystem.Application.DTOs.Items.ItemDto> q = _items;
            if (_categoryFilter != Guid.Empty) q = q.Where(x => x.CategoryId == _categoryFilter);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                var t = _search.Trim();
                q = q.Where(x =>
                    x.NameAr.Contains(t, StringComparison.OrdinalIgnoreCase)
                    || (x.NameEn?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false)
                    || x.Code.Contains(t, StringComparison.OrdinalIgnoreCase)
                    || (x.Barcode?.Contains(t, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return q;
        }
    }

    private bool IsSelected(Guid id) => _selected.Contains(id);
    private void ToggleSelection(Guid id, bool on) { if (on) _selected.Add(id); else _selected.Remove(id); }

    private int GetCopies(Guid id) => _copies.TryGetValue(id, out var c) ? c : 1;
    private void SetCopies(Guid id, int v) => _copies[id] = Math.Max(1, v);

    private void SelectCategoryFiltered()
    {
        var ids = _categoryFilter != Guid.Empty
            ? _items.Where(i => i.CategoryId == _categoryFilter).Select(i => i.Id)
            : _items.Select(i => i.Id);
        foreach (var id in ids) _selected.Add(id);
    }

    private void SelectLastBulkImport() => _ = LoadLastBulkSelectionAsync();

    private async Task LoadLastBulkSelectionAsync()
    {
        var last = await ItemService.GetItemsFromLastBulkImportAsync();
        foreach (var i in last) _selected.Add(i.Id);
        _lastBulkItemCount = last.Count;
        StateHasChanged();
    }

    private void ClearSelection() { _selected.Clear(); _copies.Clear(); }

    private List<ERPSystem.Application.DTOs.Items.BarcodeLabelItemDto> BuildFlattened(int take)
    {
        var list = new List<ERPSystem.Application.DTOs.Items.BarcodeLabelItemDto>();
        foreach (var i in _items.Where(x => _selected.Contains(x.Id)).OrderBy(x => x.Code))
        {
            var copies = _sameCopies ? Math.Max(1, _globalCopies) : GetCopies(i.Id);
            for (var k = 0; k < copies; k++)
            {
                if (list.Count >= take) return list;
                list.Add(new ERPSystem.Application.DTOs.Items.BarcodeLabelItemDto
                {
                    Id = i.Id,
                    Code = i.Code,
                    NameAr = i.NameAr,
                    Barcode = i.Barcode,
                    SalePrice = i.SalePrice
                });
            }
        }
        return list;
    }
    private async Task PreviewFirstPageAsync()
    {
        var items = BuildFlattened(24);
        if (items.Count == 0) { Snackbar.Add(Loc["BlNoSelection"], Severity.Warning); return; }
        _busy = true; _previewTitle = ""; StateHasChanged();
        try
        {
            var bytes = await Task.Run(() => BarcodeLabelExporter.Generate(items, _showPrice, 1));
            _previewTitle = Loc["BlPreviewTitle", items.Count];
            await ShowPdfInFrameAsync(bytes);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task GenerateAndDownloadAsync()
    {
        var items = BuildFlattened(int.MaxValue);
        if (items.Count == 0) { Snackbar.Add(Loc["BlNoSelection"], Severity.Warning); return; }
        _busy = true; StateHasChanged();
        try
        {
            var bytes = await Task.Run(() => BarcodeLabelExporter.Generate(items, _showPrice, 1));
            var b64 = Convert.ToBase64String(bytes);
            await JS.InvokeVoidAsync("eval",
                "var a=document.createElement('a');a.href='data:application/pdf;base64," + b64 + "';a.download='barcode-labels.pdf';a.click();");
            Snackbar.Add(Loc["BlDone", items.Count], Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; StateHasChanged(); }
    }

    private async Task ShowPdfInFrameAsync(byte[] pdfBytes)
    {
        var b64 = Convert.ToBase64String(pdfBytes);
        var js = "var bytes=Uint8Array.from(atob('" + b64 + "'),function(c){return c.charCodeAt(0);});" +
                 "var blob=new Blob([bytes],{type:'application/pdf'});var url=URL.createObjectURL(blob);" +
                 "var cont=document.querySelector('.bl-wrap');var el=document.getElementById('erpLabelPreview');" +
                 "if(!el&&cont){el=document.createElement('iframe');el.id='erpLabelPreview';" +
                 "el.style.cssText='border:none;width:100%;height:480px;background:#fff;';cont.appendChild(el);}" +
                 "if(el){el.src=url;}";
        await JS.InvokeVoidAsync("eval", js);
    }
}
