@using System.Globalization
@using Microsoft.AspNetCore.Components.Web
@* ───────────────────────────────────────────────────────────────────────
   DonutChart3D.razor — رسم دائري ثلاثي الأبعاد (3D Donut) بتقنية SVG خالصة.
   الرسم يُبنى كسلسلة MarkupString في الكود الخلفي لتجنّب تعارض Razor مع
   عنصر <text> في SVG (RZ1023). القرص الخلفي المزاح لأسفل يعطي سُمك 3D،
   والنسب تظهر داخل القطع، وخطوط التسمية خارج القرص.
   ─────────────────────────────────────────────────────────────────────── *@

<div class="erp-donut3d">
    @if (Segments.Count > 0)
    {
        <div class="erp-donut3d-svg-wrap">
            @((MarkupString)_svgMarkup)
        </div>

        @if (ShowLegend)
        {
            <div class="erp-donut3d-legend">
                @foreach (var seg in Segments)
                {
                    var pct = _total > 0 ? seg.Value / _total * 100.0 : 0;
                    <div class="erp-donut3d-legend-item">
                        <div class="erp-donut3d-legend-row">
                            <span class="erp-donut3d-dot" style="background:@seg.Color;"></span>
                            <span class="erp-donut3d-label">@seg.Label</span>
                            <span class="erp-donut3d-value">@seg.ValueText</span>
                            <span class="erp-donut3d-pct">@pct.ToString("0", CultureInfo.InvariantCulture)%</span>
                        </div>
                        <div class="erp-donut3d-track">
                            <div class="erp-donut3d-fill" style="width:@(pct.ToString("0.##", CultureInfo.InvariantCulture))%; background:@seg.Color;"></div>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <MudText Typo="Typo.body2" Style="color:var(--erp-muted); padding:16px 0;">@EmptyText</MudText>
    }
</div>

@code {
    [Parameter] public List<DonutSegment> Segments { get; set; } = new();
    [Parameter] public bool ShowLegend { get; set; } = true;
    [Parameter] public bool ShowCallouts { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "3D Pie Chart";
    [Parameter] public string EmptyText { get; set; } = "";

    private double _total => Segments.Sum(s => s.Value);
    private string _svgMarkup = "";
    private string _ariaEscaped = "";

    // ── هندسة الرسم: مركز، أنصاف أقطار، سُمك 3D ──
    private const double Cx = 150;
    private const double Cy = 130;
    private const double OuterR = 82;
    private const double InnerR = 48;
    private const double Depth = 14;

    protected override void OnParametersSet()
    {
        // تهريب أي تسميات إلى قيمة آمنة لعرضها داخل النص — عربية/إنجليزية/أرقام.
        _ariaEscaped = System.Net.WebUtility.HtmlEncode(AriaLabel);

        var sb = new System.Text.StringBuilder(4000);
        if (Segments.Count == 0 || _total <= 0) { _svgMarkup = ""; return; }

        sb.Append("<svg class=\"erp-donut3d-svg\" viewBox=\"0 0 300 240\" role=\"img\" aria-label=\"")
          .Append(_ariaEscaped).Append("\">");

        var start = -90.0; // تبدأ القطعة الأولى من الأعلى (12 ساعة) باتجاه عقارب الساعة
        foreach (var seg in Segments)
        {
            var pct = seg.Value / _total * 100.0;
            var sweep = pct / 100.0 * 360.0;
            if (sweep <= 0.001) { start += sweep; continue; }
            var end = start + sweep;
            var midDeg = start + sweep / 2;
            var midRad = midDeg * Math.PI / 180.0;

            // منتصف القطعة (لعرض النسبة)
            var midR = (OuterR + InnerR) / 2;
            var midX = Cx + midR * Math.Cos(midRad);
            var midY = Cy + midR * Math.Sin(midRad);

            // نقطتا بداية/نهاية خط التسمية الخارجي + موضع النص
            var cx1 = Cx + OuterR * Math.Cos(midRad);
            var cy1 = Cy + OuterR * Math.Sin(midRad);
            var cx2 = Cx + (OuterR + 18) * Math.Cos(midRad);
            var cy2 = Cy + (OuterR + 18) * Math.Sin(midRad);
            var tx = Cx + (OuterR + 40) * Math.Cos(midRad);
            var ty = Cy + (OuterR + 40) * Math.Sin(midRad) - 4;

            var label = System.Net.WebUtility.HtmlEncode(seg.Label);
            var color = SanitizeColor(seg.Color);
            var backColor = Shade(color, 0.6);

            // القرص الخلفي المزاح (سُمك 3D)
            sb.Append("<path d=\"").Append(SlicePath(start, end, Depth))
              .Append("\" fill=\"").Append(backColor).Append("\" />");

            // القرص الأمامي
            sb.Append("<path d=\"").Append(SlicePath(start, end, 0))
              .Append("\" fill=\"").Append(color).Append("\"><title>")
              .Append(label).Append(" — ")
              .Append(pct.ToString("0", CultureInfo.InvariantCulture)).Append("%</title></path>");

            // النسبة داخل القطعة (تُعرض فقط إن كانت كبيرة كفاية)
            if (pct >= 4)
            {
                sb.Append("<text x=\"").Append(F(midX)).Append("\" y=\"").Append(F(midY))
                  .Append("\" class=\"erp-donut3d-pct\" dominant-baseline=\"central\" text-anchor=\"middle\">")
                  .Append(pct.ToString("0", CultureInfo.InvariantCulture)).Append("%</text>");
            }

            // خط التسمية + النص خارج القرص (اختياري)
            if (ShowCallouts)
            {
                sb.Append("<line x1=\"").Append(F(cx1)).Append("\" y1=\"").Append(F(cy1))
                  .Append("\" x2=\"").Append(F(cx2)).Append("\" y2=\"").Append(F(cy2))
                  .Append("\" class=\"erp-donut3d-line\" />");
                sb.Append("<text x=\"").Append(F(tx)).Append("\" y=\"").Append(F(ty))
                  .Append("\" class=\"erp-donut3d-callout\" text-anchor=\"middle\">")
                  .Append(label).Append("</text>");
            }

            start = end;
        }

        sb.Append("</svg>");
        _svgMarkup = sb.ToString();
    }

    /// <summary>بناء مسار حلقي (donut slice) بين زاويتين مع إزاحة رأسية dy للقرص الخلفي.</summary>
    private static string SlicePath(double startDeg, double endDeg, double dy)
    {
        var large = (endDeg - startDeg) > 180 ? 1 : 0;
        var (o0x, o0y) = Pt(OuterR, startDeg);
        var (o1x, o1y) = Pt(OuterR, endDeg);
        var (i0x, i0y) = Pt(InnerR, startDeg);
        var (i1x, i1y) = Pt(InnerR, endDeg);

        return "M " + F(o0x) + " " + F(o0y + dy) +
               " A " + F(OuterR) + " " + F(OuterR) + " 0 " + large + " 1 " + F(o1x) + " " + F(o1y + dy) +
               " L " + F(i1x) + " " + F(i1y + dy) +
               " A " + F(InnerR) + " " + F(InnerR) + " 0 " + large + " 0 " + F(i0x) + " " + F(i0y + dy) + " Z";
    }

    private static (double X, double Y) Pt(double r, double deg)
    {
        var rad = deg * Math.PI / 180.0;
        return (Cx + r * Math.Cos(rad), Cy + r * Math.Sin(rad));
    }

    private static string F(double v) => v.ToString("0.##", CultureInfo.InvariantCulture);

    /// <summary>تظليل لون سداسي عشري بمعامل (0..1) لإنشاء لون الحافة السفلية 3D.</summary>
    private static string Shade(string hex, double factor)
    {
        try
        {
            var h = hex.TrimStart('#');
            if (h.Length == 3) h = string.Concat(h.Select(c => "" + c + c));
            var r = (int)Math.Round(Convert.ToInt32(h.Substring(0, 2), 16) * factor);
            var g = (int)Math.Round(Convert.ToInt32(h.Substring(2, 2), 16) * factor);
            var b = (int)Math.Round(Convert.ToInt32(h.Substring(4, 2), 16) * factor);
            return $"#{r:X2}{g:X2}{b:X2}";
        }
        catch { return hex; }
    }

    /// <summary>يمنع حقن قيم ألوان غير متوقعة — يقبل فقط #RGB/#RRGGBB.</summary>
    private static string SanitizeColor(string hex)
    {
        if (!string.IsNullOrWhiteSpace(hex) && System.Text.RegularExpressions.Regex.IsMatch(hex.Trim(), "^#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?$"))
            return hex.Trim();
        return "#6D5BD0";
    }
}