@page "/"

<PageTitle>لوحة التحكم - نظام ERP</PageTitle>

@* عنوان الصفحة *@
<PageHeader Title="@Loc["Dashboard"]" />

@* 3 بطاقات أرقام + بطاقة رسم *@
<MudGrid Spacing="3">
    <MudItem xs="12" md="4">
        <StatCard Label="@Loc["NetSales"]" Value="@_salesTotal.ToString("N2")" />
    </MudItem>
    <MudItem xs="12" md="4">
        <StatCard Label="@Loc["NetPurchases"]" Value="@_purchasesTotal.ToString("N2")" />
    </MudItem>
    <MudItem xs="12" md="4">
        <StatCard Label="@Loc["InventoryValue"]" Value="@_inventoryValue.ToString("N2")" />
    </MudItem>
    <MudItem xs="12">
        <ChartCard Title="@Loc["SalesVsPurchases"]" Subtitle="@Loc["Last7Days"]">
            @if (_hasData)
            {
                <MudChart ChartType="ChartType.Line"
                          ChartSeries="_chartSeries"
                          XAxisLabels="_chartLabels"
                          Width="100%"
                          Height="220px"
                          LineStrokeWidth="2" />
            }
            else
            {
                <MudText Typo="Typo.body2" Style="color:var(--erp-muted); padding:16px 0;">
                    لا توجد بيانات مبيعات أو مشتريات بعد لعرض الرسم.
                </MudText>
            }
        </ChartCard>
    </MudItem>
</MudGrid>



@code {
    private decimal _salesTotal;
    private decimal _purchasesTotal;
    private decimal _inventoryValue;
    private List<ChartSeries> _chartSeries = new();
    private string[] _chartLabels = Array.Empty<string>();

    private bool _hasData => _salesTotal > 0 || _purchasesTotal > 0;

    [Inject] private IItemService ItemService { get; set; } = default!;
    [Inject] private ISalesInvoiceService SalesInvoiceService { get; set; } = default!;
    [Inject] private IPurchaseInvoiceService PurchaseInvoiceService { get; set; } = default!;
    [Inject] private IStringLocalizer<SharedResources> Loc { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var items = await ItemService.GetAllAsync();
            _inventoryValue = items.Sum(i => i.CurrentStock * i.CostPrice);

            var sales = await SalesInvoiceService.GetInvoicesAsync();
            _salesTotal = sales.Sum(i => i.TotalAmount);

            var purchases = await PurchaseInvoiceService.GetInvoicesAsync();
            _purchasesTotal = purchases.Sum(i => i.TotalAmount);

            BuildChart(sales, purchases);
        }
        catch
        {
            // في حال فشل أي استدعاء نترك القيم صفراً ولا نعطّل الصفحة
        }
    }

    /// <summary>
    /// رسم خطي لحركة المبيعات مقابل المشتريات خلال آخر 7 أيام.
    /// </summary>
    private void BuildChart(List<SalesInvoiceDto> sales, List<PurchaseInvoiceDto> purchases)
    {
        var labels = new List<string>();
        var salesData = new List<double>();
        var purchaseData = new List<double>();

        for (var i = 6; i >= 0; i--)
        {
            var day = DateTime.Today.AddDays(-i);
            labels.Add(day.ToString("dd/MM"));
            salesData.Add((double)sales
                .Where(s => s.InvoiceDate.Date == day)
                .Sum(s => s.TotalAmount));
            purchaseData.Add((double)purchases
                .Where(p => p.InvoiceDate.Date == day)
                .Sum(p => p.TotalAmount));
        }

        _chartLabels = labels.ToArray();
        _chartSeries = new List<ChartSeries>
        {
            new() { Name = Loc["Sales"], Data = salesData.ToArray() },
            new() { Name = Loc["Purchases"], Data = purchaseData.ToArray() }
        };
    }
}