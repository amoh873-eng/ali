@page "/hr/leaves"
@inject IStringLocalizer<SharedResources> Loc

@* صفحة الإجازات - جدول طلبات الإجازة مع موافقة/رفض *@

<PageTitle>الإجازات - نظام ERP</PageTitle>

<PageHeader Title="@Loc["Leaves"]" Icon="@Icons.Material.Filled.EventAvailable" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        إضافة إجازة
    </MudButton>
    <MudSpacer />
    <MudText Class="align-self-center muted-text">العدد: @_leaves.Count طلب</MudText>
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_leaves.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            لا توجد طلبات إجازة. اضغط "إضافة إجازة" للبدء.
        </MudAlert>
    }
    else
    {
        <MudTable Items="_leaves" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>الموظف</MudTh>
                <MudTh>النوع</MudTh>
                <MudTh>من تاريخ</MudTh>
                <MudTh>إلى تاريخ</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>إجراءات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmployeeNameAr</MudTd>
                <MudTd>@LeaveTypeLabel(context.LeaveType)</MudTd>
                <MudTd>@context.StartDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.EndDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@LeaveStatusColor(context.Status)">
                        @LeaveStatusLabel(context.Status)
                    </MudChip>
                </MudTd>
                <MudTd>
                    @if (context.Status == LeaveStatus.Pending)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small"
                                       Color="Color.Success"
                                       OnClick="@(e => SetLeaveStatus(context, LeaveStatus.Approved))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                       Color="Color.Warning"
                                       OnClick="@(e => SetLeaveStatus(context, LeaveStatus.Rejected))" />
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteLeave(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<LeaveDto> _leaves = new();
    private List<EmployeeDto> _employees = new();

    [Inject] private ILeaveService LeaveService { get; set; } = default!;
    [Inject] private IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _leaves = await LeaveService.GetAllAsync();
            _employees = await EmployeeService.GetAllAsync();
        }
        catch (Exception ex) { Snackbar.Add($"خطأ في تحميل الإجازات: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["LeaveService"] = LeaveService,
            ["Employees"] = _employees
        };
        var dialog = await DialogService.ShowAsync<LeaveFormDialog>(
            "إضافة طلب إجازة", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم حفظ طلب الإجازة بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task SetLeaveStatus(LeaveDto leave, LeaveStatus status)
    {
        try
        {
            await LeaveService.SetStatusAsync(leave.Id, status);
            Snackbar.Add("تم تحديث حالة الطلب", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteLeave(LeaveDto leave)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "تأكيد الحذف", "هل أنت متأكد من حذف طلب الإجازة؟",
            yesText: "حذف", cancelText: "إلغاء");
        if (confirmed != true) return;
        try { await LeaveService.DeleteAsync(leave.Id); Snackbar.Add("تم حذف الطلب بنجاح", Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private string LeaveTypeLabel(LeaveType t) => t switch
    {
        LeaveType.Annual => "سنوية",
        LeaveType.Sick => "مرضية",
        LeaveType.Unpaid => "بدون راتب",
        LeaveType.Emergency => "طارئة",
        _ => t.ToString()
    };

    private string LeaveStatusLabel(LeaveStatus s) => s switch
    {
        LeaveStatus.Pending => "معلّقة",
        LeaveStatus.Approved => "موافق عليها",
        LeaveStatus.Rejected => "مرفوضة",
        _ => s.ToString()
    };

    private Color LeaveStatusColor(LeaveStatus s) => s switch
    {
        LeaveStatus.Pending => Color.Warning,
        LeaveStatus.Approved => Color.Success,
        LeaveStatus.Rejected => Color.Error,
        _ => Color.Default
    };
}
