@page "/hr/employees"
@inject IStringLocalizer<SharedResources> Loc

@* صفحة الموظفون - جدول الموظفين مع بحث وتصفية بالحالة *@

<PageTitle>الموظفون - نظام ERP</PageTitle>

<PageHeader Title="@Loc["Employees"]" Icon="@Icons.Material.Filled.Groups" />

<MudToolBar Class="mb-4">
    <MudTextField @bind-Value="_search"
                  Placeholder="ابحث بالاسم أو الرقم الوظيفي..."
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Filled.Search"
                  Class="flex-grow-1" />
    <MudSelect T="EmployeeStatus?" @bind-Value="_statusFilter"
               Label="تصفية بالحالة"
               Variant="Variant.Outlined"
               Clearable="true"
               Class="mx-2"
               Style="min-width:180px;">
        <MudSelectItem T="EmployeeStatus?" Value="@EmployeeStatus.Active">نشط</MudSelectItem>
        <MudSelectItem T="EmployeeStatus?" Value="@EmployeeStatus.Suspended">موقوف</MudSelectItem>
        <MudSelectItem T="EmployeeStatus?" Value="@EmployeeStatus.Terminated">منتهي الخدمة</MudSelectItem>
    </MudSelect>
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        إضافة موظف
    </MudButton>
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_filteredEmployees.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            لا يوجد موظفون مطابقون. اضغط "إضافة موظف" للبدء.
        </MudAlert>
    }
    else
    {
        <MudTable Items="_filteredEmployees" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>الرقم الوظيفي</MudTh>
                <MudTh>الاسم</MudTh>
                <MudTh>القسم</MudTh>
                <MudTh>المسمى</MudTh>
                <MudTh>تاريخ التعيين</MudTh>
                <MudTh>الراتب</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>إجراءات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.EmployeeNumber</MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.DepartmentNameAr</MudTd>
                <MudTd>@context.PositionNameAr</MudTd>
                <MudTd>@context.HireDate.ToString("yyyy-MM-dd")</MudTd>
                <MudTd>@context.BasicSalary.ToString("N2")</MudTd>
                <MudTd>
                    <MudSelect T="EmployeeStatus" Value="@context.Status"
                               ValueChanged="@(v => SetStatus(context, v))"
                               Dense="true" Style="min-width:130px;">
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Active">نشط</MudSelectItem>
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Suspended">موقوف</MudSelectItem>
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Terminated">منتهي الخدمة</MudSelectItem>
                    </MudSelect>
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(e => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteEmployee(context))" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<EmployeeDto> _employees = new();
    private List<DepartmentDto> _departments = new();
    private List<PositionDto> _positions = new();
    private string _search = string.Empty;
    private EmployeeStatus? _statusFilter;

    private List<EmployeeDto> _filteredEmployees
    {
        get
        {
            IEnumerable<EmployeeDto> query = _employees;
            if (_statusFilter.HasValue)
                query = query.Where(e => e.Status == _statusFilter.Value);
            if (!string.IsNullOrWhiteSpace(_search))
            {
                query = query.Where(e =>
                    e.EmployeeNumber.Contains(_search, StringComparison.OrdinalIgnoreCase)
                    || (e.NameAr?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (e.NameEn?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));
            }
            return query.ToList();
        }
    }

    [Inject] private IEmployeeService EmployeeService { get; set; } = default!;
    [Inject] private IDepartmentService DepartmentService { get; set; } = default!;
    [Inject] private IPositionService PositionService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try
        {
            _employees = await EmployeeService.GetAllAsync();
            _departments = await DepartmentService.GetAllAsync();
            _positions = await PositionService.GetAllAsync();
        }
        catch (Exception ex) { Snackbar.Add($"خطأ في تحميل الموظفين: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters
        {
            ["EmployeeService"] = EmployeeService,
            ["Departments"] = _departments,
            ["Positions"] = _positions
        };
        var dialog = await DialogService.ShowAsync<EmployeeFormDialog>(
            "إضافة موظف جديد", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم حفظ الموظف بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(EmployeeDto employee)
    {
        var parameters = new DialogParameters
        {
            ["EmployeeService"] = EmployeeService,
            ["Departments"] = _departments,
            ["Positions"] = _positions,
            ["EditEmployee"] = employee
        };
        var dialog = await DialogService.ShowAsync<EmployeeFormDialog>(
            $"تعديل موظف: {employee.NameAr}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم تعديل الموظف بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task DeleteEmployee(EmployeeDto employee)
    {
        var confirmed = await DialogService.ShowMessageBox(
            "تأكيد الحذف", $"هل أنت متأكد من حذف الموظف '{employee.NameAr}'؟",
            yesText: "حذف", cancelText: "إلغاء");
        if (confirmed != true) return;
        try { await EmployeeService.DeleteAsync(employee.Id); Snackbar.Add("تم حذف الموظف بنجاح", Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task SetStatus(EmployeeDto employee, EmployeeStatus status)
    {
        if (employee.Status == status) return;
        try
        {
            await EmployeeService.SetStatusAsync(employee.Id, status);
            Snackbar.Add("تم تحديث حالة الموظف", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

