@* نموذج حوار لإضافة/تعديل موظف *@

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_employeeNumber"
                                  Label="الرقم الوظيفي"
                                  Required="true"
                                  RequiredError="الرقم الوظيفي مطلوب"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudDatePicker @bind-Date="_hireDate"
                                   Label="تاريخ التعيين"
                                   Variant="Variant.Outlined"
                                   T="DateTime?"
                                   AutoClose="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameAr"
                                  Label="اسم الموظف (عربي)"
                                  Required="true"
                                  RequiredError="الاسم العربي مطلوب"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameEn"
                                  Label="اسم الموظف (إنجليزي)"
                                  Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" Value="@_departmentId"
                               ValueChanged="@(v => OnDepartmentChanged(v))"
                               Label="القسم"
                               Required="true"
                               RequiredError="القسم مطلوب"
                               Variant="Variant.Outlined">
                        @foreach (var d in Departments)
                        {
                            <MudSelectItem T="Guid" Value="@d.Id">@d.Code - @d.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="Guid" @bind-Value="_positionId"
                               Label="المسمى الوظيفي"
                               Required="true"
                               RequiredError="المسمى الوظيفي مطلوب"
                               Variant="Variant.Outlined">
                        @foreach (var p in _filteredPositions)
                        {
                            <MudSelectItem T="Guid" Value="@p.Id">@p.Code - @p.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="EmployeeStatus" @bind-Value="_status"
                               Label="الحالة"
                               Variant="Variant.Outlined">
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Active">نشط</MudSelectItem>
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Suspended">موقوف</MudSelectItem>
                        <MudSelectItem T="EmployeeStatus" Value="@EmployeeStatus.Terminated">منتهي الخدمة</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudNumericField T="decimal" DecimalPlaces="2" Format="0.00" @bind-Value="_basicSalary"
                                     Label="الراتب الأساسي"
                                     Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_phone" Label="الهاتف" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_email" Label="البريد الإلكتروني" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_address" Label="العنوان" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField @bind-Value="_notes" Label="ملاحظات" Lines="2" Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">إلغاء</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">
            @(EditEmployee is null ? "إضافة" : "تعديل")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IEmployeeService EmployeeService { get; set; } = default!;
    [Parameter] public List<DepartmentDto> Departments { get; set; } = new();
    [Parameter] public List<PositionDto> Positions { get; set; } = new();
    [Parameter] public EmployeeDto? EditEmployee { get; set; }

    private MudForm? _form;
    private string _employeeNumber = string.Empty;
    private string _nameAr = string.Empty;
    private string? _nameEn;
    private Guid _departmentId;
    private Guid _positionId;
    private DateTime? _hireDate = DateTime.Today;
    private EmployeeStatus _status = EmployeeStatus.Active;
    private decimal _basicSalary;
    private string? _phone;
    private string? _email;
    private string? _address;
    private string? _notes;
    private string? _error;

    private IEnumerable<PositionDto> _filteredPositions =>
        Positions.Where(p => p.DepartmentId == _departmentId);

    protected override void OnInitialized()
    {
        if (EditEmployee is not null)
        {
            _employeeNumber = EditEmployee.EmployeeNumber;
            _nameAr = EditEmployee.NameAr;
            _nameEn = EditEmployee.NameEn;
            _departmentId = EditEmployee.DepartmentId;
            _positionId = EditEmployee.PositionId;
            _hireDate = EditEmployee.HireDate;
            _status = EditEmployee.Status;
            _basicSalary = EditEmployee.BasicSalary;
            _phone = EditEmployee.Phone;
            _email = EditEmployee.Email;
            _address = EditEmployee.Address;
            _notes = EditEmployee.Notes;
        }
        else if (Departments.Count > 0)
        {
            _departmentId = Departments.FirstOrDefault(d => d.IsActive)?.Id ?? Departments[0].Id;
            _positionId = _filteredPositions.FirstOrDefault()?.Id ?? Guid.Empty;
        }
    }

    private void OnDepartmentChanged(Guid id)
    {
        _departmentId = id;
        // إذا لم يعد المسمى المحدد تابعاً للقسم الجديد، أعد ضبطه لأول مسمى متاح
        if (!_filteredPositions.Any(p => p.Id == _positionId))
            _positionId = _filteredPositions.FirstOrDefault()?.Id ?? Guid.Empty;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            if (EditEmployee is null)
            {
                await EmployeeService.CreateAsync(new CreateEmployeeDto
                {
                    EmployeeNumber = _employeeNumber,
                    NameAr = _nameAr,
                    NameEn = _nameEn,
                    DepartmentId = _departmentId,
                    PositionId = _positionId,
                    HireDate = _hireDate ?? DateTime.Today,
                    Status = _status,
                    BasicSalary = _basicSalary,
                    Phone = _phone,
                    Email = _email,
                    Address = _address,
                    Notes = _notes
                });
            }
            else
            {
                await EmployeeService.UpdateAsync(new UpdateEmployeeDto
                {
                    Id = EditEmployee.Id,
                    EmployeeNumber = _employeeNumber,
                    NameAr = _nameAr,
                    NameEn = _nameEn,
                    DepartmentId = _departmentId,
                    PositionId = _positionId,
                    HireDate = _hireDate ?? DateTime.Today,
                    Status = _status,
                    BasicSalary = _basicSalary,
                    Phone = _phone,
                    Email = _email,
                    Address = _address,
                    Notes = _notes
                });
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}

