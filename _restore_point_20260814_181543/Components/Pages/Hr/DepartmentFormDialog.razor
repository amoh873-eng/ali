@* نموذج حوار لإضافة/تعديل قسم *@

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (_error is not null)
            {
                <MudAlert Severity="Severity.Error" Class="mb-3">@_error</MudAlert>
            }
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_code"
                                  Label="كود القسم (مثال: HR)"
                                  Required="true"
                                  RequiredError="كود القسم مطلوب"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudSelect @bind-Value="_parentId"
                               Label="القسم الأب (اختياري)"
                               Variant="Variant.Outlined"
                               T="Guid?"
                               Clearable="true">
                        @foreach (var d in ParentDepartments)
                        {
                            <MudSelectItem Value="@d.Id">@d.Code - @d.NameAr</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameAr"
                                  Label="اسم القسم (عربي)"
                                  Required="true"
                                  RequiredError="الاسم العربي مطلوب"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="_nameEn"
                                  Label="اسم القسم (إنجليزي)"
                                  Variant="Variant.Outlined" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="_description"
                                  Label="وصف"
                                  Lines="2"
                                  Variant="Variant.Outlined" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Color="Color.Default">إلغاء</MudButton>
        <MudButton OnClick="SubmitAsync" Variant="Variant.Filled" Color="Color.Primary">
            @(EditDepartment is null ? "إضافة" : "تعديل")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public IDepartmentService DepartmentService { get; set; } = default!;
    [Parameter] public List<DepartmentDto> ParentDepartments { get; set; } = new();
    [Parameter] public DepartmentDto? EditDepartment { get; set; }
    [Parameter] public Guid? DefaultParentId { get; set; }

    private MudForm? _form;
    private string _code = string.Empty;
    private string _nameAr = string.Empty;
    private string? _nameEn;
    private string? _description;
    private Guid? _parentId;
    private string? _error;

    protected override void OnInitialized()
    {
        if (EditDepartment is not null)
        {
            _code = EditDepartment.Code;
            _nameAr = EditDepartment.NameAr;
            _nameEn = EditDepartment.NameEn;
            _description = EditDepartment.Description;
            _parentId = EditDepartment.ParentDepartmentId;
        }
        else if (DefaultParentId.HasValue)
        {
            _parentId = DefaultParentId;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SubmitAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _error = null;
        try
        {
            if (EditDepartment is null)
            {
                await DepartmentService.CreateAsync(new CreateDepartmentDto
                {
                    Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    ParentDepartmentId = _parentId, Description = _description
                });
            }
            else
            {
                await DepartmentService.UpdateAsync(new UpdateDepartmentDto
                {
                    Id = EditDepartment.Id, Code = _code, NameAr = _nameAr, NameEn = _nameEn,
                    ParentDepartmentId = _parentId, Description = _description,
                    IsActive = EditDepartment.IsActive
                });
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
