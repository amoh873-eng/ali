@page "/inventory/warehouses"
@inject IStringLocalizer<SharedResources> Loc

@* صفحة المخازن - إدارة المخازن المتعددة والمخزن الافتراضي *@

<PageTitle>المخازن - نظام ERP</PageTitle>

<PageHeader Title="@Loc["Warehouses"]" Icon="@Icons.Material.Filled.Warehouse" />

<MudToolBar Class="mb-4">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               OnClick="OpenCreateDialog">
        إضافة مخزن جديد
    </MudButton>
    <MudSpacer />
    <MudText Class="align-self-center muted-text">العدد: @_warehouses.Count مخزن</MudText>
</MudToolBar>

<MudPaper Elevation="1">
    @if (_isLoading)
    {
        <MudProgressLinear Indeterminate="true" Class="my-4" />
    }
    else if (_warehouses.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="m-4">
            لا توجد مخازن. اضغط "إضافة مخزن جديد" لإنشاء أول مخزن.
        </MudAlert>
    }
    else
    {
        <MudTable Items="_warehouses" Hover="true" Dense="true">
            <HeaderContent>
                <MudTh>الكود</MudTh>
                <MudTh>اسم المخزن</MudTh>
                <MudTh>الموقع</MudTh>
                <MudTh>الافتراضي</MudTh>
                <MudTh>الحالة</MudTh>
                <MudTh>إجراءات</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Code</MudTd>
                <MudTd>@context.NameAr</MudTd>
                <MudTd>@context.Location</MudTd>
                <MudTd>
                    @if (context.IsDefault)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">افتراضي</MudChip>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                    }
                </MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.IsActive ? Color.Success : Color.Default)">
                        @(context.IsActive ? "نشط" : "غير نشط")
                    </MudChip>
                </MudTd>
                <MudTd>
                    @if (!context.IsDefault)
                    {
                        <MudTooltip Text="تعيين كمخزن افتراضي">
                            <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                           Color="Color.Secondary" OnClick="@(e => SetDefault(context))" />
                        </MudTooltip>
                    }
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                   Color="Color.Primary" OnClick="@(e => OpenEditDialog(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.ToggleOn" Size="Size.Small"
                                   Color="Color.Info" OnClick="@(e => ToggleActive(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                   Color="Color.Error" OnClick="@(e => DeleteWarehouse(context))"
                                   Disabled="context.IsSystem" />
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
            </PagerContent>
        </MudTable>
    }
</MudPaper>

@code {
    private bool _isLoading = true;
    private List<WarehouseDto> _warehouses = new();

    [Inject] private IWarehouseService WarehouseService { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _isLoading = true;
        try { _warehouses = await WarehouseService.GetAllAsync(); }
        catch (Exception ex) { Snackbar.Add($"خطأ في تحميل المخازن: {ex.Message}", Severity.Error); }
        finally { _isLoading = false; }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters { ["WarehouseService"] = WarehouseService };
        var dialog = await DialogService.ShowAsync<WarehouseFormDialog>(
            "إضافة مخزن جديد", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم حفظ المخزن بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task OpenEditDialog(WarehouseDto warehouse)
    {
        if (warehouse.IsSystem) { Snackbar.Add("لا يمكن تعديل المخازن النظامية", Severity.Warning); return; }
        var parameters = new DialogParameters
        {
            ["WarehouseService"] = WarehouseService,
            ["EditWarehouse"] = warehouse
        };
        var dialog = await DialogService.ShowAsync<WarehouseFormDialog>(
            $"تعديل مخزن: {warehouse.NameAr}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result?.Canceled != true) { Snackbar.Add("تم تعديل المخزن بنجاح", Severity.Success); await LoadAsync(); }
    }

    private async Task SetDefault(WarehouseDto warehouse)
    {
        try
        {
            await WarehouseService.SetDefaultAsync(warehouse.Id);
            Snackbar.Add($"تم تعيين '{warehouse.NameAr}' كمخزن افتراضي", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task DeleteWarehouse(WarehouseDto warehouse)
    {
        if (warehouse.IsSystem) { Snackbar.Add("لا يمكن حذف المخازن النظامية", Severity.Warning); return; }
        var confirmed = await DialogService.ShowMessageBox(
            "تأكيد الحذف", $"هل أنت متأكد من حذف المخزن '{warehouse.NameAr}'؟",
            yesText: "حذف", cancelText: "إلغاء");
        if (confirmed != true) return;
        try { await WarehouseService.DeleteAsync(warehouse.Id); Snackbar.Add("تم حذف المخزن بنجاح", Severity.Success); await LoadAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task ToggleActive(WarehouseDto warehouse)
    {
        try
        {
            await WarehouseService.ToggleActiveAsync(warehouse.Id);
            Snackbar.Add(warehouse.IsActive ? "تم تعطيل المخزن" : "تم تفعيل المخزن", Severity.Info);
            await LoadAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}

