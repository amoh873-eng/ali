@* حوار عرض تفاصيل جرد دوري (قراءة فقط) *@

<MudDialog>
    <DialogContent>
        <MudTable Items="_count.Lines" Hover="true" Dense="true" Elevation="0">
            <HeaderContent>
                <MudTh>الكود</MudTh>
                <MudTh>الصنف</MudTh>
                <MudTh>الرصيد النظامي</MudTh>
                <MudTh>الكمية المعدودة</MudTh>
                <MudTh>الفرق</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.ItemCode</MudTd>
                <MudTd>@context.ItemNameAr</MudTd>
                <MudTd>@context.SystemQuantity.ToString("N0")</MudTd>
                <MudTd>@context.CountedQuantity.ToString("N0")</MudTd>
                <MudTd Class="@(context.Difference != 0 ? "stock-out" : "")">
                    @context.Difference.ToString("N0")
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager InfoFormat="{first_item}-{last_item} من {all_items}" RowsPerPageString="صفوف لكل صفحة" />
            </PagerContent>
        </MudTable>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public StockCountDto Count { get; set; } = new();
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    private StockCountDto _count => Count;

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}