@* حوار عرض تفاصيل مردود مبيعات *@

<MudDialog>
    <DialogContent>
        @if (SalesReturn is null)
        {
            <MudAlert Severity="Severity.Info">لا توجد بيانات.</MudAlert>
        }
        else
        {
            <MudGrid>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">رقم المردود</MudText><MudText>@SalesReturn.ReturnNumber</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">الفاتورة الأصلية</MudText><MudText>@SalesReturn.InvoiceNumber</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">العميل</MudText><MudText>@SalesReturn.CustomerName</MudText></MudItem>
                <MudItem xs="12" sm="6"><MudText Typo="Typo.caption">التاريخ</MudText><MudText>@SalesReturn.ReturnDate.ToString("yyyy-MM-dd")</MudText></MudItem>
            </MudGrid>

            <MudTable Items="SalesReturn.Lines" Hover="true" Dense="true" Elevation="1" Class="mt-3">
                <HeaderContent>
                    <MudTh>الصنف</MudTh>
                    <MudTh>الكمية</MudTh>
                    <MudTh>السعر</MudTh>
                    <MudTh>الإجمالي</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.ItemCode - @context.ItemNameAr</MudTd>
                    <MudTd>@context.Quantity.ToString("N0")</MudTd>
                    <MudTd>@context.UnitPrice.ToString("N2")</MudTd>
                    <MudTd>@context.LineTotal.ToString("N2")</MudTd>
                </RowTemplate>
            </MudTable>

            <MudText Typo="Typo.h6" Class="mt-3">الإجمالي المردود: @SalesReturn.TotalAmount.ToString("N2")</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Color="Color.Default">إغلاق</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public SalesReturnDto? SalesReturn { get; set; }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}