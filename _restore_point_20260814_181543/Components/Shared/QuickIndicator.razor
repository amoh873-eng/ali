@* مؤشر سريع (Quick Indicator): تسمية صغيرة + قيمة بارزة — يُعرض بجوار عنوان الصفحة *@

<div class="erp-quick-indicator">
    <MudText Typo="Typo.caption" Style="color:var(--erp-muted);">@Label</MudText>
    <MudText Typo="Typo.body1" Style="color:var(--erp-text); font-weight:600;">@Value</MudText>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Value { get; set; } = "";
}
